---
const scenarios = [
  {
    id: 'collision',
    label: '1. Colisión lineal (insertar)',
    probe: 'Buscar "mar": h("mar") = 2 → mira [2] ("ana") → mira [3] ("sol") → mira [4] ("mar" ✓)',
    status: 'ok',
    note: 'Tres claves colisionan en el índice 2. El sondeo lineal las coloca en [2], [3] y [4].',
    cells: [
      { idx: 0, state: 'empty', val: 'vacío' },
      { idx: 1, state: 'used', val: '"luz"' },
      { idx: 2, state: 'probed', val: '"ana" (h=2)' },
      { idx: 3, state: 'probed', val: '"sol" (h=2)' },
      { idx: 4, state: 'found', val: '"mar" (h=2) ✓' },
      { idx: 5, state: 'empty', val: 'vacío' },
      { idx: 6, state: 'used', val: '"red"' },
      { idx: 7, state: 'empty', val: 'vacío' },
    ],
  },
  {
    id: 'tombstone',
    label: '2. Borrar "sol" con Tombstone (Correcto)',
    probe: 'Buscar "mar": [2] ("ana") → [3] (TOMBSTONE: sigue buscando) → [4] ("mar" ✓)',
    status: 'ok',
    note: 'La marca TOMBSTONE avisa al buscador de que ahí hubo un dato y no debe detener la cadena de búsqueda.',
    cells: [
      { idx: 0, state: 'empty', val: 'vacío' },
      { idx: 1, state: 'used', val: '"luz"' },
      { idx: 2, state: 'probed', val: '"ana" (h=2)' },
      { idx: 3, state: 'tombstone', val: '🪦 TOMBSTONE' },
      { idx: 4, state: 'found', val: '"mar" (h=2) ✓' },
      { idx: 5, state: 'empty', val: 'vacío' },
      { idx: 6, state: 'used', val: '"red"' },
      { idx: 7, state: 'empty', val: 'vacío' },
    ],
  },
  {
    id: 'broken',
    label: '3. Borrar vaciando celda (Bug clásico)',
    probe: 'Buscar "mar": [2] ("ana") → [3] (VACÍO: se detiene antes de tiempo) → ✗ FALSO NEGATIVO',
    status: 'error',
    note: 'Si limpias [3] a vacío, cualquier búsqueda que pase por ahí cree que "mar" nunca existió.',
    cells: [
      { idx: 0, state: 'empty', val: 'vacío' },
      { idx: 1, state: 'used', val: '"luz"' },
      { idx: 2, state: 'probed', val: '"ana" (h=2)' },
      { idx: 3, state: 'broken', val: '✗ VACÍO (para)' },
      { idx: 4, state: 'orphan', val: '"mar" (huérfano)' },
      { idx: 5, state: 'empty', val: 'vacío' },
      { idx: 6, state: 'used', val: '"red"' },
      { idx: 7, state: 'empty', val: 'vacío' },
    ],
  },
];

const initial = scenarios[1];
---

<div class="widget rounded-xl border border-white/10 bg-black/25 p-4" data-hash-widget>
  <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Escenarios de direccionamiento abierto">
    {
      scenarios.map((sc) => (
        <button
          type="button"
          data-hash-btn={sc.id}
          data-active={sc.id === initial.id ? '' : undefined}
          class="hash-btn cursor-pointer rounded-lg border border-white/10 bg-black/30 px-2.5 py-1.5 font-mono text-[11px] text-muted transition-colors hover:text-ink"
        >
          {sc.label}
        </button>
      ))
    }
  </div>

  <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-8" data-hash-grid>
    {
      initial.cells.map((cell) => (
        <div
          data-cell-state={cell.state}
          class="hash-cell rounded-lg border border-white/8 bg-white/[0.02] p-2 text-center"
        >
          <p class="font-mono text-[9px] text-dim">[{cell.idx}]</p>
          <p class="mt-1 truncate font-mono text-[10px] font-medium" data-cell-val>
            {cell.val}
          </p>
        </div>
      ))
    }
  </div>

  <div
    class="mt-3.5 rounded-lg border border-white/8 bg-black/30 px-3 py-2.5"
    data-hash-status={initial.status}
  >
    <p class="font-mono text-[11px] text-ink" data-hash-probe>{initial.probe}</p>
    <p class="mt-1 text-[11px] leading-relaxed text-dim" data-hash-note>{initial.note}</p>
  </div>
</div>

<script define:vars={{ scenarios }}>
  const root = document.querySelector('[data-hash-widget]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll('[data-hash-btn]'));
    const cells = Array.from(root.querySelectorAll('[data-cell-state]'));
    const probeEl = root.querySelector('[data-hash-probe]');
    const noteEl = root.querySelector('[data-hash-note]');
    const statusBox = root.querySelector('[data-hash-status]');

    const selectScenario = (id) => {
      const sc = scenarios.find((item) => item.id === id);
      if (!sc) return;

      for (const btn of buttons) {
        btn.toggleAttribute('data-active', btn.getAttribute('data-hash-btn') === id);
      }

      sc.cells.forEach((cellData, idx) => {
        const el = cells[idx];
        if (!el) return;
        el.setAttribute('data-cell-state', cellData.state);
        const valEl = el.querySelector('[data-cell-val]');
        if (valEl) valEl.textContent = cellData.val;
      });

      if (probeEl) probeEl.textContent = sc.probe;
      if (noteEl) noteEl.textContent = sc.note;
      if (statusBox) statusBox.setAttribute('data-hash-status', sc.status);
    };

    for (const btn of buttons) {
      btn.addEventListener('click', () => selectScenario(btn.getAttribute('data-hash-btn')));
    }
  }
</script>

<style>
  .hash-btn[data-active] {
    border-color: color-mix(in oklab, var(--layer) 50%, transparent);
    background-color: color-mix(in oklab, var(--layer) 14%, transparent);
    color: var(--color-ink);
  }

  .hash-cell[data-cell-state='empty'] {
    opacity: 0.55;
  }

  .hash-cell[data-cell-state='probed'] {
    border-color: rgba(250, 204, 21, 0.35);
    background-color: rgba(250, 204, 21, 0.06);
    color: rgb(254, 240, 138);
  }

  .hash-cell[data-cell-state='tombstone'] {
    border-color: rgba(251, 146, 60, 0.45);
    background-color: rgba(251, 146, 60, 0.1);
    color: rgb(253, 186, 116);
  }

  .hash-cell[data-cell-state='found'] {
    border-color: rgba(52, 211, 153, 0.5);
    background-color: rgba(52, 211, 153, 0.12);
    color: rgb(167, 243, 208);
  }

  .hash-cell[data-cell-state='broken'] {
    border-color: rgba(244, 63, 94, 0.55);
    background-color: rgba(244, 63, 94, 0.12);
    color: rgb(253, 164, 175);
  }

  .hash-cell[data-cell-state='orphan'] {
    border-style: dashed;
    border-color: rgba(244, 63, 94, 0.35);
    color: rgb(253, 164, 175);
    opacity: 0.7;
  }

  [data-hash-status='error'] {
    border-color: rgba(244, 63, 94, 0.35);
    background-color: rgba(244, 63, 94, 0.06);
  }
</style>
