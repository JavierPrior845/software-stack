---
import {
  BIG_O_SIZES,
  COMPLEXITY_CURVES,
  estimateCpuTime,
  formatOps,
  opsBarWidth,
} from '../../lib/bigo';

const DEFAULT_INDEX = 2; // N = 1.000
const initialN = BIG_O_SIZES[DEFAULT_INDEX];
const maxRef = initialN * initialN;

const rows = COMPLEXITY_CURVES.map((curve) => {
  const ops = curve.ops(initialN);
  return {
    ...curve,
    opsText: formatOps(ops),
    timeText: estimateCpuTime(ops),
    width: opsBarWidth(ops, maxRef),
    overflow: !Number.isFinite(ops) || ops >= 1_000_000_000,
  };
});
---

<div class="widget rounded-xl border border-white/10 bg-black/25 p-4" data-bigo-widget>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <div>
      <label class="text-xs text-muted" for="bigo-size">
        Tamaño de entrada <span class="font-mono text-ink">N</span>
      </label>
      <p class="font-mono text-[10px] text-dim">Asumiendo ~10⁹ operaciones simples/s en CPU</p>
    </div>
    <output
      id="bigo-size-out"
      for="bigo-size"
      class="rounded-md border border-white/10 bg-black/30 px-2.5 py-1 font-mono text-sm font-semibold accent"
      data-bigo-out
    >
      N = {new Intl.NumberFormat('es-ES').format(initialN)}
    </output>
  </div>

  <input
    id="bigo-size"
    type="range"
    min="0"
    max={BIG_O_SIZES.length - 1}
    step="1"
    value={DEFAULT_INDEX}
    class="range mt-3 w-full"
    data-bigo-slider
  />
  <div class="mt-1 flex justify-between font-mono text-[9px] text-dim">
    {BIG_O_SIZES.map((size) => <span>{size >= 1000 ? `${size / 1000}K` : size}</span>)}
  </div>

  <ol class="mt-4 space-y-2.5">
    {
      rows.map((row) => (
        <li
          data-bigo-row={row.id}
          data-danger={row.overflow ? '' : undefined}
          class="rounded-lg border border-white/6 bg-white/[0.015] p-2.5"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div class="flex items-baseline gap-2">
              <span class="curve-notation font-mono text-xs font-semibold text-ink">
                {row.notation}
              </span>
              <span class="text-xs text-muted">{row.name}</span>
              <span class="hidden text-[10px] text-dim sm:inline">· {row.example}</span>
            </div>
            <div class="flex items-baseline gap-2.5 font-mono text-[10px]">
              <span class="text-muted" data-ops>{row.opsText}</span>
              <span class="curve-time text-dim" data-time>({row.timeText})</span>
            </div>
          </div>
          <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-white/5">
            <div
              class="curve-bar h-full rounded-full"
              style={`width:${row.width}%`}
              data-bar
            />
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-3 text-[10px] leading-relaxed text-dim">
    Para <span class="font-mono text-muted">N = 100</span> casi cualquier algoritmo parece instantáneo.
    Al subir a <span class="font-mono text-muted">N = 100.000</span>, la diferencia entre
    <span class="font-mono text-muted">O(N log N)</span> y <span class="font-mono text-muted">O(N²)</span>
    es pasar de 1,7 milisegundos a 10 segundos de CPU bloqueada.
  </p>
</div>

<script>
  import {
    BIG_O_SIZES,
    COMPLEXITY_CURVES,
    estimateCpuTime,
    formatOps,
    opsBarWidth,
  } from '../../lib/bigo';

  const root = document.querySelector<HTMLElement>('[data-bigo-widget]');

  if (root) {
    const slider = root.querySelector<HTMLInputElement>('[data-bigo-slider]');
    const out = root.querySelector<HTMLElement>('[data-bigo-out]');

    const update = () => {
      const idx = Number(slider?.value ?? 2);
      const n = BIG_O_SIZES[idx] ?? 1000;
      const maxRef = n * n;

      if (out) {
        out.textContent = `N = ${new Intl.NumberFormat('es-ES').format(n)}`;
      }

      for (const curve of COMPLEXITY_CURVES) {
        const row = root.querySelector<HTMLElement>(`[data-bigo-row="${curve.id}"]`);
        if (!row) continue;

        const ops = curve.ops(n);
        const opsEl = row.querySelector<HTMLElement>('[data-ops]');
        const timeEl = row.querySelector<HTMLElement>('[data-time]');
        const barEl = row.querySelector<HTMLElement>('[data-bar]');

        if (opsEl) opsEl.textContent = formatOps(ops);
        if (timeEl) timeEl.textContent = `(${estimateCpuTime(ops)})`;
        if (barEl) barEl.style.width = `${opsBarWidth(ops, maxRef)}%`;

        const danger = !Number.isFinite(ops) || ops >= 1_000_000_000;
        row.toggleAttribute('data-danger', danger);
      }
    };

    slider?.addEventListener('input', update);
    update();
  }
</script>

<style>
  .range {
    accent-color: var(--layer);
    color-scheme: dark;
  }

  .curve-bar {
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--layer) 55%, transparent),
      var(--layer)
    );
    transition: width 200ms ease;
  }

  [data-danger] .curve-bar {
    background: linear-gradient(90deg, rgba(244, 63, 94, 0.5), rgb(244, 63, 94));
  }

  [data-danger] .curve-notation,
  [data-danger] .curve-time {
    color: rgb(253, 164, 175);
  }
</style>
