---
// GraphTraversal.astro - Simulador interactivo de BFS (Cola) vs DFS (Pila)
const stepsBFS = [
  { step: 0, current: 0, structure: '[0]', structureLabel: 'Cola FIFO', visited: [0], note: 'Inicio: se encola el nodo origen 0 y se marca como visitado.' },
  { step: 1, current: 0, structure: '[1, 2]', structureLabel: 'Cola FIFO', visited: [0, 1, 2], note: 'Desencola 0: descubre vecinos no visitados 1 y 2, los encola.' },
  { step: 2, current: 1, structure: '[2, 3]', structureLabel: 'Cola FIFO', visited: [0, 1, 2, 3], note: 'Desencola 1: descubre vecino 3 (no visitado), lo encola.' },
  { step: 3, current: 2, structure: '[3]', structureLabel: 'Cola FIFO', visited: [0, 1, 2, 3], note: 'Desencola 2: sus vecinos (0 y 3) ya están visitados. No añade nada.' },
  { step: 4, current: 3, structure: '[] (vacía)', structureLabel: 'Cola FIFO', visited: [0, 1, 2, 3], note: 'Desencola 3: cola vacía. Fin de BFS. Orden: 0 ──► 1 ──► 2 ──► 3.' },
];

const stepsDFS = [
  { step: 0, current: 0, structure: '[0]', structureLabel: 'Pila LIFO', visited: [0], note: 'Inicio: apila y visita nodo origen 0.' },
  { step: 1, current: 1, structure: '[0, 1]', structureLabel: 'Pila LIFO', visited: [0, 1], note: 'Avanza en profundidad: apila vecino 1.' },
  { step: 2, current: 3, structure: '[0, 1, 3]', structureLabel: 'Pila LIFO', visited: [0, 1, 3], note: 'Desde 1, avanza hasta el fondo: apila vecino 3.' },
  { step: 3, current: 2, structure: '[0, 1, 3, 2]', structureLabel: 'Pila LIFO', visited: [0, 1, 3, 2], note: 'Desde 3, avanza a vecino no visitado 2.' },
  { step: 4, current: 2, structure: 'Backtracking', structureLabel: 'Pila LIFO', visited: [0, 1, 3, 2], note: 'Desde 2 no hay más vecinos no visitados: desapila y retrocede. Fin de DFS. Orden: 0 ──► 1 ──► 3 ──► 2.' },
];
---

<div class="widget rounded-xl border border-white/10 bg-black/25 p-4" data-traversal-widget>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/8 pb-3">
    <div>
      <span class="font-mono text-[10px] uppercase tracking-wider text-dim">Simulador de Recorridos en Grafos</span>
      <p class="text-xs text-muted">Compara la exploración por olas (BFS) frente a profundidad (DFS)</p>
    </div>
    <div class="flex gap-1" role="tablist">
      <button
        type="button"
        data-mode-btn="bfs"
        data-active
        class="mode-btn cursor-pointer rounded-lg border border-white/10 bg-black/30 px-3 py-1 font-mono text-[11px] text-muted hover:text-ink"
      >
        BFS (Cola FIFO)
      </button>
      <button
        type="button"
        data-mode-btn="dfs"
        class="mode-btn cursor-pointer rounded-lg border border-white/10 bg-black/30 px-3 py-1 font-mono text-[11px] text-muted hover:text-ink"
      >
        DFS (Pila LIFO)
      </button>
    </div>
  </div>

  <!-- Visualización del grafo y nodos -->
  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-[1fr_auto]">
    <!-- Diagrama del grafo -->
    <div class="flex flex-col items-center justify-center rounded-lg border border-white/8 bg-white/[0.015] p-4 font-mono">
      <div class="relative w-56 p-2 text-center">
        <!-- Fila superior -->
        <div class="flex items-center justify-between">
          <div
            data-node="0"
            class="graph-node flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/5 font-bold text-ink transition-colors"
          >
            0
          </div>
          <div class="flex-1 border-t-2 border-dashed border-white/15 px-2 text-[10px] text-dim">
            e(0,1)
          </div>
          <div
            data-node="1"
            class="graph-node flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/5 font-bold text-ink transition-colors"
          >
            1
          </div>
        </div>

        <div class="my-3 flex justify-between px-3 text-[10px] text-dim">
          <span class="border-l-2 border-dashed border-white/15 pl-2">e(0,2)</span>
          <span class="border-r-2 border-dashed border-white/15 pr-2">e(1,3)</span>
        </div>

        <!-- Fila inferior -->
        <div class="flex items-center justify-between">
          <div
            data-node="2"
            class="graph-node flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/5 font-bold text-ink transition-colors"
          >
            2
          </div>
          <div class="flex-1 border-t-2 border-dashed border-white/15 px-2 text-[10px] text-dim">
            e(2,3)
          </div>
          <div
            data-node="3"
            class="graph-node flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/5 font-bold text-ink transition-colors"
          >
            3
          </div>
        </div>
      </div>

      <div class="mt-3 flex items-center gap-3 text-[10px] font-mono">
        <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span> Actual</span>
        <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-indigo-400"></span> Visitado</span>
        <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-white/20"></span> Pendiente</span>
      </div>
    </div>

    <!-- Panel de control de pasos y memoria -->
    <div class="flex flex-col justify-between space-y-3 rounded-lg border border-white/8 bg-black/30 p-3.5 min-w-[240px]">
      <div>
        <span class="font-mono text-[10px] uppercase tracking-wider text-dim" data-struct-label>Cola FIFO</span>
        <p class="mt-1 font-mono text-sm font-semibold text-emerald-300" data-struct-val>[0]</p>
      </div>

      <div class="border-t border-white/8 pt-2">
        <span class="font-mono text-[10px] uppercase tracking-wider text-dim">Conjunto Visitados</span>
        <p class="mt-1 font-mono text-xs text-indigo-200" data-visited-val>{0}</p>
      </div>

      <div class="border-t border-white/8 pt-2">
        <span class="font-mono text-[10px] uppercase tracking-wider text-dim">Explicación del paso</span>
        <p class="mt-1 text-[11px] leading-relaxed text-dim" data-step-note>
          Inicio: se encola el nodo origen 0 y se marca como visitado.
        </p>
      </div>

      <!-- Botones de navegación -->
      <div class="flex gap-2 border-t border-white/8 pt-3">
        <button
          type="button"
          data-btn-prev
          class="flex-1 cursor-pointer rounded border border-white/10 bg-white/5 py-1 text-center font-mono text-xs text-muted hover:bg-white/10 hover:text-ink disabled:opacity-40"
        >
          Anterior
        </button>
        <button
          type="button"
          data-btn-next
          class="flex-1 cursor-pointer rounded border border-emerald-400/40 bg-emerald-400/10 py-1 text-center font-mono text-xs font-semibold text-emerald-200 hover:bg-emerald-400/20 disabled:opacity-40"
        >
          Siguiente
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ stepsBFS, stepsDFS }}>
  const root = document.querySelector('[data-traversal-widget]');
  if (root) {
    let mode = 'bfs';
    let currentStep = 0;

    const modeBtns = Array.from(root.querySelectorAll('[data-mode-btn]'));
    const nodes = Array.from(root.querySelectorAll('[data-node]'));
    const structLabel = root.querySelector('[data-struct-label]');
    const structVal = root.querySelector('[data-struct-val]');
    const visitedVal = root.querySelector('[data-visited-val]');
    const stepNote = root.querySelector('[data-step-note]');
    const btnPrev = root.querySelector('[data-btn-prev]');
    const btnNext = root.querySelector('[data-btn-next]');

    const getDataset = () => (mode === 'bfs' ? stepsBFS : stepsDFS);

    const updateUI = () => {
      const data = getDataset();
      const s = data[currentStep];
      if (!s) return;

      if (structLabel) structLabel.textContent = s.structureLabel;
      if (structVal) structVal.textContent = s.structure;
      if (visitedVal) visitedVal.textContent = `{${s.visited.join(', ')}}`;
      if (stepNote) stepNote.textContent = s.note;

      if (btnPrev) btnPrev.disabled = currentStep === 0;
      if (btnNext) btnNext.disabled = currentStep === data.length - 1;

      // Actualizar nodos
      nodes.forEach((nEl) => {
        const id = parseInt(nEl.getAttribute('data-node'), 10);
        nEl.classList.remove('border-emerald-400', 'bg-emerald-500/30', 'text-emerald-100', 'border-indigo-400', 'bg-indigo-500/20', 'text-indigo-200');

        if (id === s.current) {
          nEl.classList.add('border-emerald-400', 'bg-emerald-500/30', 'text-emerald-100');
        } else if (s.visited.includes(id)) {
          nEl.classList.add('border-indigo-400', 'bg-indigo-500/20', 'text-indigo-200');
        }
      });
    };

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = btn.getAttribute('data-mode-btn');
        currentStep = 0;
        modeBtns.forEach((b) => b.toggleAttribute('data-active', b === btn));
        updateUI();
      });
    });

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        if (currentStep > 0) {
          currentStep--;
          updateUI();
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        const data = getDataset();
        if (currentStep < data.length - 1) {
          currentStep++;
          updateUI();
        }
      });
    }

    updateUI();
  }
</script>

<style>
  .mode-btn[data-active] {
    border-color: color-mix(in oklab, var(--layer) 50%, transparent);
    background-color: color-mix(in oklab, var(--layer) 16%, transparent);
    color: var(--color-ink);
  }
</style>
