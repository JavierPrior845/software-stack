---
import { GATES, getGate, truthTable } from '../../lib/logic';

const initialGate = 'and';
const initialA = 0;
const initialB = 0;
const initial = getGate(initialGate);
const initialY = initial?.evaluate(false, false) ? 1 : 0;
const table = truthTable(initialGate);
---

<div
  class="widget rounded-xl border border-white/10 bg-black/25 p-4"
  data-logic-widget
  data-gate={initialGate}
  data-a={initialA}
  data-b={initialB}
>
  <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
    <div>
      <p class="font-mono text-[10px] uppercase tracking-wider text-dim">Entradas</p>

      <div class="mt-2 flex gap-2">
        {
          [
            { id: 'a', label: 'A', value: initialA },
            { id: 'b', label: 'B', value: initialB },
          ].map((input) => (
            <button
              type="button"
              data-logic-input={input.id}
              aria-pressed={input.value === 1 ? 'true' : 'false'}
              class="logic-bit flex min-w-16 flex-1 items-center justify-between gap-3 rounded-lg border border-white/10 bg-black/30 px-3 py-2 text-left"
            >
              <span class="font-mono text-[10px] uppercase tracking-wider text-dim">{input.label}</span>
              <span class="font-mono text-lg font-semibold text-muted" data-logic-value={input.id}>
                {input.value}
              </span>
            </button>
          ))
        }
      </div>

      <fieldset class="mt-4">
        <legend class="font-mono text-[10px] uppercase tracking-wider text-dim">Puerta</legend>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {
            GATES.map((gate) => (
              <label class="logic-gate cursor-pointer">
                <input
                  type="radio"
                  name="logic-gate"
                  value={gate.id}
                  checked={gate.id === initialGate}
                  class="sr-only"
                  data-logic-gate
                />
                <span class="inline-flex rounded-md border border-white/10 bg-black/30 px-2.5 py-1.5 font-mono text-[11px] text-muted">
                  {gate.label}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>

    <div class="flex min-w-36 flex-col items-center justify-center rounded-lg border accent-border accent-softer px-4 py-3">
      <span class="font-mono text-[9px] uppercase tracking-wider text-dim">Salida Y</span>
      <span class="led mt-2 h-8 w-8 rounded-full border border-white/15 bg-white/[0.04]" data-logic-led></span>
      <output class="mt-1 font-mono text-2xl font-semibold accent" aria-live="polite" data-logic-output>
        {initialY}
      </output>
      <span class="mt-0.5 font-mono text-[10px] text-muted" data-logic-expression>
        Y = {initial?.expression}
      </span>
    </div>
  </div>

  <div class="mt-4 flex max-w-xs items-baseline justify-between gap-2">
    <p class="font-mono text-[10px] uppercase tracking-wider text-dim">Tabla de verdad</p>
    <p class="font-mono text-[9px] text-dim">fila activa resaltada</p>
  </div>

  <table class="mt-1.5 w-full max-w-xs border-collapse text-left font-mono text-[11px]">
    <caption class="sr-only">Tabla de verdad de la puerta seleccionada</caption>
    <thead>
      <tr class="text-[9px] uppercase tracking-wider text-dim">
        <th class="pb-1.5 pr-2 font-medium">A</th>
        <th class="pb-1.5 pr-2 font-medium">B</th>
        <th class="pb-1.5 font-medium">Y</th>
      </tr>
    </thead>
    <tbody>
      {
        table.map((row) => (
          <tr
            data-logic-row={`${row.a}${row.b}`}
            data-active={row.a === initialA && row.b === initialB ? '' : undefined}
            class="border-t border-white/5"
          >
            <td class="py-1 pr-2 text-muted">{row.a}</td>
            <td class="py-1 pr-2 text-muted">{row.b}</td>
            <td class="py-1 accent" data-logic-row-y>{row.y}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p class="mt-3 text-[10px] leading-relaxed text-dim">
    NAND y NOR son universales: con una sola de ellas puedes construir AND, OR y NOT. El resto de
    puertas existen por eficiencia, no por necesidad lógica.
  </p>

  <noscript>
    <p class="mt-2 rounded-md border border-amber-300/20 bg-amber-300/[0.05] p-2 text-[10px] text-amber-100/80">
      Sin JavaScript se muestra la puerta AND con A = 0 y B = 0. Activa JavaScript para cambiar entradas y puerta.
    </p>
  </noscript>
</div>

<script>
  import { GATES, evaluateGate, getGate, truthTable } from '../../lib/logic';

  const root = document.querySelector<HTMLElement>('[data-logic-widget]');

  if (root) {
    const gateInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-logic-gate]'));
    const inputButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-logic-input]'));
    const output = root.querySelector<HTMLElement>('[data-logic-output]');
    const expression = root.querySelector<HTMLElement>('[data-logic-expression]');
    const led = root.querySelector<HTMLElement>('[data-logic-led]');
    const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('[data-logic-row]'));

    let gate = root.dataset.gate ?? 'and';
    let a: 0 | 1 = root.dataset.a === '1' ? 1 : 0;
    let b: 0 | 1 = root.dataset.b === '1' ? 1 : 0;

    const render = () => {
      const definition = getGate(gate) ?? GATES[0];
      const y = evaluateGate(definition.id, a, b);

      if (output) output.textContent = String(y);
      if (expression) expression.textContent = `Y = ${definition.expression}`;
      if (led) led.toggleAttribute('data-on', y === 1);

      for (const button of inputButtons) {
        const key = button.getAttribute('data-logic-input');
        const value = key === 'a' ? a : b;
        button.setAttribute('aria-pressed', value === 1 ? 'true' : 'false');
        const valueEl = button.querySelector<HTMLElement>('[data-logic-value]');
        if (valueEl) valueEl.textContent = String(value);
      }

      const nextTable = truthTable(definition.id);

      rows.forEach((row, index) => {
        const tableRow = nextTable[index];
        if (!tableRow) return;
        const cell = row.querySelector<HTMLElement>('[data-logic-row-y]');
        if (cell) cell.textContent = String(tableRow.y);
        row.toggleAttribute('data-active', tableRow.a === a && tableRow.b === b);
      });
    };

    for (const button of inputButtons) {
      button.addEventListener('click', () => {
        if (button.getAttribute('data-logic-input') === 'a') {
          a = a === 1 ? 0 : 1;
        } else {
          b = b === 1 ? 0 : 1;
        }
        render();
      });
    }

    for (const input of gateInputs) {
      input.addEventListener('change', () => {
        if (input.checked) {
          gate = input.value;
          render();
        }
      });
    }
  }
</script>

<style>
  .logic-bit[aria-pressed='true'] {
    border-color: color-mix(in oklab, var(--layer) 55%, transparent);
    background-color: color-mix(in oklab, var(--layer) 14%, transparent);
  }

  .logic-bit[aria-pressed='true'] [data-logic-value] {
    color: var(--color-ink);
  }

  .logic-gate input:checked + span {
    border-color: color-mix(in oklab, var(--layer) 55%, transparent);
    background-color: color-mix(in oklab, var(--layer) 14%, transparent);
    color: var(--color-ink);
  }

  .logic-gate input:focus-visible + span {
    outline: 2px solid color-mix(in oklab, var(--layer) 70%, transparent);
    outline-offset: 2px;
  }

  .led[data-on] {
    border-color: var(--layer);
    background-color: var(--layer);
    box-shadow: 0 0 18px color-mix(in oklab, var(--layer) 55%, transparent);
  }

  tr[data-active] {
    background-color: color-mix(in oklab, var(--layer) 10%, transparent);
  }

  tr[data-active] td {
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .logic-bit,
    .logic-gate span,
    .led,
    tr {
      transition:
        background-color 150ms ease,
        border-color 150ms ease,
        color 150ms ease,
        box-shadow 150ms ease;
    }
  }
</style>
