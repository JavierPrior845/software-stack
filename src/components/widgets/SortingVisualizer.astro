---
// SortingVisualizer.astro: Interactive step-by-step visualizer for Divide & Conquer sorting algorithms (MergeSort and QuickSort)
---

<div class="sorting-widget rounded-xl border border-white/10 bg-black/30 p-4 sm:p-5" data-sorting-widget>
  <!-- Header: Mode Selector -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-cyan-400"></span>
        <h3 class="font-mono text-sm font-semibold text-slate-100">
          Simulador Divide y Vencerás: MergeSort vs QuickSort
        </h3>
      </div>
      <p class="mt-0.5 text-xs text-dim">
        Observa dónde reside el trabajo: en la fase de Combinación (MergeSort) o en la de División/Partición (QuickSort)
      </p>
    </div>

    <!-- Algorithm tabs -->
    <div class="inline-flex rounded-lg border border-white/10 bg-black/40 p-1" role="tablist">
      <button
        type="button"
        class="sort-tab-btn active rounded-md px-3 py-1.5 font-mono text-xs font-medium text-slate-300 transition-colors hover:text-white"
        data-algo="mergesort"
      >
        1. MergeSort (Fusión O(N log N))
      </button>
      <button
        type="button"
        class="sort-tab-btn rounded-md px-3 py-1.5 font-mono text-xs font-medium text-slate-400 transition-colors hover:text-white"
        data-algo="quicksort"
      >
        2. QuickSort (Partición In-Place)
      </button>
    </div>
  </div>

  <!-- Stepper & Controls Bar -->
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-white/5 bg-white/[0.02] p-3 text-xs">
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="rounded border border-white/10 bg-black/40 px-3 py-1 font-mono text-xs font-medium text-slate-200 hover:bg-white/10 disabled:opacity-40"
        data-sort-prev
      >
        ← Paso Anterior
      </button>
      <button
        type="button"
        class="rounded border border-cyan-500/30 bg-cyan-500/20 px-3 py-1 font-mono text-xs font-semibold text-cyan-200 hover:bg-cyan-500/30 disabled:opacity-40"
        data-sort-next
      >
        Paso Siguiente →
      </button>
      <button
        type="button"
        class="rounded border border-white/10 bg-black/30 px-2.5 py-1 font-mono text-xs text-muted hover:text-white"
        data-sort-reset
      >
        Reiniciar
      </button>
    </div>

    <div class="flex items-center gap-4 font-mono text-xs">
      <div class="text-dim">
        Paso: <span class="font-bold text-slate-200" data-sort-step-counter>1 / 10</span>
      </div>
      <div class="rounded border px-2.5 py-0.5 text-xs font-bold" data-sort-phase-badge>
        Inicio
      </div>
    </div>
  </div>

  <!-- Visual Array Display -->
  <div class="mt-4 rounded-xl border border-white/10 bg-black/40 p-5 space-y-4">
    <div class="flex items-center justify-between text-xs text-dim font-mono">
      <span>Estado del Array en Memoria:</span>
      <span data-sort-work-dist class="text-cyan-300">Trabajo: Dividir O(1) · Combinar O(N)</span>
    </div>

    <!-- Bars Container -->
    <div class="flex h-44 items-end justify-center gap-2 sm:gap-4 border-b border-white/10 pb-2 px-2" data-sort-bars>
      <!-- Bars dynamically generated by JS -->
    </div>

    <!-- Auxiliary Memory Bar (visible for MergeSort, hidden for QuickSort) -->
    <div class="space-y-1.5" data-aux-container>
      <div class="flex items-center justify-between text-[11px] font-mono text-dim">
        <span class="flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-amber-400"></span>
          Memoria Auxiliar O(N) (Buffer de fusión):
        </span>
        <span class="text-amber-300/80">Copia temporal en Heap para no sobrescribir</span>
      </div>
      <div class="flex h-10 items-center justify-center gap-2 sm:gap-4 rounded-lg border border-amber-500/20 bg-amber-950/10 p-1" data-aux-cells>
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- In-place Notice (for QuickSort) -->
    <div class="hidden rounded-lg border border-emerald-500/25 bg-emerald-950/10 p-3 text-xs text-emerald-200/90 leading-relaxed font-mono" data-inplace-notice>
      ✦ <strong>In-Place puro (Memoria auxiliar O(1)):</strong> QuickSort no requiere ningún buffer auxiliar. Todo se realiza intercambiando elementos (swaps) directamente sobre el array original.
    </div>

    <!-- Narrative Step Explanation Card -->
    <div class="rounded-lg border border-white/5 bg-black/50 p-3.5 space-y-1.5">
      <div class="flex items-center justify-between text-xs">
        <span class="font-mono font-bold text-slate-200 uppercase tracking-wider" data-step-title>
          1. Estado Inicial
        </span>
        <span class="font-mono text-[11px] text-dim" data-step-ptrs>
          Punteros: []
        </span>
      </div>
      <p class="text-xs leading-relaxed text-slate-300 font-sans" data-step-desc>
        Array desordenado listo para ser procesado por el paradigma Divide y Vencerás.
      </p>
    </div>
  </div>

  <!-- Educational Architectural Matrix -->
  <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 text-xs">
    <div class="rounded-lg border border-cyan-500/20 bg-cyan-950/10 p-3 space-y-1 font-mono">
      <div class="font-bold text-cyan-200 flex items-center justify-between">
        <span>MergeSort (Von Neumann, 1945)</span>
        <span class="text-[10px] rounded bg-cyan-500/20 px-1.5 py-0.2">Estable</span>
      </div>
      <p class="text-[11px] font-sans text-muted">
        • <strong>Dividir:</strong> Trivial en $O(1)$ calculando el punto medio $m = (p+q)/2$.<br />
        • <strong>Combinar:</strong> Costosa en $O(N)$ fusionando las mitades en un array auxiliar.<br />
        • <strong>Complejidad:</strong> $\Theta(N \log N)$ siempre (mejor, peor y promedio). Paga $O(N)$ RAM.
      </p>
    </div>

    <div class="rounded-lg border border-emerald-500/20 bg-emerald-950/10 p-3 space-y-1 font-mono">
      <div class="font-bold text-emerald-200 flex items-center justify-between">
        <span>QuickSort (Hoare, 1959)</span>
        <span class="text-[10px] rounded bg-emerald-500/20 px-1.5 py-0.2">In-Place</span>
      </div>
      <p class="text-[11px] font-sans text-muted">
        • <strong>Dividir (Partición):</strong> Costosa en $O(N)$ barriendo con dos punteros respecto al pivote.<br />
        • <strong>Combinar:</strong> Gratis en $O(1)$ (el array ya queda ordenado in-place).<br />
        • <strong>Complejidad:</strong> $O(N \log N)$ promedio. Inestable, pero rey en CPU por localidad de caché.
      </p>
    </div>
  </div>
</div>

<script>
  function setupSortingWidget(root: HTMLElement) {
    type AlgoType = 'mergesort' | 'quicksort';
    let currentAlgo: AlgoType = 'mergesort';
    let currentStep = 0;

    const initialArray = [38, 27, 43, 3, 9, 82, 10];
    const maxVal = Math.max(...initialArray);

    interface SortStep {
      title: string;
      phase: string;
      badgeClass: string;
      array: number[];
      highlightIndices: { idx: number; role: 'active' | 'pivot' | 'sorted' | 'left' | 'right' }[];
      auxArray?: (number | null)[];
      ptrsText: string;
      desc: string;
    }

    // --- MERGESORT TRACE ---
    const mergeSteps: SortStep[] = [
      {
        title: '1. Array Inicial Desordenado',
        phase: 'Entrada',
        badgeClass: 'border-white/10 bg-white/5 text-slate-300',
        array: [38, 27, 43, 3, 9, 82, 10],
        highlightIndices: [],
        auxArray: [null, null, null, null, null, null, null],
        ptrsText: 'Rango: [0 .. 6]',
        desc: 'Tenemos un array de 7 elementos. MergeSort calcula el punto medio m = 0 + (6-0)/2 = 3 para dividir en dos mitades disjuntas: izquierda [38, 27, 43, 3] y derecha [9, 82, 10]. Coste de división: O(1).',
      },
      {
        title: '2. División Recursiva hasta Casos Base',
        phase: 'Dividir O(1)',
        badgeClass: 'border-cyan-500/30 bg-cyan-500/20 text-cyan-200',
        array: [38, 27, 43, 3, 9, 82, 10],
        highlightIndices: [
          { idx: 0, role: 'left' },
          { idx: 1, role: 'left' },
          { idx: 2, role: 'left' },
          { idx: 3, role: 'left' },
          { idx: 4, role: 'right' },
          { idx: 5, role: 'right' },
          { idx: 6, role: 'right' },
        ],
        auxArray: [null, null, null, null, null, null, null],
        ptrsText: 'Mitad Izq: [0..3] · Mitad Der: [4..6]',
        desc: 'Se divide recursivamente hasta alcanzar sublistas de tamaño 1 (caso base Pequeño(p, q) donde p == q), que por definición matemática ya están ordenadas.',
      },
      {
        title: '3. Fusión Parcial de Pares: [38] y [27]',
        phase: 'Combinar (Merge)',
        badgeClass: 'border-amber-500/30 bg-amber-500/20 text-amber-200',
        array: [27, 38, 43, 3, 9, 82, 10],
        highlightIndices: [
          { idx: 0, role: 'sorted' },
          { idx: 1, role: 'sorted' },
        ],
        auxArray: [27, 38, null, null, null, null, null],
        ptrsText: 'Comparando: 38 > 27 → [27, 38]',
        desc: 'La función Combinar(0, 0, 1) compara los elementos 38 y 27 usando dos punteros. Como 27 < 38, coloca primero 27 y luego 38 en el buffer auxiliar y lo copia al array.',
      },
      {
        title: '4. Fusión Parcial: [43] y [3]',
        phase: 'Combinar (Merge)',
        badgeClass: 'border-amber-500/30 bg-amber-500/20 text-amber-200',
        array: [27, 38, 3, 43, 9, 82, 10],
        highlightIndices: [
          { idx: 2, role: 'sorted' },
          { idx: 3, role: 'sorted' },
        ],
        auxArray: [null, null, 3, 43, null, null, null],
        ptrsText: 'Comparando: 43 > 3 → [3, 43]',
        desc: 'Compara 43 y 3. El menor (3) se coloca en la primera posición del par y 43 en la segunda. Ambas mitades menores ya están internamente ordenadas.',
      },
      {
        title: '5. Fusión de Cuarteto Izquierdo: [27, 38] y [3, 43]',
        phase: 'Combinar (Merge)',
        badgeClass: 'border-amber-500/30 bg-amber-500/20 text-amber-200',
        array: [3, 27, 38, 43, 9, 82, 10],
        highlightIndices: [
          { idx: 0, role: 'sorted' },
          { idx: 1, role: 'sorted' },
          { idx: 2, role: 'sorted' },
          { idx: 3, role: 'sorted' },
        ],
        auxArray: [3, 27, 38, 43, null, null, null],
        ptrsText: 'Punteros i=0(27) vs j=2(3) → Menor: 3',
        desc: 'Dos punteros barren simultáneamente [27, 38] y [3, 43]. Pasos de fusión: toma 3, luego 27, luego 38, luego 43. La mitad izquierda completa [0..3] queda perfectamente ordenada en O(N).',
      },
      {
        title: '6. Fusión de la Mitad Derecha: [9, 82, 10]',
        phase: 'Combinar (Merge)',
        badgeClass: 'border-amber-500/30 bg-amber-500/20 text-amber-200',
        array: [3, 27, 38, 43, 9, 10, 82],
        highlightIndices: [
          { idx: 4, role: 'sorted' },
          { idx: 5, role: 'sorted' },
          { idx: 6, role: 'sorted' },
        ],
        auxArray: [null, null, null, null, 9, 10, 82],
        ptrsText: 'Fusión de [9] y [10, 82] → [9, 10, 82]',
        desc: 'Recursivamente se procesa la mitad derecha [4..6]. Se fusiona [82] con [10] obteniendo [10, 82], y luego con [9] obteniendo [9, 10, 82]. Ambas mitades principales están ahora listas.',
      },
      {
        title: '7. Fusión Final Global: [3, 27, 38, 43] con [9, 10, 82]',
        phase: 'Fusión Final O(N)',
        badgeClass: 'border-emerald-500/30 bg-emerald-500/20 text-emerald-200 font-bold',
        array: [3, 9, 10, 27, 38, 43, 82],
        highlightIndices: [
          { idx: 0, role: 'sorted' },
          { idx: 1, role: 'sorted' },
          { idx: 2, role: 'sorted' },
          { idx: 3, role: 'sorted' },
          { idx: 4, role: 'sorted' },
          { idx: 5, role: 'sorted' },
          { idx: 6, role: 'sorted' },
        ],
        auxArray: [3, 9, 10, 27, 38, 43, 82],
        ptrsText: 'Fusión completa en O(N) comparaciones',
        desc: 'Se realiza la última pasada de fusión con dos punteros sobre las dos mitades ordenadas. Resultado completamente ordenado en O(N log N) con garantía de estabilidad (mantiene el orden relativo de claves iguales).',
      },
    ];

    // --- QUICKSORT TRACE ---
    const quickSteps: SortStep[] = [
      {
        title: '1. Array Inicial y Elección del Pivote',
        phase: 'Entrada',
        badgeClass: 'border-white/10 bg-white/5 text-slate-300',
        array: [38, 27, 43, 3, 9, 82, 10],
        highlightIndices: [{ idx: 6, role: 'pivot' }],
        ptrsText: 'Pivote = A[6] (10) · Rango: [0 .. 6]',
        desc: 'QuickSort elige un pivote (en este ejemplo canónico de Lomuto, el último elemento: 10). A diferencia de MergeSort, todo el trabajo computacional vive en la fase de división/partición.',
      },
      {
        title: '2. Barrido de Partición (Lomuto Partition)',
        phase: 'Partición O(N)',
        badgeClass: 'border-cyan-500/30 bg-cyan-500/20 text-cyan-200',
        array: [3, 9, 43, 38, 27, 82, 10],
        highlightIndices: [
          { idx: 0, role: 'left' },
          { idx: 1, role: 'left' },
          { idx: 6, role: 'pivot' },
        ],
        ptrsText: 'Menores que 10: [3, 9] movidos a la izquierda',
        desc: 'El algoritmo barre el array comparando cada elemento con el pivote (10). Los elementos menores (3 y 9) se intercambian hacia la sección izquierda del array in-place.',
      },
      {
        title: '3. Colocación Definitiva del Pivote (Swap Final)',
        phase: 'Pivote Fijado',
        badgeClass: 'border-amber-500/30 bg-amber-500/20 text-amber-200 font-bold',
        array: [3, 9, 10, 38, 27, 82, 43],
        highlightIndices: [
          { idx: 0, role: 'left' },
          { idx: 1, role: 'left' },
          { idx: 2, role: 'sorted' }, // 10 is at final place!
          { idx: 3, role: 'right' },
          { idx: 4, role: 'right' },
          { idx: 5, role: 'right' },
          { idx: 6, role: 'right' },
        ],
        ptrsText: 'Pivote 10 fijado en índice [2] ✓',
        desc: 'El pivote (10) se intercambia con A[2]. ¡Ahora 10 está en su posición final absoluta definitiva! A su izquierda están todos los menores [3, 9] y a su derecha los mayores [38, 27, 82, 43].',
      },
      {
        title: '4. Ordenación Recursiva Sublista Izquierda [3, 9]',
        phase: 'Subproblema Izq',
        badgeClass: 'border-cyan-500/30 bg-cyan-500/20 text-cyan-200',
        array: [3, 9, 10, 38, 27, 82, 43],
        highlightIndices: [
          { idx: 0, role: 'sorted' },
          { idx: 1, role: 'sorted' },
          { idx: 2, role: 'sorted' },
        ],
        ptrsText: 'Sublista [0..1] ordenada in-place',
        desc: 'Se llama recursivamente a QuickSort(0, 1). Elige 9 como pivote, 3 ya es menor; la sublista izquierda queda completamente ordenada sin usar memoria extra.',
      },
      {
        title: '5. Partición Sublista Derecha [38, 27, 82, 43]',
        phase: 'Partición Derecha',
        badgeClass: 'border-cyan-500/30 bg-cyan-500/20 text-cyan-200',
        array: [3, 9, 10, 38, 27, 43, 82],
        highlightIndices: [
          { idx: 0, role: 'sorted' },
          { idx: 1, role: 'sorted' },
          { idx: 2, role: 'sorted' },
          { idx: 5, role: 'sorted' }, // 43 placed
        ],
        ptrsText: 'Pivote 43 fijado en índice [5]',
        desc: 'Se elige pivote 43 para el rango [3..6]. Se colocan 38 y 27 a su izquierda y 82 a su derecha. El pivote 43 queda en su posición definitiva A[5].',
      },
      {
        title: '6. Ordenación del Par [38, 27] y Combinación Final Gratis',
        phase: 'Combinar O(1) Gratis',
        badgeClass: 'border-emerald-500/30 bg-emerald-500/20 text-emerald-200 font-bold',
        array: [3, 9, 10, 27, 38, 43, 82],
        highlightIndices: [
          { idx: 0, role: 'sorted' },
          { idx: 1, role: 'sorted' },
          { idx: 2, role: 'sorted' },
          { idx: 3, role: 'sorted' },
          { idx: 4, role: 'sorted' },
          { idx: 5, role: 'sorted' },
          { idx: 6, role: 'sorted' },
        ],
        ptrsText: 'Array ordenado in-place · Combinación = O(1)',
        desc: 'Se intercambian 38 y 27. Como todas las operaciones se realizaron in-place sobre el mismo bloque de memoria continua, ¡la fase de Combinar cuesta O(1)! No hay bucle de fusión.',
      },
    ];

    // UI elements
    const tabBtns = root.querySelectorAll<HTMLButtonElement>('.sort-tab-btn');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-sort-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-sort-next]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-sort-reset]');
    const counterEl = root.querySelector<HTMLElement>('[data-sort-step-counter]');
    const phaseBadgeEl = root.querySelector<HTMLElement>('[data-sort-phase-badge]');
    const workDistEl = root.querySelector<HTMLElement>('[data-sort-work-dist]');
    const barsContainer = root.querySelector<HTMLElement>('[data-sort-bars]');
    const auxContainer = root.querySelector<HTMLElement>('[data-aux-container]');
    const auxCells = root.querySelector<HTMLElement>('[data-aux-cells]');
    const inplaceNotice = root.querySelector<HTMLElement>('[data-inplace-notice]');
    const titleEl = root.querySelector<HTMLElement>('[data-step-title]');
    const ptrsEl = root.querySelector<HTMLElement>('[data-step-ptrs]');
    const descEl = root.querySelector<HTMLElement>('[data-step-desc]');

    function getSteps(): SortStep[] {
      return currentAlgo === 'mergesort' ? mergeSteps : quickSteps;
    }

    function render() {
      const steps = getSteps();
      const step = steps[currentStep];
      if (!step) return;

      // Update counters & badges
      if (counterEl) counterEl.textContent = `${currentStep + 1} / ${steps.length}`;
      if (phaseBadgeEl) {
        phaseBadgeEl.textContent = step.phase;
        phaseBadgeEl.className = `rounded border px-2.5 py-0.5 text-xs font-bold ${step.badgeClass}`;
      }
      if (workDistEl) {
        workDistEl.textContent =
          currentAlgo === 'mergesort'
            ? 'MergeSort: Dividir O(1) · Combinar O(N) con Memoria Auxiliar'
            : 'QuickSort: Dividir/Partición O(N) · Combinar O(1) In-Place';
      }

      // Show/hide aux buffer vs in-place notice
      if (currentAlgo === 'mergesort') {
        auxContainer?.classList.remove('hidden');
        inplaceNotice?.classList.add('hidden');
      } else {
        auxContainer?.classList.add('hidden');
        inplaceNotice?.classList.remove('hidden');
      }

      // Render array bars
      if (barsContainer) {
        barsContainer.innerHTML = step.array
          .map((val, idx) => {
            const heightPct = Math.max(15, (val / maxVal) * 100);
            const hl = step.highlightIndices.find((h) => h.idx === idx);

            let colorClass = 'bg-slate-700/80 border-slate-500/40 text-slate-300';
            let labelBadge = '';

            if (hl) {
              if (hl.role === 'sorted') {
                colorClass = 'bg-emerald-500/80 border-emerald-400 text-white shadow-lg shadow-emerald-950';
                labelBadge = '<span class="text-[9px] text-emerald-300 font-mono">✓</span>';
              } else if (hl.role === 'pivot') {
                colorClass = 'bg-amber-500/90 border-amber-300 text-black font-extrabold shadow-lg shadow-amber-950 animate-pulse';
                labelBadge = '<span class="text-[9px] text-amber-300 font-mono">PIV</span>';
              } else if (hl.role === 'left') {
                colorClass = 'bg-cyan-600/80 border-cyan-400 text-white';
                labelBadge = '<span class="text-[9px] text-cyan-300 font-mono">Izq</span>';
              } else if (hl.role === 'right') {
                colorClass = 'bg-indigo-600/80 border-indigo-400 text-white';
                labelBadge = '<span class="text-[9px] text-indigo-300 font-mono">Der</span>';
              }
            }

            return `
              <div class="flex flex-col items-center gap-1.5 flex-1 max-w-[56px] h-full justify-end">
                <span class="font-mono text-xs font-bold text-slate-200">${val}</span>
                <div
                  class="w-full rounded-t-md border ${colorClass} transition-all duration-300 flex items-center justify-center font-mono text-[10px]"
                  style="height: ${heightPct}%;"
                ></div>
                <span class="font-mono text-[10px] text-dim">[${idx}]</span>
                ${labelBadge}
              </div>
            `;
          })
          .join('');
      }

      // Render auxiliary buffer cells (for MergeSort)
      if (auxCells && step.auxArray) {
        auxCells.innerHTML = step.auxArray
          .map((val) => {
            const hasVal = val !== null;
            return `
              <div class="flex items-center justify-center flex-1 max-w-[56px] h-8 rounded border ${
                hasVal
                  ? 'border-amber-400/60 bg-amber-500/20 text-amber-200 font-bold'
                  : 'border-white/5 bg-black/30 text-dim'
              } font-mono text-xs">
                ${hasVal ? val : '-'}
              </div>
            `;
          })
          .join('');
      }

      // Narrative text
      if (titleEl) titleEl.textContent = step.title;
      if (ptrsEl) ptrsEl.textContent = step.ptrsText;
      if (descEl) descEl.textContent = step.desc;

      // Button states
      if (prevBtn) prevBtn.disabled = currentStep === 0;
      if (nextBtn) nextBtn.disabled = currentStep === steps.length - 1;
    }

    // Switch algorithm tabs
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('active', 'text-slate-300');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('active', 'text-slate-300');
        btn.classList.remove('text-slate-400');

        currentAlgo = (btn.dataset.algo as AlgoType) || 'mergesort';
        currentStep = 0;
        render();
      });
    });

    // Stepper buttons
    prevBtn?.addEventListener('click', () => {
      if (currentStep > 0) {
        currentStep--;
        render();
      }
    });

    nextBtn?.addEventListener('click', () => {
      const steps = getSteps();
      if (currentStep < steps.length - 1) {
        currentStep++;
        render();
      }
    });

    resetBtn?.addEventListener('click', () => {
      currentStep = 0;
      render();
    });

    render();
  }

  // Auto-initialize widget
  document.querySelectorAll<HTMLElement>('[data-sorting-widget]').forEach(setupSortingWidget);
</script>
