            <!-- SVG con Subject Central emitiendo a 4 Observadores -->
            <div class="w-full overflow-x-auto py-2 flex justify-center">
              <svg id="observer-svg" viewBox="0 0 680 200" class="w-full max-w-[680px] h-auto select-none font-mono" style="min-width: 580px;">
                <defs>
                  <marker id="arrow-obs-purple" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="#c084fc" />
                  </marker>
                  <marker id="arrow-obs-cyan" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="#38bdf8" />
                  </marker>
                  <marker id="arrow-obs-emerald" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="#34d399" />
                  </marker>
                  <marker id="arrow-obs-amber" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
                    <polygon points="0 0, 8 3, 0 6" fill="#fbbf24" />
                  </marker>
                </defs>

                <!-- Líneas de difusión desde Subject Central a 4 Observers -->
                <path id="obs-line-1" d="M 235 80 L 435 40" stroke="#a855f7" stroke-width="2" stroke-dasharray="5 3" marker-end="url(#arrow-obs-purple)" />
                <path id="obs-line-2" d="M 235 92 L 435 80" stroke="#0284c7" stroke-width="2" stroke-dasharray="5 3" marker-end="url(#arrow-obs-cyan)" />
                <path id="obs-line-3" d="M 235 108 L 435 120" stroke="#059669" stroke-width="2" stroke-dasharray="5 3" marker-end="url(#arrow-obs-emerald)" />
                <path id="obs-line-4" d="M 235 120 L 435 160" stroke="#d97706" stroke-width="2" stroke-dasharray="5 3" marker-end="url(#arrow-obs-amber)" />

                <!-- NODO CENTRAL: Subject (StockMarket) -->
                <g id="obs-subject-node">
                  <rect x="20" y="55" width="215" height="90" rx="12" fill="#2e1065" stroke="#a855f7" stroke-width="2" />
                  <text x="127" y="80" fill="#f3e8ff" font-size="11.5" font-weight="bold" text-anchor="middle">StockMarketSubject</text>
                  <text x="127" y="97" fill="#d8b4fe" font-size="8.5" text-anchor="middle">attach(), detach(), notify()</text>
                  <rect x="35" y="106" width="185" height="26" rx="6" fill="#1e1b4b" stroke="#818cf8" stroke-width="1" />
                  <text id="obs-ticker-badge" x="127" y="123" fill="#a7f3d0" font-size="10" font-weight="bold" text-anchor="middle">BTC/USD: $64,250 ⚡</text>
                </g>

                <!-- NODO OBSERVER 1: DashboardUI -->
                <g id="obs-node-ui">
                  <rect x="440" y="22" width="225" height="36" rx="8" fill="#1e1b4b" stroke="#818cf8" stroke-width="1.5" />
                  <text x="452" y="44" fill="#e0e7ff" font-size="10" font-weight="bold">1. DashboardUI</text>
                  <text id="obs-ui-status" x="650" y="44" fill="#c084fc" font-size="8.5" text-anchor="end">Render gráfica 📈</text>
                </g>

                <!-- NODO OBSERVER 2: TraderBot -->
                <g id="obs-node-bot">
                  <rect x="440" y="62" width="225" height="36" rx="8" fill="#082f49" stroke="#38bdf8" stroke-width="1.5" />
                  <text x="452" y="84" fill="#e0f2fe" font-size="10" font-weight="bold">2. AutoTraderBot</text>
                  <text id="obs-bot-status" x="650" y="84" fill="#7dd3fc" font-size="8.5" text-anchor="end">Evalúa señal &gt; 65k 🤖</text>
                </g>

                <!-- NODO OBSERVER 3: AuditLog -->
                <g id="obs-node-log">
                  <rect x="440" y="102" width="225" height="36" rx="8" fill="#064e3b" stroke="#34d399" stroke-width="1.5" />
                  <text x="452" y="124" fill="#ecfdf5" font-size="10" font-weight="bold">3. AuditLogger</text>
                  <text id="obs-log-status" x="650" y="124" fill="#6ee7b7" font-size="8.5" text-anchor="end">Append log disco 💾</text>
                </g>

                <!-- NODO OBSERVER 4: PushNotifier -->
                <g id="obs-node-push">
                  <rect x="440" y="142" width="225" height="36" rx="8" fill="#451a03" stroke="#f59e0b" stroke-width="1.5" />
                  <text x="452" y="164" fill="#fef3c7" font-size="10" font-weight="bold">4. PushAlertService</text>
                  <text id="obs-push-status" x="650" y="164" fill="#fcd34d" font-size="8.5" text-anchor="end">SMS Inversores 📱</text>
                </g>
              </svg>
            </div>

            <!-- Control Interactivo: Emitir Evento -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
              <button id="obs-btn-emit" class="px-3.5 py-2 rounded-lg bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/40 text-xs font-mono font-bold transition-all flex items-center gap-2 shadow-sm active:scale-95">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                ⚡ Publicar Tick Aleatorio (notifyObservers)
              </button>
              <span id="obs-feedback" class="text-[11px] font-mono text-muted-foreground">
                Último broadcast: <span class="text-emerald-400">BTC/USD $64,250 notificado a 4 observadores</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- PATRÓN: Chain of Responsibility -->
      <div id="pat-cor" class="gof-pattern-detail space-y-4 hidden">
        <div class="p-4 rounded-xl border border-purple-500/30 bg-purple-950/15">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono text-purple-400 font-bold tracking-widest uppercase">Comportamiento • GoF</span>
              <h4 class="text-base sm:text-lg font-bold text-foreground">Chain of Responsibility (Cadena de Responsabilidad)</h4>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-md bg-purple-500/20 text-purple-300 border border-purple-500/40 font-mono">
              Intención: Desacoplar emisor pasando petición por cadena de manejadores
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Permite pasar peticiones a lo largo de una cadena de manejadores. Al recibir una petición, cada manejador decide si la procesa o la reenvía al siguiente eslabón.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-border/80 bg-black/40 overflow-x-auto space-y-4">
          <div class="min-w-[620px] flex items-center justify-between gap-3 py-2 text-xs">
            <div class="w-28 p-3 rounded-lg border border-border/80 bg-card text-center font-bold text-foreground">Client</div>
            <svg width="36" height="16" viewBox="0 0 36 16" class="text-purple-400 shrink-0">
              <line x1="2" y1="8" x2="26" y2="8" stroke="currentColor" stroke-width="1.8" />
              <polygon points="26,4 34,8 26,12" fill="currentColor" />
            </svg>
            <div class="w-44 p-3 rounded-lg border border-purple-500/40 bg-card/80 text-center font-mono">AuthMiddleware</div>
            <svg width="36" height="16" viewBox="0 0 36 16" class="text-purple-400 shrink-0">
              <line x1="2" y1="8" x2="26" y2="8" stroke="currentColor" stroke-width="1.8" />
              <polygon points="26,4 34,8 26,12" fill="currentColor" />
            </svg>
            <div class="w-44 p-3 rounded-lg border border-purple-500/40 bg-card/80 text-center font-mono">RoleCheckMiddleware</div>
            <svg width="36" height="16" viewBox="0 0 36 16" class="text-purple-400 shrink-0">
              <line x1="2" y1="8" x2="26" y2="8" stroke="currentColor" stroke-width="1.8" />
              <polygon points="26,4 34,8 26,12" fill="currentColor" />
            </svg>
            <div class="w-44 p-3 rounded-lg border border-emerald-500/40 bg-card/80 text-center font-mono">BusinessHandler</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 4. CATEGORÍA: TRADE-OFFS TDS               -->
    <!-- ========================================== -->
    <div id="cat-tradeoffs" class="gof-category-view space-y-4 hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <!-- Strategy vs State -->
        <div class="p-4 rounded-xl border border-amber-500/30 bg-card/60 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="font-bold text-sm text-amber-300">Strategy vs State</h4>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300">Intención Semántica</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            Aunque su diagrama estructural UML es idéntico (un contexto que delega en una interfaz polimórfica), su intención difiere:
          </p>
          <ul class="list-disc list-inside space-y-1 text-muted-foreground">
            <li><strong class="text-foreground">Strategy:</strong> El cliente selecciona y configura conscientemente el algoritmo ("cómo"). Las estrategias son independientes y no alteran el contexto.</li>
            <li><strong class="text-foreground">State:</strong> El cliente no elige los estados; el propio contexto o los estados concretos transicionan dinámicamente según eventos ("qué").</li>
          </ul>
        </div>

        <!-- Adapter vs Facade -->
        <div class="p-4 rounded-xl border border-cyan-500/30 bg-card/60 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="font-bold text-sm text-cyan-300">Adapter vs Facade</h4>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300">Wrappers Opuestos</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            Ambos envuelven código existente, pero con objetivos contrarios:
          </p>
          <ul class="list-disc list-inside space-y-1 text-muted-foreground">
            <li><strong class="text-foreground">Adapter (1 a 1):</strong> Encaja dos interfaces preexistentes e incompatibles sin modificar código cliente ni librerías ajenas.</li>
            <li><strong class="text-foreground">Facade (1 a Muchos):</strong> Crea una <em>nueva interfaz unificada</em> simplificada sobre un subsistema complejo para facilitar su consumo general.</li>
          </ul>
        </div>

        <!-- Composite: Seguridad vs Transparencia -->
        <div class="p-4 rounded-xl border border-emerald-500/30 bg-card/60 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="font-bold text-sm text-emerald-300">Composite: Seguridad vs Transparencia</h4>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300">Dilema Canónico TDS</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            Compromiso arquitectónico al modelar árboles parte-todo:
          </p>
          <ul class="list-disc list-inside space-y-1 text-muted-foreground">
            <li><strong class="text-foreground">Transparencia:</strong> Operaciones de hijos (<code>add()</code>, <code>remove()</code>) en el Componente base. Permite tratamiento polimórfico universal, pero las Hojas lanzan excepciones en runtime.</li>
            <li><strong class="text-foreground">Seguridad:</strong> Operaciones de hijos solo en <code>Composite</code>. Errores detectados en compilación, pero exige <code>instanceof</code> y downcasting.</li>
          </ul>
        </div>

        <!-- Decorator vs Subclases -->
        <div class="p-4 rounded-xl border border-purple-500/30 bg-card/60 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="font-bold text-sm text-purple-300">Decorator vs Subclases</h4>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/20 text-purple-300">Composición Dinámica</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            Evita la explosión combinatoria: con 4 características opcionales, la herencia requeriría $2^4 = 16$ clases. Con Decorator, solo 4 envoltorios combinables en tiempo de ejecución.
          </p>
          <p class="text-muted-foreground leading-relaxed">
            <strong class="text-amber-300 font-mono">Regla TDS:</strong> Si el objeto base no es "ligero" (mucha lógica pesada interna), prioriza <em>Strategy</em>.
          </p>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function initGofMaster() {
    // 1. Manejo de Categorías Principales
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.gof-cat-btn');
    const catViews = document.querySelectorAll<HTMLElement>('.gof-category-view');

    catButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetCat = btn.getAttribute('data-category');
        if (!targetCat) return;

        // Reset visual de todos los botones de categoría
        catButtons.forEach(b => {
          b.classList.remove(
            'active-cat',
            'text-white',
            'bg-indigo-600',
            'shadow-md',
            'shadow-indigo-500/30',
            'border-indigo-400',
            'font-bold'
          );
          b.classList.add('text-muted-foreground', 'border-transparent', 'font-medium');
        });

        // Activar el botón pulsado con destaque inequívoco
        btn.classList.add(
          'active-cat',
          'text-white',
          'bg-indigo-600',
          'shadow-md',
          'shadow-indigo-500/30',
          'border-indigo-400',
          'font-bold'
        );
        btn.classList.remove('text-muted-foreground', 'border-transparent', 'font-medium');

        // Mostrar la vista de categoría correspondiente
        catViews.forEach(view => {
          if (view.id === `cat-${targetCat}`) {
            view.classList.remove('hidden');
          } else {
            view.classList.add('hidden');
          }
        });
      });
    });

    // 2. Manejo de Selección de Patrón dentro de cada categoría
    const patButtons = document.querySelectorAll<HTMLButtonElement>('.gof-pat-btn');

    patButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        // Encontrar el contenedor de categoría padre
        const parentCat = btn.closest('.gof-category-view');
        if (!parentCat) return;

        // Resetear botones hermanos en esta categoría
        const siblingButtons = parentCat.querySelectorAll<HTMLButtonElement>('.gof-pat-btn');
        siblingButtons.forEach(b => {
          b.classList.remove(
            'active-pat',
            'font-semibold',
            'bg-indigo-500/20',
            'text-indigo-300',
            'border-indigo-500/50',
            'bg-cyan-500/20',
            'text-cyan-300',
            'border-cyan-500/50',
            'bg-purple-500/20',
            'text-purple-300',
            'border-purple-500/50',
            'shadow-sm'
          );
          b.classList.add('text-muted-foreground', 'border-transparent', 'font-medium');
        });

        // Activar botón pulsado
        btn.classList.add('active-pat', 'font-semibold', 'shadow-sm');
        btn.classList.remove('text-muted-foreground', 'border-transparent', 'font-medium');
        
        // Estilo según categoría
        if (parentCat.id === 'cat-creational') {
          btn.classList.add('bg-indigo-500/20', 'text-indigo-300', 'border-indigo-500/50');
        } else if (parentCat.id === 'cat-structural') {
          btn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/50');
        } else {
          btn.classList.add('bg-purple-500/20', 'text-purple-300', 'border-purple-500/50');
        }

        // Mostrar el detalle del patrón correspondiente
        const patternDetails = parentCat.querySelectorAll<HTMLElement>('.gof-pattern-detail');
        patternDetails.forEach(detail => {
          if (detail.id === targetId) {
            detail.classList.remove('hidden');
          } else {
            detail.classList.add('hidden');
          }
        });
      });
    });

    // 3. Simulador Interactivo de FSM (Patrón State)
    initFsmSimulator();

    // 4. Simulador Interactivo de Observer (Topología 1 a N)
    initObserverSimulator();
  }

  function initFsmSimulator() {
    let currentState: 'borrador' | 'pagado' | 'enviado' = 'borrador';
    let itemCount = 1;

    const btnAdd = document.getElementById('fsm-btn-add');
    const btnPay = document.getElementById('fsm-btn-pay');
    const btnShip = document.getElementById('fsm-btn-ship');
    const btnReset = document.getElementById('fsm-btn-reset');

    const nodeBorrador = document.getElementById('fsm-node-borrador');
    const nodePagado = document.getElementById('fsm-node-pagado');
    const nodeEnviado = document.getElementById('fsm-node-enviado');

    const currentLabel = document.getElementById('fsm-current-label');
    const itemsLabel = document.getElementById('fsm-items-count');
    const logBox = document.getElementById('fsm-log');

    function updateFsmVisuals(logMsg: string, isError = false) {
      if (currentLabel) {
        if (currentState === 'borrador') {
          currentLabel.textContent = 'EstadoBorrador';
          currentLabel.className = 'text-indigo-400 font-bold';
        } else if (currentState === 'pagado') {
          currentLabel.textContent = 'EstadoPagado';
          currentLabel.className = 'text-cyan-400 font-bold';
        } else {
          currentLabel.textContent = 'EstadoEnviado';
          currentLabel.className = 'text-emerald-400 font-bold';
        }
      }

      if (itemsLabel) {
        itemsLabel.textContent = `Items en Pedido: ${itemCount}`;
      }

      if (logBox) {
        logBox.textContent = logMsg;
        logBox.className = isError 
          ? 'text-red-400 text-[10.5px] leading-relaxed animate-pulse' 
          : 'text-emerald-400 text-[10.5px] leading-relaxed';
      }

      // Actualizar opacidad y puntos de pulso de los nodos SVG
      [nodeBorrador, nodePagado, nodeEnviado].forEach(n => {
        if (!n) return;
        const dot = n.querySelector('.fsm-active-dot');
        const rect = n.querySelector('.fsm-rect');
        n.classList.add('opacity-60');
        if (dot) dot.classList.add('hidden');
        if (rect) rect.setAttribute('stroke-width', '1.5');
      });

      const activeNode = currentState === 'borrador' ? nodeBorrador : currentState === 'pagado' ? nodePagado : nodeEnviado;
      if (activeNode) {
        activeNode.classList.remove('opacity-60');
        const dot = activeNode.querySelector('.fsm-active-dot');
        const rect = activeNode.querySelector('.fsm-rect');
        if (dot) dot.classList.remove('hidden');
        if (rect) rect.setAttribute('stroke-width', '2.5');
      }
    }

    btnAdd?.addEventListener('click', () => {
      if (currentState === 'borrador') {
        itemCount++;
        updateFsmVisuals(`context.addItem(): Delegado en EstadoBorrador. Item #${itemCount} añadido.`);
      } else if (currentState === 'pagado') {
        updateFsmVisuals(`context.addItem(): Excepción en EstadoPagado: Pedido cerrado a modificaciones tras pago.`, true);
      } else {
        updateFsmVisuals(`context.addItem(): Excepción en EstadoEnviado: No se pueden alterar items de un pedido despachado.`, true);
      }
    });

    btnPay?.addEventListener('click', () => {
      if (currentState === 'borrador') {
        currentState = 'pagado';
        updateFsmVisuals(`context.pagar(): Delegado en EstadoBorrador. Pasarela aprobada ➔ Transición a EstadoPagado.`);
      } else if (currentState === 'pagado') {
        updateFsmVisuals(`context.pagar(): Advertencia en EstadoPagado: El pedido ya se encuentra pagado.`, true);
      } else {
        updateFsmVisuals(`context.pagar(): Excepción en EstadoEnviado: El pedido ya fue pagado y despachado.`, true);
      }
    });

    btnShip?.addEventListener('click', () => {
      if (currentState === 'borrador') {
        updateFsmVisuals(`context.despachar(): Excepción en EstadoBorrador: No se puede despachar sin previo pago.`, true);
      } else if (currentState === 'pagado') {
        currentState = 'enviado';
        updateFsmVisuals(`context.despachar(): Delegado en EstadoPagado. Etiqueta logística generada ➔ Transición a EstadoEnviado.`);
      } else {
        updateFsmVisuals(`context.despachar(): Info en EstadoEnviado: El pedido ya se encuentra en tránsito final.`);
      }
    });

    btnReset?.addEventListener('click', () => {
      currentState = 'borrador';
      itemCount = 1;
      updateFsmVisuals(`context.reset(): Pedido reinicializado a EstadoBorrador.`);
    });
  }

  function initObserverSimulator() {
    const btnEmit = document.getElementById('obs-btn-emit');
    const tickerBadge = document.getElementById('obs-ticker-badge');
    const feedback = document.getElementById('obs-feedback');

    const uiStatus = document.getElementById('obs-ui-status');
    const botStatus = document.getElementById('obs-bot-status');
    const logStatus = document.getElementById('obs-log-status');
    const pushStatus = document.getElementById('obs-push-status');

    const assets = [
      { sym: 'BTC/USD', price: '$65,420', action: 'TraderBot: Comprar dip' },
      { sym: 'ETH/USD', price: '$3,480', action: 'TraderBot: Hold' },
      { sym: 'NVDA', price: '$128.50', action: 'TraderBot: Stop-loss OK' },
      { sym: 'AAPL', price: '$224.10', action: 'TraderBot: Rebalancear' },
      { sym: 'MSFT', price: '$448.90', action: 'TraderBot: Alerta precio' }
    ];

    btnEmit?.addEventListener('click', () => {
      const randomAsset = assets[Math.floor(Math.random() * assets.length)];
      const now = new Date().toLocaleTimeString();

      if (tickerBadge) {
        tickerBadge.textContent = `${randomAsset.sym}: ${randomAsset.price} ⚡`;
      }

      if (uiStatus) uiStatus.textContent = `Actualizado ${now} 📈`;
      if (botStatus) botStatus.textContent = `${randomAsset.action} 🤖`;
      if (logStatus) logStatus.textContent = `WAL #${Math.floor(Math.random() * 9000 + 1000)} OK 💾`;
      if (pushStatus) pushStatus.textContent = `SMS enviado [${now}] 📱`;

      if (feedback) {
        feedback.innerHTML = `Último broadcast: <span class="text-emerald-400 font-bold">${randomAsset.sym} ${randomAsset.price}</span> difundido a 4 observadores independientes`;
      }
    });
  }

  // Inicialización inmediata y con eventos de navegación de Astro
  initGofMaster();
  document.addEventListener('astro:page-load', initGofMaster);
</script>
