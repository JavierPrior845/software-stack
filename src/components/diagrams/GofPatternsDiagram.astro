---
// src/components/diagrams/GofPatternsDiagram.astro
---

<div class="gof-master-container my-6 rounded-2xl border border-border/80 bg-gradient-to-b from-card/95 via-card/70 to-background/95 p-5 sm:p-6 shadow-2xl backdrop-blur-xl">
  <!-- Header -->
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-5 border-b border-border/60">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 text-white font-extrabold text-xl flex items-center justify-center shadow-lg shadow-indigo-500/25">
        GoF
      </div>
      <div>
        <h3 class="font-bold text-lg sm:text-xl text-foreground flex items-center gap-2">
          Catálogo Canónico GoF con Diagramas UML
          <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-400 border border-indigo-500/30 font-mono font-medium">
            TDS / UMU
          </span>
        </h3>
        <p class="text-xs text-muted-foreground mt-0.5">
          Estructura UML, participantes, contratos y trade-offs de los 23 patrones de diseño
        </p>
      </div>
    </div>
    
    <!-- Category Tabs (Ultra-visible indicator) -->
    <div class="flex flex-wrap items-center gap-1.5 p-1.5 bg-secondary/40 rounded-xl border border-border/70 text-xs font-mono shadow-inner" id="gof-cat-selector">
      <button 
        type="button" 
        class="gof-cat-btn active-cat px-3.5 py-2 rounded-lg font-bold transition-all duration-200 cursor-pointer text-white bg-indigo-600 shadow-md shadow-indigo-500/30 border border-indigo-400" 
        data-category="creational">
        🔨 Creacionales
      </button>
      <button 
        type="button" 
        class="gof-cat-btn px-3.5 py-2 rounded-lg font-medium transition-all duration-200 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-secondary/60 border border-transparent" 
        data-category="structural">
        🏛️ Estructurales
      </button>
      <button 
        type="button" 
        class="gof-cat-btn px-3.5 py-2 rounded-lg font-medium transition-all duration-200 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-secondary/60 border border-transparent" 
        data-category="behavioral">
        ⚡ Comportamiento
      </button>
      <button 
        type="button" 
        class="gof-cat-btn px-3.5 py-2 rounded-lg font-medium transition-all duration-200 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-secondary/60 border border-transparent" 
        data-category="tradeoffs">
        ⚖️ Trade-offs TDS
      </button>
    </div>
  </div>

  <!-- Main Display Area -->
  <div class="mt-6">

    <!-- ========================================== -->
    <!-- 1. CATEGORÍA: CREACIONALES                 -->
    <!-- ========================================== -->
    <div id="cat-creational" class="gof-category-view space-y-5">
      <!-- Selector de Patrones Creacionales -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none border-b border-border/40">
        <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mr-2 shrink-0">Patrón:</span>
        <button class="gof-pat-btn active-pat px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-indigo-500/20 text-indigo-300 border border-indigo-500/50 shadow-sm shrink-0" data-target="pat-factory-method">
          Factory Method
        </button>
        <button class="gof-pat-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-secondary/40 border border-transparent shrink-0" data-target="pat-abstract-factory">
          Abstract Factory
        </button>
        <button class="gof-pat-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-secondary/40 border border-transparent shrink-0" data-target="pat-builder">
          Builder
        </button>
        <button class="gof-pat-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-secondary/40 border border-transparent shrink-0" data-target="pat-singleton">
          Singleton
        </button>
      </div>

      <!-- PATRÓN: Factory Method -->
      <div id="pat-factory-method" class="gof-pattern-detail space-y-4">
        <div class="p-4 rounded-xl border border-indigo-500/30 bg-indigo-950/15">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono text-indigo-400 font-bold tracking-widest uppercase">Creacional • GoF</span>
              <h4 class="text-base sm:text-lg font-bold text-foreground">Factory Method (Método de Fábrica)</h4>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 font-mono">
              Intención: Desacoplar creación mediante herencia o reflexión
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Define una interfaz o clase base abstracta para la creación de un objeto, delegando en subclases especializadas (o un mecanismo reflexivo de carga) la decisión de qué clase concreta instanciar.
          </p>
        </div>

        <!-- Diagrama UML Factory Method -->
        <div class="p-5 rounded-xl border border-border/80 bg-black/40 overflow-x-auto space-y-4">
          <div class="flex items-center justify-between text-xs font-mono text-muted-foreground pb-2 border-b border-border/40">
            <span class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span> Diagrama de Clases UML Estándar
            </span>
            <span class="text-emerald-400">Relación: Creación desacoplada</span>
          </div>

          <!-- UML Visual Grid -->
          <div class="min-w-[620px] grid grid-cols-2 gap-8 py-4 px-2">
            <!-- Jerarquía de Creadores -->
            <div class="space-y-6">
              <!-- Creator (Abstract) -->
              <div class="w-full rounded-lg border-2 border-indigo-400/60 bg-card p-3 shadow-md">
                <div class="text-center pb-2 border-b border-border/60">
                  <div class="text-[10px] italic text-muted-foreground">&lt;&lt;abstract&gt;&gt;</div>
                  <div class="font-bold text-xs text-indigo-300">Creator</div>
                </div>
                <div class="py-2 text-[11px] font-mono border-b border-border/40 text-muted-foreground">
                  <div>+ anOperation(): void</div>
                  <div class="italic text-foreground">+ createProduct(): Product</div>
                </div>
                <div class="pt-1.5 text-[10px] text-muted-foreground italic">
                  // anOperation invoca createProduct()
                </div>
              </div>

              <!-- Flecha de Herencia UML (──▷) hacia Creator -->
              <div class="flex justify-center -my-3 select-none">
                <svg width="24" height="28" viewBox="0 0 24 28" class="overflow-visible">
                  <polygon points="12,2 5,12 19,12" fill="#0f172a" stroke="#818cf8" stroke-width="2" />
                  <line x1="12" y1="12" x2="12" y2="28" stroke="#818cf8" stroke-width="2" />
                </svg>
              </div>

              <!-- Concrete Creator -->
              <div class="w-full rounded-lg border border-indigo-500/40 bg-card/80 p-3 shadow-md">
                <div class="text-center pb-2 border-b border-border/60">
                  <div class="font-bold text-xs text-foreground">ConcreteCreator</div>
                </div>
                <div class="py-2 text-[11px] font-mono text-indigo-200">
                  <div>+ createProduct(): Product</div>
                </div>
                <div class="pt-1 text-[10px] text-emerald-400 font-mono">
                  return new ConcreteProduct();
                </div>
              </div>
            </div>

            <!-- Jerarquía de Productos -->
            <div class="space-y-6">
              <!-- Product (Interface) -->
              <div class="w-full rounded-lg border-2 border-emerald-400/60 bg-card p-3 shadow-md">
                <div class="text-center pb-2 border-b border-border/60">
                  <div class="text-[10px] italic text-muted-foreground">&lt;&lt;interface&gt;&gt;</div>
                  <div class="font-bold text-xs text-emerald-300">Product</div>
                </div>
                <div class="py-2 text-[11px] font-mono text-muted-foreground">
                  <div>+ doSomething(): void</div>
                </div>
              </div>

              <!-- Flecha de Realización UML (- - ▷) hacia Product -->
              <div class="flex justify-center -my-3 select-none">
                <svg width="24" height="28" viewBox="0 0 24 28" class="overflow-visible">
                  <polygon points="12,2 5,12 19,12" fill="#0f172a" stroke="#34d399" stroke-width="2" />
                  <line x1="12" y1="12" x2="12" y2="28" stroke="#34d399" stroke-width="2" stroke-dasharray="4 3" />
                </svg>
              </div>

              <!-- Concrete Product -->
              <div class="w-full rounded-lg border border-emerald-500/40 bg-card/80 p-3 shadow-md">
                <div class="text-center pb-2 border-b border-border/60">
                  <div class="font-bold text-xs text-foreground">ConcreteProduct</div>
                </div>
                <div class="py-2 text-[11px] font-mono text-emerald-200">
                  <div>+ doSomething(): void</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Leyenda de Participantes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-3 border-t border-border/40 text-xs">
            <div class="space-y-1">
              <strong class="text-indigo-300 font-mono">Participantes:</strong>
              <ul class="list-disc list-inside text-muted-foreground text-[11px] space-y-0.5">
                <li><strong class="text-foreground">Product:</strong> Define la interfaz de los objetos que crea el método.</li>
                <li><strong class="text-foreground">ConcreteProduct:</strong> Implementación real del producto.</li>
                <li><strong class="text-foreground">Creator:</strong> Declara el método fábrica que retorna un objeto de tipo Product.</li>
                <li><strong class="text-foreground">ConcreteCreator:</strong> Sobrescribe el método devolviendo la instancia concreta.</li>
              </ul>
            </div>
            <div class="space-y-1 p-2.5 rounded bg-secondary/20 border border-border/50 text-[11px]">
              <strong class="text-amber-300 font-mono">Variante TDS UMU (Reflexión Dinámica):</strong>
              <p class="text-muted-foreground leading-relaxed">
                Para no crear infinitas subclases `ConcreteCreator`, se parametrizan nombres de clase y se instancian en tiempo de ejecución:
              </p>
              <code class="text-indigo-300 font-mono">Class.forName(name).getDeclaredConstructor().newInstance()</code>
            </div>
          </div>
        </div>
      </div>

      <!-- PATRÓN: Abstract Factory -->
      <div id="pat-abstract-factory" class="gof-pattern-detail space-y-4 hidden">
        <div class="p-4 rounded-xl border border-indigo-500/30 bg-indigo-950/15">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono text-indigo-400 font-bold tracking-widest uppercase">Creacional • GoF</span>
              <h4 class="text-base sm:text-lg font-bold text-foreground">Abstract Factory (Fábrica Abstracta)</h4>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 font-mono">
              Intención: Familias completas de productos compatibles
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Proporciona una interfaz para crear familias de objetos relacionados o dependientes sin especificar sus clases concretas (ej. GUI con Botón y Ventana para Windows y Mac).
          </p>
        </div>

        <!-- Diagrama UML Abstract Factory -->
        <div class="p-5 rounded-xl border border-border/80 bg-black/40 overflow-x-auto space-y-4">
          <div class="text-xs font-mono text-muted-foreground pb-2 border-b border-border/40">
            <span class="text-indigo-300 font-bold">Diagrama UML: Familias de Productos Compatibles</span>
          </div>

          <div class="min-w-[650px] grid grid-cols-3 gap-4 py-2">
            <!-- Fábricas -->
            <div class="space-y-4">
              <div class="rounded-lg border-2 border-indigo-400/60 bg-card p-3 text-xs">
                <div class="text-[10px] text-muted-foreground italic text-center">&lt;&lt;interface&gt;&gt;</div>
                <div class="font-bold text-indigo-300 text-center">GUIFactory</div>
                <div class="mt-2 font-mono text-[11px] text-muted-foreground border-t border-border/40 pt-1">
                  <div>+ createButton(): Button</div>
                  <div>+ createScrollbar(): Scrollbar</div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                <div class="p-2 rounded border border-border/70 bg-card/60">
                  <div class="font-bold text-foreground">WinFactory</div>
                  <div class="text-muted-foreground mt-1">createButton() &#8594; WinButton</div>
                </div>
                <div class="p-2 rounded border border-border/70 bg-card/60">
                  <div class="font-bold text-foreground">MacFactory</div>
                  <div class="text-muted-foreground mt-1">createButton() &#8594; MacButton</div>
                </div>
              </div>
            </div>

            <!-- Familia Botón -->
            <div class="space-y-4">
              <div class="rounded-lg border-2 border-emerald-400/60 bg-card p-3 text-xs">
                <div class="text-[10px] text-muted-foreground italic text-center">&lt;&lt;interface&gt;&gt;</div>
                <div class="font-bold text-emerald-300 text-center">Button</div>
                <div class="mt-2 font-mono text-[11px] text-muted-foreground border-t border-border/40 pt-1">
                  <div>+ render(): void</div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                <div class="p-2 rounded border border-emerald-500/30 bg-card/60 text-foreground">WinButton</div>
                <div class="p-2 rounded border border-emerald-500/30 bg-card/60 text-foreground">MacButton</div>
              </div>
            </div>

            <!-- Familia Scrollbar -->
            <div class="space-y-4">
              <div class="rounded-lg border-2 border-cyan-400/60 bg-card p-3 text-xs">
                <div class="text-[10px] text-muted-foreground italic text-center">&lt;&lt;interface&gt;&gt;</div>
                <div class="font-bold text-cyan-300 text-center">Scrollbar</div>
                <div class="mt-2 font-mono text-[11px] text-muted-foreground border-t border-border/40 pt-1">
                  <div>+ scroll(): void</div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                <div class="p-2 rounded border border-cyan-500/30 bg-card/60 text-foreground">WinScrollbar</div>
                <div class="p-2 rounded border border-cyan-500/30 bg-card/60 text-foreground">MacScrollbar</div>
              </div>
            </div>
          </div>
          <div class="text-xs text-muted-foreground">
            <strong class="text-foreground">Invariante garantizada:</strong> Es imposible mezclar accidentalmente un <code class="text-emerald-400">WinButton</code> con un <code class="text-cyan-400">MacScrollbar</code> porque el cliente solo interactúa con la fábrica abstracta inyectada.
          </div>
        </div>
      </div>

      <!-- PATRÓN: Builder -->
      <div id="pat-builder" class="gof-pattern-detail space-y-4 hidden">
        <div class="p-4 rounded-xl border border-indigo-500/30 bg-indigo-950/15">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono text-indigo-400 font-bold tracking-widest uppercase">Creacional • GoF</span>
              <h4 class="text-base sm:text-lg font-bold text-foreground">Builder (Constructor)</h4>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 font-mono">
              Intención: Construcción paso a paso de objetos complejos
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Separa el proceso de ensamblado de un objeto complejo de su representación final, permitiendo que la misma secuencia de construcción cree configuraciones completamente dispares.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-border/80 bg-black/40 overflow-x-auto space-y-4">
          <div class="text-xs font-mono text-muted-foreground pb-2 border-b border-border/40">
            <span class="text-indigo-300 font-bold">Diagrama UML: Director, Builder y Fluent API</span>
          </div>

          <div class="min-w-[620px] flex items-center justify-between gap-4 py-2">
            <!-- Director -->
            <div class="w-48 rounded-lg border border-border/80 bg-card p-3 text-xs space-y-1">
              <div class="font-bold text-foreground text-center">Director</div>
              <div class="font-mono text-[10px] text-muted-foreground border-t border-border/40 pt-1">
                - builder: Builder
              </div>
              <div class="font-mono text-[10px] text-indigo-300">
                + construct(): void
              </div>
            </div>

            <!-- Conector de Asociación: Director usa Builder -->
            <div class="flex flex-col items-center justify-center px-1">
              <span class="text-[9px] font-mono text-indigo-300 font-semibold mb-0.5">usa</span>
              <svg width="60" height="18" viewBox="0 0 60 18" class="text-indigo-400">
                <line x1="2" y1="9" x2="48" y2="9" stroke="currentColor" stroke-width="1.8" />
                <polygon points="48,5 57,9 48,13" fill="currentColor" />
              </svg>
            </div>

            <!-- Builder Interface -->
            <div class="w-56 rounded-lg border-2 border-indigo-400/60 bg-card p-3 text-xs space-y-1">
              <div class="text-[10px] text-muted-foreground italic text-center">&lt;&lt;interface&gt;&gt;</div>
              <div class="font-bold text-indigo-300 text-center">Builder</div>
              <div class="font-mono text-[10px] text-muted-foreground border-t border-border/40 pt-1 space-y-0.5">
                <div>+ buildPartA(): void</div>
                <div>+ buildPartB(): void</div>
                <div>+ getResult(): Product</div>
              </div>
            </div>

            <!-- Conector de Realización UML: ConcreteBuilder implementa Builder -->
            <div class="flex flex-col items-center justify-center px-1">
              <span class="text-[9px] font-mono text-indigo-300/80 mb-0.5">implements</span>
              <svg width="60" height="18" viewBox="0 0 60 18" class="text-indigo-400">
                <line x1="58" y1="9" x2="14" y2="9" stroke="currentColor" stroke-width="1.8" stroke-dasharray="4 3" />
                <polygon points="14,4 2,9 14,14" fill="#030712" stroke="currentColor" stroke-width="1.8" />
              </svg>
            </div>

            <!-- Concrete Builder -->
            <div class="w-52 rounded-lg border border-indigo-500/40 bg-card/80 p-3 text-xs space-y-1">
              <div class="font-bold text-foreground text-center">ConcreteBuilder</div>
              <div class="font-mono text-[10px] text-emerald-300 border-t border-border/40 pt-1">
                <div>- result: Product</div>
                <div>+ getResult(): Product</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PATRÓN: Singleton -->
      <div id="pat-singleton" class="gof-pattern-detail space-y-4 hidden">
        <div class="p-4 rounded-xl border border-indigo-500/30 bg-indigo-950/15">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono text-indigo-400 font-bold tracking-widest uppercase">Creacional • GoF</span>
              <h4 class="text-base sm:text-lg font-bold text-foreground">Singleton (Instancia Única)</h4>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/40 font-mono">
              Uso Restringido: Cuidado con la Testabilidad
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Garantiza una única instancia en toda la máquina virtual mediante un constructor privado y expone un método de acceso global estático.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-border/80 bg-black/40 overflow-x-auto space-y-4">
          <div class="min-w-[450px] max-w-md mx-auto rounded-lg border-2 border-indigo-400/60 bg-card p-4 text-xs space-y-2">
            <div class="font-bold text-indigo-300 text-center text-sm">Singleton</div>
            <div class="font-mono text-[11px] text-muted-foreground border-y border-border/40 py-2 space-y-1">
              <div>- static instance: Singleton = null</div>
              <div>- Singleton() <span class="text-amber-400 italic">// Constructor Privado</span></div>
            </div>
            <div class="font-mono text-[11px] text-emerald-400 pt-1">
              + static getInstance(): Singleton
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 2. CATEGORÍA: ESTRUCTURALES                -->
    <!-- ========================================== -->
    <div id="cat-structural" class="gof-category-view space-y-5 hidden">
      <!-- Selector de Patrones Estructurales -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none border-b border-border/40">
        <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mr-2 shrink-0">Patrón:</span>
        <button class="gof-pat-btn active-pat px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-cyan-500/20 text-cyan-300 border border-cyan-500/50 shadow-sm shrink-0" data-target="pat-adapter">
          Adapter
        </button>
        <button class="gof-pat-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-secondary/40 border border-transparent shrink-0" data-target="pat-facade">
          Facade
        </button>
        <button class="gof-pat-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-secondary/40 border border-transparent shrink-0" data-target="pat-composite">
          Composite
        </button>
        <button class="gof-pat-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-secondary/40 border border-transparent shrink-0" data-target="pat-decorator">
          Decorator
        </button>
        <button class="gof-pat-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-secondary/40 border border-transparent shrink-0" data-target="pat-proxy">
          Proxy
        </button>
      </div>

      <!-- PATRÓN: Adapter -->
      <div id="pat-adapter" class="gof-pattern-detail space-y-4">
        <div class="p-4 rounded-xl border border-cyan-500/30 bg-cyan-950/15">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono text-cyan-400 font-bold tracking-widest uppercase">Estructural • GoF</span>
              <h4 class="text-base sm:text-lg font-bold text-foreground">Adapter (Adaptador)</h4>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-mono">
              Intención: Hacer encajar dos interfaces incompatibles (1 a 1)
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Convierte la interfaz de una clase en otra interfaz esperada por el cliente. Permite que clases colaboren aunque sus contratos originales no coincidan.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-border/80 bg-black/40 overflow-x-auto space-y-4">
