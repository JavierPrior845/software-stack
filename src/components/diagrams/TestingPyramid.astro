---
const tiers = [
  {
    level: 'E2E / Sistema',
    share: '~5–10 %',
    speed: 'segundos / minutos',
    scope: 'Navegador / API real completa · detecta regresiones en flujos críticos',
    width: 'w-2/5',
    tone: 'border-rose-400/35 bg-rose-400/10 text-rose-200',
  },
  {
    level: 'Integración / Contratos',
    share: '~20–25 %',
    speed: 'decenas de ms',
    scope: 'Repositorios contra BD real (Testcontainers), serialización HTTP y colas',
    width: 'w-3/4',
    tone: 'border-amber-400/35 bg-amber-400/10 text-amber-200',
  },
  {
    level: 'Unitarios (Dominio y lógica pura)',
    share: '~70 %',
    speed: '< 1 ms por test',
    scope: 'Funciones, entidades y casos de uso con dependencias inyectadas (fakes/stubs)',
    width: 'w-full',
    tone: 'accent-border accent-soft text-ink',
  },
];
---

<div class="space-y-3">
  <div class="flex flex-col items-center space-y-2 py-2">
    {
      tiers.map((tier) => (
        <div class={`${tier.width} rounded-lg border px-3.5 py-2.5 transition-all ${tier.tone}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-mono text-xs font-semibold">{tier.level}</span>
            <span class="font-mono text-[10px] opacity-80">
              {tier.share} · {tier.speed}
            </span>
          </div>
          <p class="mt-1 text-[11px] leading-snug text-muted">{tier.scope}</p>
        </div>
      ))
    }
  </div>

  <div class="flex items-center justify-between border-t border-white/5 pt-2.5 font-mono text-[10px] text-dim">
    <span>▲ Subir: más realismo · más fragilidad · más coste</span>
    <span>▼ Bajar: aislamiento · determinismo · feedback instantáneo</span>
  </div>
</div>
