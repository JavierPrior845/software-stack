---
// src/components/diagrams/TestingPyramid.astro
const tiers = [
  {
    level: 'E2E / Sistema',
    share: '~5–10 %',
    speed: 'segundos / minutos',
    scope: 'Navegador / API real completa · detecta regresiones en flujos críticos de negocio',
    width: 'w-2/5',
    tone: 'border-rose-400/40 bg-rose-950/20 text-rose-200',
  },
  {
    level: 'Integración / Contratos',
    share: '~20–25 %',
    speed: 'decenas de ms',
    scope: 'Repositorios contra BD real (Testcontainers), serialización HTTP y colas',
    width: 'w-3/4',
    tone: 'border-amber-400/40 bg-amber-950/20 text-amber-200',
  },
  {
    level: 'Unitarios (Dominio y lógica pura)',
    share: '~70 %',
    speed: '< 1 ms por test',
    scope: 'Funciones, entidades y casos de uso con dependencias inyectadas (Fakes, Stubs, Mocks)',
    width: 'w-full',
    tone: 'border-emerald-400/50 bg-emerald-950/30 text-emerald-200',
  },
];
---

<div class="testing-master rounded-2xl border border-border/80 bg-gradient-to-b from-card/95 via-card/70 to-background/95 p-5 shadow-2xl backdrop-blur-xl space-y-4">
  <!-- Header con Tabs -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-border/60">
    <div>
      <h4 class="font-bold text-sm text-foreground flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        Verificación & Validación: Pirámide y Test Doubles
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-mono">
          PDS Tema 5
        </span>
      </h4>
      <p class="text-[11px] text-muted-foreground mt-0.5">
        Estrategia de verificación, defectología formal y taxonomía de Gerard Meszaros
      </p>
    </div>

    <!-- Tab switcher -->
    <div class="flex flex-wrap items-center gap-1 p-1 bg-secondary/40 rounded-xl border border-border/60 text-xs font-mono" id="test-view-tabs">
      <button class="test-tab-btn active-test-tab px-3 py-1.5 rounded-lg font-bold text-white bg-emerald-600 shadow-md shadow-emerald-500/30 border border-emerald-400 transition-all cursor-pointer" data-target="tier-pyramid">
        ▲ Pirámide
      </button>
      <button class="test-tab-btn px-3 py-1.5 rounded-lg font-medium text-muted-foreground hover:text-foreground hover:bg-secondary/60 border border-transparent transition-all cursor-pointer" data-target="tier-doubles">
        🎭 5 Test Doubles
      </button>
      <button class="test-tab-btn px-3 py-1.5 rounded-lg font-medium text-muted-foreground hover:text-foreground hover:bg-secondary/60 border border-transparent transition-all cursor-pointer" data-target="tier-defectology">
        🔬 Defectología & Cobertura
      </button>
    </div>
  </div>

  <!-- TAB 1: PIRÁMIDE DE TESTING: SVG GEOMÉTRICO INTERACTIVO -->
  <div id="tier-pyramid" class="test-panel space-y-4">
    <!-- Selector de Modo: Pirámide Canónica vs Cucurucho de Helado -->
    <div class="flex flex-wrap items-center justify-between gap-2 p-2.5 rounded-xl border border-border/70 bg-black/40">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono text-muted-foreground">Estrategia:</span>
        <button
          type="button"
          id="btn-mode-pyramid"
          class="px-2.5 py-1 rounded-lg text-xs font-mono font-bold text-white bg-emerald-600 border border-emerald-400 shadow-sm cursor-pointer transition-all"
        >
          ▲ Pirámide Canónica (Mike Cohn)
        </button>
        <button
          type="button"
          id="btn-mode-icecream"
          class="px-2.5 py-1 rounded-lg text-xs font-mono font-medium text-muted-foreground hover:text-foreground bg-secondary/50 border border-transparent cursor-pointer transition-all"
        >
          🍦 Anti-patrón Cucurucho (Ice Cream Cone)
        </button>
      </div>
      <span class="text-[11px] font-mono text-cyan-400" id="pyramid-mode-badge">
        Arquitectura Óptima (Alta Cobertura & CI Rápido)
      </span>
    </div>

    <!-- Canvas SVG de la Pirámide -->
    <div class="w-full overflow-x-auto py-2 flex justify-center bg-black/30 rounded-xl border border-border/60">
      <svg viewBox="0 0 740 310" class="w-full max-w-[740px] h-auto select-none font-mono" style="min-width: 620px;" id="svg-pyramid">
        <defs>
          <linearGradient id="grad-e2e" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.85" />
            <stop offset="100%" stop-color="#be123c" stop-opacity="0.95" />
          </linearGradient>
          <linearGradient id="grad-integ" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.85" />
            <stop offset="100%" stop-color="#b45309" stop-opacity="0.95" />
          </linearGradient>
          <linearGradient id="grad-unit" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.85" />
            <stop offset="100%" stop-color="#047857" stop-opacity="0.95" />
          </linearGradient>

          <marker id="pyr-arrow-up" viewBox="0 0 10 10" refX="5" refY="3" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 6 L 5 0 L 10 6 z" fill="#f43f5e" />
          </marker>
          <marker id="pyr-arrow-down" viewBox="0 0 10 10" refX="5" refY="7" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 0 L 5 6 L 10 0 z" fill="#10b981" />
          </marker>
        </defs>

        <!-- Eje Izquierdo: Coste y Lentitud -->
        <g transform="translate(45, 0)">
          <line x1="0" y1="270" x2="0" y2="40" stroke="#f43f5e" stroke-width="2" stroke-dasharray="4 3" marker-end="url(#pyr-arrow-up)" />
          <text x="-10" y="155" fill="#fb7185" font-size="10" font-weight="bold" transform="rotate(-90 -10 155)" text-anchor="middle">
            ▲ Coste de Mantenimiento & Lentitud ($$$)
          </text>
        </g>

        <!-- Eje Derecho: Feedback y Aislamiento -->
        <g transform="translate(695, 0)">
          <line x1="0" y1="40" x2="0" y2="270" stroke="#10b981" stroke-width="2" stroke-dasharray="4 3" marker-end="url(#pyr-arrow-down)" />
          <text x="12" y="155" fill="#34d399" font-size="10" font-weight="bold" transform="rotate(90 12 155)" text-anchor="middle">
            ▼ Velocidad (&lt;1ms) & Aislamiento Determinista
          </text>
        </g>

        <!-- TIER 1: E2E / SISTEMA -->
        <g id="pyr-tier-e2e" class="cursor-pointer transition-all hover:opacity-95">
          <polygon
            id="poly-e2e"
            points="370,25 285,100 455,100"
            fill="url(#grad-e2e)"
            stroke="#fda4af"
            stroke-width="1.5"
            class="transition-all duration-300"
          />
          <text id="txt-e2e-title" x="370" y="65" fill="#ffffff" font-size="11" font-weight="bold" text-anchor="middle">E2E / UI / Sistema</text>
          <text id="txt-e2e-sub" x="370" y="82" fill="#ffe4e6" font-size="9" text-anchor="middle">~5–10% · Segundos / Minutos</text>
        </g>

        <!-- TIER 2: INTEGRACIÓN / CONTRATOS -->
        <g id="pyr-tier-integ" class="cursor-pointer transition-all hover:opacity-95">
          <polygon
            id="poly-integ"
            points="280,108 195,190 545,190 460,108"
            fill="url(#grad-integ)"
            stroke="#fde68a"
            stroke-width="1.5"
            class="transition-all duration-300"
          />
          <text id="txt-integ-title" x="370" y="142" fill="#ffffff" font-size="12" font-weight="bold" text-anchor="middle">Integración & Contratos</text>
          <text id="txt-integ-sub" x="370" y="160" fill="#fef3c7" font-size="9.5" text-anchor="middle">~20–25% · Decenas de ms (BD real, HTTP)</text>
        </g>

        <!-- TIER 3: UNITARIOS / DOMINIO -->
        <g id="pyr-tier-unit" class="cursor-pointer transition-all hover:opacity-95">
          <polygon
            id="poly-unit"
            points="190,198 100,285 640,285 550,198"
            fill="url(#grad-unit)"
            stroke="#a7f3d0"
            stroke-width="1.5"
            class="transition-all duration-300"
          />
          <text id="txt-unit-title" x="370" y="234" fill="#ffffff" font-size="13" font-weight="bold" text-anchor="middle">Tests Unitarios (Dominio Puro)</text>
          <text id="txt-unit-sub" x="370" y="254" fill="#d1fae5" font-size="10" text-anchor="middle">~70% · &lt; 1 ms por test · Base de Confianza</text>
        </g>
      </svg>
    </div>

    <!-- Inspector Dinámico del Nivel de Test Seleccionado -->
    <div class="p-4 rounded-xl border border-border/80 bg-card/70 space-y-3" id="pyr-inspector">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/50 pb-2">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-emerald-400" id="insp-pyr-dot"></span>
          <span class="text-xs font-bold text-foreground font-mono uppercase tracking-wide" id="insp-pyr-title">
            Tests Unitarios (Lógica de Dominio y Funciones Puras)
          </span>
        </div>
        <span class="text-[10px] px-2 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" id="insp-pyr-share">
          Volumen: ~70% del total
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        <div class="p-2.5 rounded-lg bg-black/40 border border-border/50 space-y-1">
          <span class="text-[10px] text-muted-foreground uppercase">Velocidad / Latencia</span>
          <div class="font-bold text-emerald-400" id="insp-pyr-speed">&lt; 1 ms por test</div>
          <p class="text-[10px] text-muted-foreground" id="insp-pyr-speed-desc">Feedback casi instantáneo en el IDE al guardar.</p>
        </div>

        <div class="p-2.5 rounded-lg bg-black/40 border border-border/50 space-y-1">
          <span class="text-[10px] text-muted-foreground uppercase">Herramientas Canónicas</span>
          <div class="font-bold text-cyan-300" id="insp-pyr-tools">Vitest, JUnit 5, GoogleTest, pytest</div>
          <p class="text-[10px] text-muted-foreground" id="insp-pyr-tools-desc">Con dobles de test en memoria (Stubs, Mocks).</p>
        </div>

        <div class="p-2.5 rounded-lg bg-black/40 border border-border/50 space-y-1">
          <span class="text-[10px] text-muted-foreground uppercase">Riesgo Arquitectónico</span>
          <div class="font-bold text-rose-300" id="insp-pyr-risk">Bajo si no se abusa de mocks</div>
          <p class="text-[10px] text-muted-foreground" id="insp-pyr-risk-desc">Mocks excesivos atan el test a la implementación.</p>
        </div>
      </div>

      <p class="text-[11px] text-muted-foreground leading-relaxed" id="insp-pyr-scope">
        Prueban funciones puras, algoritmos y entidades de dominio en completo aislamiento. Si una prueba falla, el mensaje de error señala directamente la línea de código causante del fallo sin ambigüedad.
      </p>
    </div>
  </div>

  <!-- TAB 2: TAXONOMÍA DE GERARD MESZAROS (5 TEST DOUBLES) -->
  <div id="tier-doubles" class="test-panel space-y-3 hidden">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
      <!-- 1. DUMMY -->
      <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-foreground">1. Dummy (Maniquí)</span>
          <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-slate-500/20 text-slate-300">Relleno</span>
        </div>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Se pasa únicamente para rellenar parámetros obligatorios de una firma. <strong>Nunca se invoca ni se lee</strong> en el test.
        </p>
        <div class="p-2 rounded bg-black/40 font-mono text-[10px] text-slate-300">
          <code>servicio.procesar(pedido, null /* dummy */)</code>
        </div>
      </div>

      <!-- 2. STUB -->
      <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-cyan-300">2. Stub (Respuesta Fija)</span>
          <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300">Entrada</span>
        </div>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Devuelve respuestas fijas y preprogramadas para suministrar datos al SUT. No evalúa comportamiento ni registra llamadas.
        </p>
        <div class="p-2 rounded bg-black/40 font-mono text-[10px] text-cyan-200">
          <code>when(reloj.ahora()).thenReturn("10:00:00")</code>
        </div>
      </div>

      <!-- 3. SPY -->
      <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-amber-300">3. Spy (Espía)</span>
          <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300">Auditor</span>
        </div>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Es un Stub que además <strong>registra internamente información</strong> sobre cuántas veces y con qué parámetros fue llamado.
        </p>
        <div class="p-2 rounded bg-black/40 font-mono text-[10px] text-amber-200">
          <code>assert(spyEmail.vecesLlamado == 1)</code>
        </div>
      </div>

      <!-- 4. MOCK -->
      <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-purple-300">4. Mock (Expectativas)</span>
          <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300">Comportamiento</span>
        </div>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Preprogramado con <strong>expectativas estrictas</strong>. Si una llamada ocurre fuera de orden o con argumentos erróneos, el test falla.
        </p>
        <div class="p-2 rounded bg-black/40 font-mono text-[10px] text-purple-200">
          <code>verify(pasarela).cobrar(eq(100.0), any())</code>
        </div>
      </div>

      <!-- 5. FAKE -->
      <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1.5 sm:col-span-2 lg:col-span-2">
        <div class="flex items-center justify-between">
          <span class="font-bold text-emerald-300">5. Fake (Simulador Ligero)</span>
          <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">Funcional</span>
        </div>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Tiene una <strong>implementación funcional real pero simplificada</strong> (ej. base de datos simulada en memoria usando un <code>Map</code> o lista en RAM). Rápido, determinista e ideal para tests de casos de uso sin levantar PostgreSQL.
        </p>
        <div class="p-2 rounded bg-black/40 font-mono text-[10px] text-emerald-200">
          <code>class InMemoryUserRepo implements UserRepo &#123; private map = new Map(); ... &#125;</code>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 3: DEFECTOLOGÍA Y COBERTURA -->
  <div id="tier-defectology" class="test-panel space-y-3 hidden">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
      <!-- Cadena de Defectología -->
      <div class="p-3.5 rounded-xl border border-red-500/30 bg-red-950/15 space-y-2">
        <span class="font-bold text-red-300 font-mono uppercase text-[11px]">Cadena de Defectología Formal (PDS)</span>
        <div class="space-y-1.5 text-[11px] font-mono">
          <div class="p-2 rounded bg-black/40 text-red-200">
            <strong>1. Error Humano:</strong> Equivocación cometida por el programador (fatiga, mala comprensión del requisito).
          </div>
          <div class="text-center text-muted-foreground">↓ introduce</div>
          <div class="p-2 rounded bg-black/40 text-amber-200">
            <strong>2. Defecto (Bug):</strong> Porción de código incorrecta o ausente en el repositorio fuente.
          </div>
          <div class="text-center text-muted-foreground">↓ ejecuta en runtime</div>
          <div class="p-2 rounded bg-black/40 text-rose-300">
            <strong>3. Fallo Observable:</strong> El software produce una salida o comportamiento que viola la especificación.
          </div>
        </div>
      </div>

      <!-- Cobertura de Caja Blanca vs Negra -->
      <div class="p-3.5 rounded-xl border border-cyan-500/30 bg-cyan-950/15 space-y-2">
        <span class="font-bold text-cyan-300 font-mono uppercase text-[11px]">Técnicas de Prueba y Cobertura</span>
        <div class="space-y-2 text-[11px] text-muted-foreground">
          <p>
            <strong class="text-foreground">Caja Negra (Funcional):</strong> Se diseñan sin ver el código. Usa <em>partición de equivalencia</em> (clases válidas e inválidas) y <em>análisis de valores límite</em> ($0$, $-1$, $MAX\_INT$).
          </p>
          <p>
            <strong class="text-foreground">Caja Blanca (Estructural):</strong> Basada en el grafo de flujo del código:
          </p>
          <ul class="list-disc list-inside space-y-0.5 text-[10px] font-mono text-cyan-200">
            <li>Cobertura de Líneas (Line Coverage).</li>
            <li>Cobertura de Ramas (Branch Coverage en `if/else`).</li>
            <li><strong>MC/DC (Modified Condition Decision Coverage):</strong> Demuestra que cada condición booleana puede afectar independientemente al resultado de la decisión (estándar en aviónica y medicina).</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initTestingMaster() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.test-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.test-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const target = tab.getAttribute('data-target');
        if (!target) return;

        tabs.forEach(t => {
          t.classList.remove(
            'active-test-tab',
            'font-bold',
            'text-white',
            'bg-emerald-600',
            'border-emerald-400',
            'shadow-md',
            'shadow-emerald-500/30'
          );
          t.classList.add('text-muted-foreground', 'border-transparent', 'font-medium');
        });

        tab.classList.add(
          'active-test-tab',
          'font-bold',
          'text-white',
          'bg-emerald-600',
          'border-emerald-400',
          'shadow-md',
          'shadow-emerald-500/30'
        );
        tab.classList.remove('text-muted-foreground', 'border-transparent', 'font-medium');

        panels.forEach(p => {
          if (p.id === target) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  }

  initTestingMaster();
  document.addEventListener('astro:page-load', initTestingMaster);

  // Lógica interactiva de la Pirámide SVG y Anti-patrón Cucurucho
  function initPyramidSvg() {
    const tierPanel = document.getElementById('tier-pyramid');
    if (!tierPanel) return;

    const btnPyramid = tierPanel.querySelector<HTMLButtonElement>('#btn-mode-pyramid');
    const btnIceCream = tierPanel.querySelector<HTMLButtonElement>('#btn-mode-icecream');
    const modeBadge = tierPanel.querySelector<HTMLElement>('#pyramid-mode-badge');

    const polyE2E = tierPanel.querySelector<SVGPolygonElement>('#poly-e2e');
    const polyInteg = tierPanel.querySelector<SVGPolygonElement>('#poly-integ');
    const polyUnit = tierPanel.querySelector<SVGPolygonElement>('#poly-unit');

    const txtE2ETitle = tierPanel.querySelector<SVGTextElement>('#txt-e2e-title');
    const txtE2ESub = tierPanel.querySelector<SVGTextElement>('#txt-e2e-sub');
    const txtIntegTitle = tierPanel.querySelector<SVGTextElement>('#txt-integ-title');
    const txtIntegSub = tierPanel.querySelector<SVGTextElement>('#txt-integ-sub');
    const txtUnitTitle = tierPanel.querySelector<SVGTextElement>('#txt-unit-title');
    const txtUnitSub = tierPanel.querySelector<SVGTextElement>('#txt-unit-sub');

    // Inspector
    const inspDot = tierPanel.querySelector<HTMLElement>('#insp-pyr-dot');
    const inspTitle = tierPanel.querySelector<HTMLElement>('#insp-pyr-title');
    const inspShare = tierPanel.querySelector<HTMLElement>('#insp-pyr-share');
    const inspSpeed = tierPanel.querySelector<HTMLElement>('#insp-pyr-speed');
    const inspSpeedDesc = tierPanel.querySelector<HTMLElement>('#insp-pyr-speed-desc');
    const inspTools = tierPanel.querySelector<HTMLElement>('#insp-pyr-tools');
    const inspToolsDesc = tierPanel.querySelector<HTMLElement>('#insp-pyr-tools-desc');
    const inspRisk = tierPanel.querySelector<HTMLElement>('#insp-pyr-risk');
    const inspRiskDesc = tierPanel.querySelector<HTMLElement>('#insp-pyr-risk-desc');
    const inspScope = tierPanel.querySelector<HTMLElement>('#insp-pyr-scope');

    let isIceCream = false;

    type TierKey = 'unit' | 'integ' | 'e2e';

    function setInspector(tier: TierKey) {
      if (tier === 'unit') {
        if (inspDot) inspDot.className = 'w-3 h-3 rounded-full bg-emerald-400';
        if (inspTitle) inspTitle.textContent = 'Tests Unitarios (Lógica de Dominio y Funciones Puras)';
        if (inspShare) {
          inspShare.textContent = isIceCream ? 'Volumen en Cucurucho: ~10% (¡Peligro!)' : 'Volumen Canónico: ~70%';
          inspShare.className = `text-[10px] px-2 py-0.5 rounded font-mono ${isIceCream ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'}`;
        }
        if (inspSpeed) inspSpeed.textContent = '< 1 ms por test';
        if (inspSpeedDesc) inspSpeedDesc.textContent = 'Feedback instantáneo al guardar código en el IDE.';
        if (inspTools) inspTools.textContent = 'Vitest, JUnit 5, GoogleTest, pytest';
        if (inspToolsDesc) inspToolsDesc.textContent = 'Aislamiento con dobles de test en memoria (Fakes/Stubs).';
        if (inspRisk) inspRisk.textContent = isIceCream ? 'Base raquítica: lógica sin probar' : 'Bajo si no se abusa de mocks';
        if (inspRiskDesc) inspRiskDesc.textContent = isIceCream ? 'Los bugs de casos de borde se escapan hasta producción.' : 'Evitar validar detalles internos en lugar de comportamiento.';
        if (inspScope) inspScope.textContent = 'Verifican algoritmos, reglas de negocio y mutaciones de estado en memoria pura. Corren miles en cuestión de segundos en la integración continua (CI).';
      } else if (tier === 'integ') {
        if (inspDot) inspDot.className = 'w-3 h-3 rounded-full bg-amber-400';
        if (inspTitle) inspTitle.textContent = 'Tests de Integración & Contratos';
        if (inspShare) {
          inspShare.textContent = isIceCream ? 'Volumen en Cucurucho: ~20%' : 'Volumen Canónico: ~20–25%';
          inspShare.className = 'text-[10px] px-2 py-0.5 rounded font-mono bg-amber-500/20 text-amber-300 border border-amber-500/30';
        }
        if (inspSpeed) inspSpeed.textContent = '10 – 200 ms por test';
        if (inspSpeedDesc) inspSpeedDesc.textContent = 'Levantan contenedores efímeros o servicios locales.';
        if (inspTools) inspTools.textContent = 'Testcontainers (PostgreSQL, Redis), MockWebServer, Pact';
        if (inspToolsDesc) inspToolsDesc.textContent = 'Verifican esquemas SQL reales y contratos de API.';
        if (inspRisk) inspRisk.textContent = 'Complejidad de orquestación en CI';
        if (inspRiskDesc) inspRiskDesc.textContent = 'Necesitan Docker disponible en el runner de GitHub Actions.';
        if (inspScope) inspScope.textContent = 'Comprueban la integración real de la infraestructura: consultas SQL contra PostgreSQL, migraciones Flyway/Liquibase, serialización JSON y publicación en colas RabbitMQ/Kafka.';
      } else if (tier === 'e2e') {
        if (inspDot) inspDot.className = 'w-3 h-3 rounded-full bg-rose-400';
        if (inspTitle) inspTitle.textContent = 'Tests E2E / Sistema Completo / UI';
        if (inspShare) {
          inspShare.textContent = isIceCream ? 'Volumen en Cucurucho: ~70% (¡Inviable!)' : 'Volumen Canónico: ~5–10%';
          inspShare.className = `text-[10px] px-2 py-0.5 rounded font-mono ${isIceCream ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'bg-rose-500/15 text-rose-200 border border-rose-500/30'}`;
        }
        if (inspSpeed) inspSpeed.textContent = 'Segundos a Minutos por test';
        if (inspSpeedDesc) inspSpeedDesc.textContent = 'Inician navegador headless, red y frontend completo.';
        if (inspTools) inspTools.textContent = 'Playwright, Cypress, Selenium, Appium';
        if (inspToolsDesc) inspToolsDesc.textContent = 'Simulan navegación real de usuario final.';
        if (inspRisk) inspRisk.textContent = isIceCream ? 'CI de 4 horas + tests flaky' : 'Flakiness y mantenimiento elevado';
        if (inspRiskDesc) inspRiskDesc.textContent = isIceCream ? 'Cualquier cambio mínimo en CSS o latencia de red tumba la suite.' : 'Reservar únicamente para los 5-10 flujos críticos de facturación.';
        if (inspScope) inspScope.textContent = 'Valida los "happy paths" cruciales de negocio desde la perspectiva del usuario: registro, login, pasarela de pago y checkout final con todas las capas activas.';
      }
    }

    function applyMode(iceCream: boolean) {
      isIceCream = iceCream;
      if (iceCream) {
        // Modo Cucurucho: Invertir geometrías SVG
        btnIceCream?.classList.add('bg-rose-600', 'border-rose-400', 'text-white', 'font-bold');
        btnIceCream?.classList.remove('bg-secondary/50', 'text-muted-foreground', 'border-transparent', 'font-medium');
        btnPyramid?.classList.remove('bg-emerald-600', 'border-emerald-400', 'text-white', 'font-bold');
        btnPyramid?.classList.add('bg-secondary/50', 'text-muted-foreground', 'border-transparent', 'font-medium');

        if (modeBadge) {
          modeBadge.textContent = '⚠️ Anti-patrón: CI Frágil, Lento (horas) y Alta Falsa Alarma';
          modeBadge.className = 'text-[11px] font-mono text-rose-400 font-bold';
        }

        // Geometrías invertidas (Cucurucho de Helado)
        // E2E es un bloque gigante arriba (~70%)
        polyE2E?.setAttribute('points', '100,25 640,25 550,135 190,135');
        txtE2ETitle?.setAttribute('y', '70');
        txtE2ESub?.setAttribute('y', '92');
        if (txtE2ESub) txtE2ESub.textContent = '¡~70%! Manual / Navegador · Minutos a Horas (Flaky)';

        // Integración en el medio (~20%)
        polyInteg?.setAttribute('points', '195,143 545,143 460,215 280,215');
        txtIntegTitle?.setAttribute('y', '172');
        txtIntegSub?.setAttribute('y', '192');
        if (txtIntegSub) txtIntegSub.textContent = '~20% · Integración parcial';

        // Unitarios es una punta raquítica abajo (~10%)
        polyUnit?.setAttribute('points', '285,223 455,223 370,285');
        txtUnitTitle?.setAttribute('y', '248');
        txtUnitTitle?.setAttribute('font-size', '10.5');
        txtUnitSub?.setAttribute('y', '264');
        if (txtUnitSub) txtUnitSub.textContent = '¡Solo ~10%! Base inestable';

        setInspector('e2e');
      } else {
        // Modo Canónico: Restaurar Pirámide de Mike Cohn
        btnPyramid?.classList.add('bg-emerald-600', 'border-emerald-400', 'text-white', 'font-bold');
        btnPyramid?.classList.remove('bg-secondary/50', 'text-muted-foreground', 'border-transparent', 'font-medium');
        btnIceCream?.classList.remove('bg-rose-600', 'border-rose-400', 'text-white', 'font-bold');
        btnIceCream?.classList.add('bg-secondary/50', 'text-muted-foreground', 'border-transparent', 'font-medium');

        if (modeBadge) {
          modeBadge.textContent = 'Arquitectura Óptima (Alta Cobertura & CI Rápido)';
          modeBadge.className = 'text-[11px] font-mono text-cyan-400';
        }

        // Geometrías canónicas
        polyE2E?.setAttribute('points', '370,25 285,100 455,100');
        txtE2ETitle?.setAttribute('y', '65');
        txtE2ESub?.setAttribute('y', '82');
        if (txtE2ESub) txtE2ESub.textContent = '~5–10% · Segundos / Minutos';

        polyInteg?.setAttribute('points', '280,108 195,190 545,190 460,108');
        txtIntegTitle?.setAttribute('y', '142');
        txtIntegSub?.setAttribute('y', '160');
        if (txtIntegSub) txtIntegSub.textContent = '~20–25% · Decenas de ms (BD real, HTTP)';

        polyUnit?.setAttribute('points', '190,198 100,285 640,285 550,198');
        txtUnitTitle?.setAttribute('y', '234');
        txtUnitTitle?.setAttribute('font-size', '13');
        txtUnitSub?.setAttribute('y', '254');
        if (txtUnitSub) txtUnitSub.textContent = '~70% · < 1 ms por test · Base de Confianza';

        setInspector('unit');
      }
    }

    btnPyramid?.addEventListener('click', () => applyMode(false));
    btnIceCream?.addEventListener('click', () => applyMode(true));

    tierPanel.querySelector('#pyr-tier-unit')?.addEventListener('click', () => setInspector('unit'));
    tierPanel.querySelector('#pyr-tier-integ')?.addEventListener('click', () => setInspector('integ'));
    tierPanel.querySelector('#pyr-tier-e2e')?.addEventListener('click', () => setInspector('e2e'));
  }

  initPyramidSvg();
  document.addEventListener('astro:page-load', initPyramidSvg);
</script>
