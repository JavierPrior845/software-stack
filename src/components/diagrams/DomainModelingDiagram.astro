---
// DomainModelingDiagram.astro
// Interactive visualizer for Software Domain Modeling (PDS UMU Tema 3)
// Covers: Conceptual Classes (Symbol, Intension, Extension), Golden Rule (No FKs),
// UML Relationship Types (Aggregation vs Composition lifecycle), and Canonical Car Example in C++.
---

<div class="space-y-4 text-xs font-mono select-none" id="domain-diagram-root">
  <!-- Nav Tabs -->
  <div class="flex flex-wrap gap-2 border-b border-line/60 pb-3">
    <button
      id="dom-tab-clases"
      class="px-3 py-1.5 rounded-lg border border-line bg-surface-2 text-ink font-semibold transition-all hover:bg-surface-3 flex items-center gap-1.5 text-xs active-domain"
      data-view="clases"
    >
      <span class="w-2 h-2 rounded-full bg-blue-400"></span>
      1. Clases Conceptuales & Regla de Oro
    </button>
    <button
      id="dom-tab-relaciones"
      class="px-3 py-1.5 rounded-lg border border-line bg-surface-1 text-dim font-medium transition-all hover:bg-surface-2 hover:text-ink flex items-center gap-1.5 text-xs"
      data-view="relaciones"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      2. 6 Relaciones UML & Ciclo de Vida
    </button>
    <button
      id="dom-tab-code"
      class="px-3 py-1.5 rounded-lg border border-line bg-surface-1 text-dim font-medium transition-all hover:bg-surface-2 hover:text-ink flex items-center gap-1.5 text-xs"
      data-view="code"
    >
      <span class="w-2 h-2 rounded-full bg-purple-400"></span>
      3. Código Canónico C++ (Coche)
    </button>
  </div>

  <!-- PANEL 1: Clases Conceptuales & Regla de Oro -->
  <div id="dom-view-clases" class="space-y-3">
    <div class="p-3.5 rounded-xl border border-blue-500/30 bg-blue-500/5 text-ink leading-relaxed">
      <div class="flex items-center justify-between font-semibold text-blue-300 text-sm mb-1.5">
        <span>📦 La Clase Conceptual en el Modelo de Dominio (PDS UMU)</span>
        <span class="text-[11px] px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30">Tema 3</span>
      </div>
      <p class="text-dim text-[11px] mb-3">
        El modelo de dominio es una <strong>representación visual de las clases conceptuales u objetos del mundo real</strong> en un ámbito de interés, no de artefactos de software.
      </p>

      <!-- Anatomía de una Clase Conceptual -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 text-[11px] mb-3">
        <div class="p-2.5 rounded-lg bg-surface-2 border border-line/60">
          <div class="font-semibold text-blue-300 mb-1">1. Símbolo</div>
          <p class="text-dim text-[10px]">
            La representación visual y el nombre significativo que identifica al concepto (ej. <code class="text-ink">Vuelo</code>, <code class="text-ink">CuentaBancaria</code>).
          </p>
        </div>
        <div class="p-2.5 rounded-lg bg-surface-2 border border-line/60">
          <div class="font-semibold text-emerald-300 mb-1">2. Intensión</div>
          <p class="text-dim text-[10px]">
            La definición formal, responsabilidades y propiedades intrínsecas que caracterizan a los objetos que pertenecen a la clase.
          </p>
        </div>
        <div class="p-2.5 rounded-lg bg-surface-2 border border-line/60">
          <div class="font-semibold text-purple-300 mb-1">3. Extensión</div>
          <p class="text-dim text-[10px]">
            El conjunto real de todas las instancias u objetos concretos existentes en el universo del dominio a los que aplica la clase.
          </p>
        </div>
      </div>

      <!-- Regla de Oro de PDS -->
      <div class="p-3 rounded-lg bg-surface-2 border border-amber-500/40 text-[11px]">
        <div class="font-semibold text-amber-300 mb-1 flex items-center gap-1.5">
          <span>⚠️ Regla de Oro del Modelado de Dominio (UMU):</span>
        </div>
        <p class="text-ink/90 leading-relaxed">
          <strong>Nunca se deben modelar claves ajenas (FKs) ni punteros técnicos como atributos</strong> en una clase conceptual (ej. colocar <code class="text-red-400">id_cliente</code> o <code class="text-red-400">cliente_ptr</code> dentro de <code class="text-ink">Pedido</code> es un error de modelado).
        </p>
        <p class="text-dim text-[10px] mt-1.5">
          Las relaciones entre conceptos deben expresarse <strong>exclusivamente como Asociaciones UML</strong> con nombre de rol y multiplicidades (ej. <code class="text-emerald-400">Cliente [1] ── realiza ──&gt; [*] Pedido</code>). Los IDs y claves foráneas son detalles de persistencia relacional que pertenecen a la capa de base de datos.
        </p>
      </div>
    </div>
  </div>

  <!-- PANEL 2: 6 Relaciones UML & Ciclo de Vida -->
  <div id="dom-view-relaciones" class="hidden space-y-3">
    <div class="overflow-x-auto rounded-xl border border-line bg-surface-1">
      <table class="w-full text-left text-[11px] border-collapse">
        <thead>
          <tr class="bg-surface-2 border-b border-line text-ink font-semibold">
            <th class="p-2.5">Relación</th>
            <th class="p-2.5">Símbolo UML</th>
            <th class="p-2.5">Semántica</th>
            <th class="p-2.5">Ciclo de Vida de las Partes</th>
            <th class="p-2.5">Código Típico (C++ / Java)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line/40 text-dim">
          <tr class="hover:bg-surface-2/40">
            <td class="p-2.5 font-medium text-ink">Dependencia</td>
            <td class="p-2.5 font-mono text-blue-300">- - - &gt;</td>
            <td class="p-2.5">"Usa un" temporalmente</td>
            <td class="p-2.5 text-ink">Sin posesión. No hay enlace de vida.</td>
            <td class="p-2.5 text-[10px] font-mono">Parámetro en método o variable local</td>
          </tr>
          <tr class="hover:bg-surface-2/40">
            <td class="p-2.5 font-medium text-ink">Asociación</td>
            <td class="p-2.5 font-mono text-cyan-300">──&gt; o ──</td>
            <td class="p-2.5">"Conoce a" / Colabora con</td>
            <td class="p-2.5 text-ink">Independiente (ambos viven por separado).</td>
            <td class="p-2.5 text-[10px] font-mono">Puntero/referencia como atributo de instancia</td>
          </tr>
          <tr class="hover:bg-surface-2/40 bg-surface-2/20">
            <td class="p-2.5 font-medium text-emerald-300">Agregación (Débil)</td>
            <td class="p-2.5 font-mono text-emerald-400">◇── (rombo blanco)</td>
            <td class="p-2.5">"Tiene un" (Todo-Parte débil)</td>
            <td class="p-2.5 text-emerald-300 font-semibold">Independiente: si el Todo muere, la Parte SOBREVIVE.</td>
            <td class="p-2.5 text-[10px] font-mono">shared_ptr&lt;T&gt; o referencia compartida externa</td>
          </tr>
          <tr class="hover:bg-surface-2/40 bg-surface-2/30">
            <td class="p-2.5 font-medium text-amber-300">Composición (Fuerte)</td>
            <td class="p-2.5 font-mono text-amber-400">◆── (rombo negro)</td>
            <td class="p-2.5">"Formado por" (Todo-Parte fuerte)</td>
            <td class="p-2.5 text-amber-300 font-semibold">Dependiente: si el Todo muere, la Parte MUERE con él.</td>
            <td class="p-2.5 text-[10px] font-mono">Instancia por valor directo o unique_ptr&lt;T&gt; exclusivo</td>
          </tr>
          <tr class="hover:bg-surface-2/40">
            <td class="p-2.5 font-medium text-ink">Generalización</td>
            <td class="p-2.5 font-mono text-purple-300">──▷ (triángulo blanco)</td>
            <td class="p-2.5">"Es un" (Herencia / Subtipo)</td>
            <td class="p-2.5 text-ink">Identidad y estructura compartida al 100%.</td>
            <td class="p-2.5 text-[10px] font-mono">class Perro : public Animal</td>
          </tr>
          <tr class="hover:bg-surface-2/40">
            <td class="p-2.5 font-medium text-ink">Realización</td>
            <td class="p-2.5 font-mono text-pink-300">- - ▷ (triángulo blanco discont.)</td>
            <td class="p-2.5">"Implementa contrato"</td>
            <td class="p-2.5 text-ink">Garantiza el comportamiento de la interfaz abstracta.</td>
            <td class="p-2.5 text-[10px] font-mono">class PostgresRepo : public IRepo</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- DIAGRAMA VISUAL SVG: Diagrama de Clases UML y Simulador de Ciclo de Vida -->
    <div class="p-4 rounded-xl border border-emerald-500/30 bg-surface-2/60 space-y-3" id="dom-lifecycle-sim">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line/60 pb-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          <span class="font-bold text-ink text-xs font-mono">
            Diagrama de Clases UML Canónico: Agregación (◇) vs Composición (◆)
          </span>
        </div>
        <span class="text-[10px] px-2 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          Semántica del Ciclo de Vida
        </span>
      </div>

      <!-- Canvas SVG UML -->
      <div class="w-full overflow-x-auto py-2 flex justify-center bg-black/40 rounded-xl border border-line/60">
        <svg viewBox="0 0 760 190" class="w-full max-w-[760px] h-auto select-none font-mono" style="min-width: 620px;">
          <!-- CLASE CONDUCCIÓN (Izquierda - Agregación) -->
          <g id="uml-conductor" class="transition-all duration-300" transform="translate(20, 20)">
            <rect width="180" height="90" rx="8" fill="#064e3b" stroke="#10b981" stroke-width="1.8" class="uml-box" />
            <rect width="180" height="26" rx="8" fill="#047857" />
            <text x="90" y="17" fill="#d1fae5" font-size="11" font-weight="bold" text-anchor="middle">Conductor</text>
            <text x="12" y="46" fill="#a7f3d0" font-size="9.5">+ nombre: string</text>
            <text x="12" y="64" fill="#a7f3d0" font-size="9.5">+ conducir(): void</text>
            <rect x="10" y="70" width="160" height="15" rx="3" fill="#022c22" />
            <text id="badge-conductor" x="90" y="81" fill="#34d399" font-size="8.5" font-weight="bold" text-anchor="middle">ESTADO: VIVO EN HEAP</text>
          </g>

          <!-- LÍNEA AGREGACIÓN: Conductor ---◇ Coche -->
          <g transform="translate(200, 65)">
            <line x1="0" y1="0" x2="80" y2="0" stroke="#10b981" stroke-width="2" />
            <!-- Rombo hueco (Agregación) en el extremo de Coche (x=80) -->
            <polygon points="80,0 72,-6 64,0 72,6" fill="#0f172a" stroke="#10b981" stroke-width="1.8" />
            <text x="10" y="-8" fill="#a7f3d0" font-size="9">1..*</text>
            <text x="45" y="-8" fill="#a7f3d0" font-size="9">0..1</text>
            <text x="38" y="15" fill="#6ee7b7" font-size="8" text-anchor="middle">Agregación ◇</text>
          </g>

          <!-- CLASE CENTRAL: COCHE (El Todo) -->
          <g id="uml-coche" class="transition-all duration-300" transform="translate(280, 15)">
            <rect width="200" height="100" rx="10" fill="#1e1b4b" stroke="#818cf8" stroke-width="2.2" class="uml-box" />
            <rect width="200" height="28" rx="10" fill="#312e81" />
            <text x="100" y="18" fill="#ffffff" font-size="12" font-weight="bold" text-anchor="middle">Coche : IVehiculo</text>
            <text x="12" y="48" fill="#e0e7ff" font-size="9.5">- motor: Motor (por valor)</text>
            <text x="12" y="64" fill="#e0e7ff" font-size="9.5">- conductor: Conductor*</text>
            <text x="12" y="80" fill="#818cf8" font-size="9">+ mover(): void</text>
            <rect x="12" y="84" width="176" height="14" rx="3" fill="#0f172a" />
            <text id="badge-coche" x="100" y="94" fill="#c7d2fe" font-size="8.5" font-weight="bold" text-anchor="middle">ESTADO: OBJETO ACTIVO</text>
          </g>

          <!-- LÍNEA COMPOSICIÓN: Coche ◆--- Motor -->
          <g transform="translate(480, 65)">
            <line x1="0" y1="0" x2="80" y2="0" stroke="#f59e0b" stroke-width="2" />
            <!-- Rombo relleno (Composición) en el extremo de Coche (x=0) -->
            <polygon points="0,0 8,-6 16,0 8,6" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.8" />
            <text x="25" y="-8" fill="#fcd34d" font-size="9">1</text>
            <text x="65" y="-8" fill="#fcd34d" font-size="9">1</text>
            <text x="45" y="15" fill="#f59e0b" font-size="8" text-anchor="middle">Composición ◆</text>
          </g>

          <!-- CLASE MOTOR (Derecha - Composición) -->
          <g id="uml-motor" class="transition-all duration-300" transform="translate(560, 20)">
            <rect width="180" height="90" rx="8" fill="#451a03" stroke="#f59e0b" stroke-width="1.8" class="uml-box" />
            <rect width="180" height="26" rx="8" fill="#78350f" />
            <text x="90" y="17" fill="#fef3c7" font-size="11" font-weight="bold" text-anchor="middle">Motor</text>
            <text x="12" y="46" fill="#fde68a" font-size="9.5">+ encender(): void</text>
            <text x="12" y="64" fill="#fde68a" font-size="9.5">+ potenciaCv: int</text>
            <rect x="10" y="70" width="160" height="15" rx="3" fill="#1c1917" />
            <text id="badge-motor" x="90" y="81" fill="#f59e0b" font-size="8.5" font-weight="bold" text-anchor="middle">ESTADO: VIVO CON EL COCHE</text>
          </g>

          <!-- Relación Dependencia abajo: GPS -->
          <g transform="translate(380, 115)">
            <line x1="0" y1="0" x2="0" y2="35" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="4 3" />
            <polygon points="0,35 -4,28 4,28" fill="#38bdf8" />
            <text x="15" y="22" fill="#7dd3fc" font-size="8">- - -&gt; Dependencia ("usa un")</text>
          </g>
          <g transform="translate(300, 150)">
            <rect width="160" height="26" rx="6" fill="#082f49" stroke="#0284c7" stroke-width="1" />
            <text x="80" y="17" fill="#bae6fd" font-size="9.5" text-anchor="middle">GPSNavigationService</text>
          </g>
        </svg>
      </div>

      <!-- Panel del Simulador Interactivo -->
      <div class="flex flex-wrap items-center justify-between gap-3 p-2.5 rounded-lg bg-surface-1 border border-line/70 text-xs font-mono">
        <div class="flex items-center gap-2">
          <span class="text-dim text-[11px]">Simulación RAII:</span>
          <button
            type="button"
            id="btn-dom-demolish"
            class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold transition-all shadow-sm cursor-pointer"
          >
            💥 Demoler Coche (delete coche_ptr)
          </button>
          <button
            type="button"
            id="btn-dom-restore"
            class="px-3 py-1.5 rounded-lg bg-secondary/60 hover:bg-secondary text-dim hover:text-ink transition-all cursor-pointer"
          >
            ↺ Restaurar
          </button>
        </div>

        <div class="text-[11px] text-right font-mono" id="sim-log-title">
          <span class="text-emerald-400">Todo y partes en ejecución normal</span>
        </div>
      </div>

      <!-- Explicación Didáctica en Tiempo Real -->
      <div class="p-3 rounded-lg bg-surface-1 border border-line/60 text-[11px] leading-relaxed text-dim" id="sim-explanation">
        <strong class="text-ink">Semántica en Memoria:</strong> El <code class="text-ink">Coche</code> tiene al <code class="text-amber-300">Motor</code> por <strong>Composición (◆)</strong> (destrucción ligada e inseparable). En cambio, tiene al <code class="text-emerald-300">Conductor</code> por <strong>Agregación (◇)</strong> (puntero no propietario: si el coche se destruye, el conductor permanece vivo en el Heap).
      </div>
    </div>
  </div>

  <!-- PANEL 3: Código Canónico C++ (Coche) -->
  <div id="dom-view-code" class="hidden space-y-3">
    <div class="p-3.5 rounded-xl border border-purple-500/30 bg-purple-500/5 text-ink leading-relaxed">
      <div class="flex items-center justify-between font-semibold text-purple-300 text-sm mb-1.5">
        <span>🚗 Ejemplo Unificado del Coche (PDS UMU en C++20)</span>
        <span class="text-[11px] px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">Gestión de Memoria</span>
      </div>
      <p class="text-dim text-[11px] mb-3">
        Demuestra cómo cada relación UML del modelo conceptual se traslada inequívocamente a constructores, destructores y paso de parámetros en código real:
      </p>

      <div class="rounded-lg bg-surface-3 border border-line/80 p-3 font-mono text-[11px] text-ink overflow-x-auto leading-relaxed">
        <pre class="text-dim"><span class="text-purple-400">// 1. REALIZACIÓN (- - ▷): Interfaz pura con contrato virtual</span>
<span class="text-blue-400">class</span> <span class="text-emerald-300">IVehiculo</span> &#123;
<span class="text-blue-400">public</span>:
    <span class="text-blue-400">virtual</span> <span class="text-blue-400">void</span> mover() = 0;
    <span class="text-blue-400">virtual</span> ~IVehiculo() = <span class="text-blue-400">default</span>;
&#125;;

<span class="text-purple-400">// 2. COMPOSICIÓN (◆──): Motor atado al ciclo de vida del Coche</span>
<span class="text-blue-400">class</span> <span class="text-emerald-300">Motor</span> &#123; <span class="text-blue-400">public</span>: <span class="text-blue-400">void</span> encender() &#123;&#125; &#125;;

<span class="text-purple-400">// 3. AGREGACIÓN (◇──): Conductor existe independientemente del Coche</span>
<span class="text-blue-400">class</span> <span class="text-emerald-300">Conductor</span> &#123; <span class="text-blue-400">public</span>: std::string nombre; &#125;;

<span class="text-purple-400">// SERVICIO EXTERNO (Para Dependencia)</span>
<span class="text-blue-400">class</span> <span class="text-emerald-300">GPSNavigationService</span> &#123; <span class="text-blue-400">public</span>: <span class="text-blue-400">void</span> fijarRuta(<span class="text-blue-400">const</span> std::string&amp; dest) &#123;&#125; &#125;;

<span class="text-purple-400">// CLASE CONTENEDORA</span>
<span class="text-blue-400">class</span> <span class="text-emerald-300">Coche</span> : <span class="text-blue-400">public</span> <span class="text-emerald-300">IVehiculo</span> &#123; <span class="text-purple-400">// Realización</span>
<span class="text-blue-400">private</span>:
    <span class="text-emerald-300">Motor</span> motor;                    <span class="text-amber-400">// COMPOSICIÓN: por valor directo (muere con el Coche)</span>
    <span class="text-emerald-300">Conductor</span>* conductorAsignado;   <span class="text-emerald-400">// AGREGACIÓN: puntero compartido (si Coche muere, Conductor sobrevive)</span>

<span class="text-blue-400">public</span>:
    Coche() : conductorAsignado(<span class="text-blue-400">nullptr</span>) &#123;&#125;
    
    <span class="text-blue-400">void</span> asignarConductor(<span class="text-emerald-300">Conductor</span>* c) &#123; conductorAsignado = c; &#125;

    <span class="text-purple-400">// DEPENDENCIA (- - -&gt;): El GPS solo se usa temporalmente dentro del método, no es atributo</span>
    <span class="text-blue-400">void</span> navegarHacia(<span class="text-emerald-300">GPSNavigationService</span>&amp; gps, <span class="text-blue-400">const</span> std::string&amp; destino) &#123;
        gps.fijarRuta(destino); <span class="text-dim">// "Usa un" servicio externo puntualmente</span>
    &#125;

    <span class="text-blue-400">void</span> mover() <span class="text-blue-400">override</span> &#123; motor.encender(); &#125;
&#125;;</pre>
      </div>
    </div>
  </div>
</div>

<script>
  function setupDomainTabs() {
    const root = document.getElementById('domain-diagram-root');
    if (!root) return;

    const tabs = {
      clases: { btn: root.querySelector('#dom-tab-clases'), view: root.querySelector('#dom-view-clases') },
      relaciones: { btn: root.querySelector('#dom-tab-relaciones'), view: root.querySelector('#dom-view-relaciones') },
      code: { btn: root.querySelector('#dom-tab-code'), view: root.querySelector('#dom-view-code') },
    };

    function activate(name: 'clases' | 'relaciones' | 'code') {
      Object.entries(tabs).forEach(([key, item]) => {
        if (!item.btn || !item.view) return;
        const isActive = key === name;
        if (isActive) {
          item.view.classList.remove('hidden');
          item.btn.classList.add('active-domain', 'bg-surface-2', 'text-ink', 'font-semibold');
          item.btn.classList.remove('bg-surface-1', 'text-dim', 'font-medium');
        } else {
          item.view.classList.add('hidden');
          item.btn.classList.remove('active-domain', 'bg-surface-2', 'text-ink', 'font-semibold');
          item.btn.classList.add('bg-surface-1', 'text-dim', 'font-medium');
        }
      });
    }

    Object.entries(tabs).forEach(([key, item]) => {
      if (!item.btn) return;
      item.btn.addEventListener('click', () => activate(key as 'clases' | 'relaciones' | 'code'));
    });
  }

  setupDomainTabs();
  document.addEventListener('astro:page-load', setupDomainTabs);

  // Simulador de Ciclo de Vida: Agregación vs Composición
  function initLifecycleSimulator() {
    const root = document.getElementById('dom-lifecycle-sim');
    if (!root) return;

    const btnDemolish = root.querySelector<HTMLButtonElement>('#btn-dom-demolish');
    const btnRestore = root.querySelector<HTMLButtonElement>('#btn-dom-restore');

    const umlCoche = root.querySelector<SVGGElement>('#uml-coche');
    const umlMotor = root.querySelector<SVGGElement>('#uml-motor');
    const umlConductor = root.querySelector<SVGGElement>('#uml-conductor');

    const badgeCoche = root.querySelector<SVGTextElement>('#badge-coche');
    const badgeMotor = root.querySelector<SVGTextElement>('#badge-motor');
    const badgeConductor = root.querySelector<SVGTextElement>('#badge-conductor');

    const logTitle = root.querySelector<HTMLElement>('#sim-log-title');
    const explanation = root.querySelector<HTMLElement>('#sim-explanation');

    btnDemolish?.addEventListener('click', () => {
      // 1. Coche destruido
      if (umlCoche) {
        umlCoche.style.opacity = '0.35';
        umlCoche.style.filter = 'grayscale(80%)';
      }
      if (badgeCoche) {
        badgeCoche.textContent = '💥 DESTRUIDO (~Coche())';
        badgeCoche.setAttribute('fill', '#f43f5e');
      }

      // 2. Motor destruido en cascada (Composición ◆)
      if (umlMotor) {
        umlMotor.style.opacity = '0.35';
        umlMotor.style.filter = 'grayscale(80%)';
      }
      if (badgeMotor) {
        badgeMotor.textContent = '💥 DESTRUIDO (Cascada ◆)';
        badgeMotor.setAttribute('fill', '#f43f5e');
      }

      // 3. Conductor SOBREVIVE (Agregación ◇)
      if (umlConductor) {
        umlConductor.style.opacity = '1';
        umlConductor.style.filter = 'drop-shadow(0 0 8px rgba(16, 185, 129, 0.4))';
      }
      if (badgeConductor) {
        badgeConductor.textContent = '✓ SOBREVIVE EN HEAP (◇)';
        badgeConductor.setAttribute('fill', '#34d399');
      }

      if (logTitle) {
        logTitle.innerHTML = '<span class="text-rose-400 font-bold">💥 delete coche; ejecutado</span>';
      }

      if (explanation) {
        explanation.innerHTML = '<strong class="text-rose-400">Demostración RAII / C++:</strong> Al invocar <code class="text-ink">delete coche;</code>, su destructor invoca automáticamente el destructor de <code class="text-amber-300">Motor motor;</code> (Composición ◆: mueren juntos). Sin embargo, <code class="text-emerald-300">Conductor*</code> era una Agregación débil (◇): el Coche no era propietario del puntero, por lo que el objeto Conductor sigue existiendo ileso en el Heap.';
      }
    });

    btnRestore?.addEventListener('click', () => {
      if (umlCoche) {
        umlCoche.style.opacity = '1';
        umlCoche.style.filter = 'none';
      }
      if (badgeCoche) {
        badgeCoche.textContent = 'ESTADO: OBJETO ACTIVO';
        badgeCoche.setAttribute('fill', '#c7d2fe');
      }

      if (umlMotor) {
        umlMotor.style.opacity = '1';
        umlMotor.style.filter = 'none';
      }
      if (badgeMotor) {
        badgeMotor.textContent = 'ESTADO: VIVO CON EL COCHE';
        badgeMotor.setAttribute('fill', '#f59e0b');
      }

      if (umlConductor) {
        umlConductor.style.opacity = '1';
        umlConductor.style.filter = 'none';
      }
      if (badgeConductor) {
        badgeConductor.textContent = 'ESTADO: VIVO EN HEAP';
        badgeConductor.setAttribute('fill', '#34d399');
      }

      if (logTitle) {
        logTitle.innerHTML = '<span class="text-emerald-400">Todo y partes en ejecución normal</span>';
      }

      if (explanation) {
        explanation.innerHTML = '<strong class="text-ink">Semántica en Memoria:</strong> El <code class="text-ink">Coche</code> tiene al <code class="text-amber-300">Motor</code> por <strong>Composición (◆)</strong> (destrucción ligada e inseparable). En cambio, tiene al <code class="text-emerald-300">Conductor</code> por <strong>Agregación (◇)</strong> (puntero no propietario: si el coche se destruye, el conductor permanece vivo en el Heap).';
      }
    });
  }

  initLifecycleSimulator();
  document.addEventListener('astro:page-load', initLifecycleSimulator);
</script>

