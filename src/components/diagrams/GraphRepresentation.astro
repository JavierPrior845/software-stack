---
// GraphRepresentation.astro - Grafo dibujado junto a su Matriz de Adyacencia y su Lista de Adyacencia
---

<div class="space-y-4">
  <!-- 1. El Grafo Dibujado -->
  <div class="rounded-lg border border-white/10 bg-black/25 p-3.5">
    <div class="flex items-center justify-between">
      <span class="font-mono text-xs font-semibold text-ink">Grafo no dirigido ponderado (4 vértices)</span>
      <span class="font-mono text-[10px] text-dim">V = &#123;0, 1, 2, 3&#125; · E = 4</span>
    </div>

    <div class="mt-3 flex items-center justify-center py-2 font-mono text-xs">
      <div class="relative w-64 rounded-lg border border-white/8 bg-white/[0.02] p-4 text-center">
        <!-- Fila superior: 0 y 1 -->
        <div class="flex items-center justify-between">
          <div class="flex h-9 w-9 items-center justify-center rounded-full border border-indigo-400/50 bg-indigo-500/20 font-bold text-indigo-200">
            0
          </div>
          <div class="flex flex-1 items-center justify-center border-t-2 border-dashed border-white/20 px-2 text-[10px] text-emerald-300">
            peso = 2
          </div>
          <div class="flex h-9 w-9 items-center justify-center rounded-full border border-indigo-400/50 bg-indigo-500/20 font-bold text-indigo-200">
            1
          </div>
        </div>

        <!-- Conexiones verticales -->
        <div class="my-2 flex justify-between px-2 text-[10px] text-emerald-300">
          <span class="border-l-2 border-dashed border-white/20 pl-2">w=6</span>
          <span class="border-r-2 border-dashed border-white/20 pr-2">w=3</span>
        </div>

        <!-- Fila inferior: 2 y 3 -->
        <div class="flex items-center justify-between">
          <div class="flex h-9 w-9 items-center justify-center rounded-full border border-indigo-400/50 bg-indigo-500/20 font-bold text-indigo-200">
            2
          </div>
          <div class="flex flex-1 items-center justify-center border-t-2 border-dashed border-white/20 px-2 text-[10px] text-emerald-300">
            peso = 4
          </div>
          <div class="flex h-9 w-9 items-center justify-center rounded-full border border-indigo-400/50 bg-indigo-500/20 font-bold text-indigo-200">
            3
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Comparación: Matriz vs Listas de Punteros -->
  <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
    <!-- Matriz de Adyacencia -->
    <div class="rounded-lg border border-white/8 bg-white/[0.015] p-3">
      <div class="flex items-baseline justify-between gap-1">
        <span class="font-mono text-xs font-medium text-ink">Matriz de Adyacencia</span>
        <span class="font-mono text-[10px] text-muted">Espacio O(V²)</span>
      </div>
      <p class="mt-1 text-[10px] text-dim">Array contiguo bidimensional [V][V]. Consulta rápida de arista O(1).</p>

      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-center font-mono text-[11px]">
          <thead>
            <tr class="border-b border-white/10 text-dim text-[10px]">
              <th class="p-1">u \ v</th>
              <th class="p-1 text-ink">[0]</th>
              <th class="p-1 text-ink">[1]</th>
              <th class="p-1 text-ink">[2]</th>
              <th class="p-1 text-ink">[3]</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr>
              <td class="p-1 font-bold text-dim">[0]</td>
              <td class="p-1 text-dim">0</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">2</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">6</td>
              <td class="p-1 text-dim">0</td>
            </tr>
            <tr>
              <td class="p-1 font-bold text-dim">[1]</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">2</td>
              <td class="p-1 text-dim">0</td>
              <td class="p-1 text-dim">0</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">3</td>
            </tr>
            <tr>
              <td class="p-1 font-bold text-dim">[2]</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">6</td>
              <td class="p-1 text-dim">0</td>
              <td class="p-1 text-dim">0</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">4</td>
            </tr>
            <tr>
              <td class="p-1 font-bold text-dim">[3]</td>
              <td class="p-1 text-dim">0</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">3</td>
              <td class="p-1 font-semibold text-emerald-300 bg-emerald-400/10 rounded">4</td>
              <td class="p-1 text-dim">0</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Listas de Adyacencia -->
    <div class="rounded-lg border border-white/8 bg-white/[0.015] p-3">
      <div class="flex items-baseline justify-between gap-1">
        <span class="font-mono text-xs font-medium text-ink">Listas de Adyacencia</span>
        <span class="font-mono text-[10px] text-muted">Espacio O(V + E)</span>
      </div>
      <p class="mt-1 text-[10px] text-dim">Array de punteros a cabeceras de lista con tuplas (vecino, peso).</p>

      <div class="mt-3 space-y-1.5 font-mono text-[10px]">
        <div class="flex items-center gap-1.5 rounded border border-white/5 bg-black/20 p-1.5">
          <span class="w-10 font-bold text-indigo-300">adj[0]</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:1, w:2)</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:2, w:6)</span>
          <span class="text-dim">──► null</span>
        </div>
        <div class="flex items-center gap-1.5 rounded border border-white/5 bg-black/20 p-1.5">
          <span class="w-10 font-bold text-indigo-300">adj[1]</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:0, w:2)</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:3, w:3)</span>
          <span class="text-dim">──► null</span>
        </div>
        <div class="flex items-center gap-1.5 rounded border border-white/5 bg-black/20 p-1.5">
          <span class="w-10 font-bold text-indigo-300">adj[2]</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:0, w:6)</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:3, w:4)</span>
          <span class="text-dim">──► null</span>
        </div>
        <div class="flex items-center gap-1.5 rounded border border-white/5 bg-black/20 p-1.5">
          <span class="w-10 font-bold text-indigo-300">adj[3]</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:1, w:3)</span>
          <span class="text-dim">──►</span>
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-ink">(v:2, w:4)</span>
          <span class="text-dim">──► null</span>
        </div>
      </div>
    </div>
  </div>
</div>
