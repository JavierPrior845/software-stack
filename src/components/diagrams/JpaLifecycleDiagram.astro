---
// src/components/diagrams/JpaLifecycleDiagram.astro
---

<div class="jpa-container my-6 rounded-2xl border border-border/80 bg-gradient-to-b from-card/95 via-card/70 to-background/95 p-5 sm:p-6 shadow-2xl backdrop-blur-xl">
  <!-- Header -->
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-5 border-b border-border/60">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 text-white font-extrabold text-xl flex items-center justify-center shadow-lg shadow-cyan-500/25">
        ORM
      </div>
      <div>
        <h3 class="font-bold text-lg sm:text-xl text-foreground flex items-center gap-2">
          Persistencia, Ciclo de Vida JPA y SQL vs NoSQL
          <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 font-mono font-medium">
            PDS / UMU
          </span>
        </h3>
        <p class="text-xs text-muted-foreground mt-0.5">
          Estados del EntityManager, superación del Impedance Mismatch y comparativa ACID vs BASE
        </p>
      </div>
    </div>

    <!-- Mode Selector -->
    <div class="flex flex-wrap items-center gap-1.5 p-1.5 bg-secondary/40 rounded-xl border border-border/70 text-xs font-mono shadow-inner" id="jpa-tabs">
      <button 
        type="button" 
        class="jpa-tab-btn active-jpa px-3.5 py-2 rounded-lg font-bold transition-all duration-200 cursor-pointer text-white bg-cyan-600 shadow-md shadow-cyan-500/30 border border-cyan-400" 
        data-view="lifecycle">
        🔄 Ciclo de Vida JPA
      </button>
      <button 
        type="button" 
        class="jpa-tab-btn px-3.5 py-2 rounded-lg font-medium transition-all duration-200 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-secondary/60 border border-transparent" 
        data-view="sql-nosql">
        ⚖️ SQL vs NoSQL (CAP/BASE)
      </button>
      <button 
        type="button" 
        class="jpa-tab-btn px-3.5 py-2 rounded-lg font-medium transition-all duration-200 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-secondary/60 border border-transparent" 
        data-view="inheritance">
        🏛️ Herencia ORM & N+1
      </button>
    </div>
  </div>

  <!-- Panels Area -->
  <div class="mt-6">

    <!-- PANEL 1: CICLO DE VIDA JPA -->
    <div id="view-lifecycle" class="jpa-view space-y-5">
      <div class="p-3.5 rounded-xl border border-cyan-500/30 bg-cyan-950/15 text-xs text-muted-foreground leading-relaxed">
        <strong class="text-cyan-300">Contexto de Persistencia y EntityManager:</strong> En JPA/Hibernate, las entidades no se guardan de forma aislada e instantánea. Transitan a través de una máquina de estados finita gestionada por el <code class="text-foreground">EntityManager</code> (caché de primer nivel y unidad de trabajo transaccional).
      </div>

      <!-- Diagrama de Estados Finitos JPA: SVG Interactivo -->
      <div class="p-5 rounded-xl border border-border/80 bg-black/40 overflow-x-auto space-y-4" id="jpa-fsm-container">
        <div class="text-xs font-mono text-muted-foreground pb-2 border-b border-border/40 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
            <span class="text-cyan-300 font-bold">Máquina de Estados Finita de una Entidad JPA (FSM Interactiva)</span>
          </div>
          <span class="text-[11px] px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-mono">PDS Tema 6</span>
        </div>

        <!-- SVG Canvas FSM -->
        <div class="w-full overflow-x-auto py-2 flex justify-center">
          <svg viewBox="0 0 860 340" class="w-full max-w-[860px] h-auto select-none font-mono" style="min-width: 680px;">
            <defs>
              <marker id="arrow-cyan" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#06b6d4" />
              </marker>
              <marker id="arrow-emerald" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#10b981" />
              </marker>
              <marker id="arrow-amber" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#f59e0b" />
              </marker>
              <marker id="arrow-rose" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#f43f5e" />
              </marker>
              <marker id="arrow-slate" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#94a3b8" />
              </marker>
              <filter id="glow-emerald" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Límite Contexto de Persistencia (EntityManager) -->
            <rect x="250" y="20" width="360" height="300" rx="16" fill="rgba(16, 185, 129, 0.03)" stroke="rgba(16, 185, 129, 0.3)" stroke-width="1.5" stroke-dasharray="6 4" />
            <text x="265" y="42" fill="#10b981" font-size="11" font-weight="bold" letter-spacing="0.5">CONTEXTO DE PERSISTENCIA (L1 Cache / EntityManager)</text>

            <!-- Transición: new() -> TRANSIENT -->
            <path d="M 20 110 L 65 110" stroke="#94a3b8" stroke-width="2" marker-end="url(#arrow-slate)" />
            <text x="36" y="100" fill="#94a3b8" font-size="10" text-anchor="middle">new()</text>

            <!-- Transición: TRANSIENT -> PERSISTENT -->
            <path d="M 165 110 L 320 110" stroke="#06b6d4" stroke-width="2.5" marker-end="url(#arrow-cyan)" id="path-persist" />
            <rect x="200" y="93" width="90" height="18" rx="4" fill="#0f172a" stroke="#06b6d4" stroke-width="0.8" />
            <text x="245" y="106" fill="#38bdf8" font-size="10" font-weight="bold" text-anchor="middle">em.persist()</text>

            <!-- Transición: PERSISTENT -> DETACHED (Curva Superior) -->
            <path d="M 438 82 Q 545 25 652 82" fill="none" stroke="#f59e0b" stroke-width="2" marker-end="url(#arrow-amber)" id="path-detach" />
            <rect x="500" y="32" width="100" height="18" rx="4" fill="#0f172a" stroke="#f59e0b" stroke-width="0.8" />
            <text x="550" y="45" fill="#fbbf24" font-size="9.5" font-weight="bold" text-anchor="middle">detach() / close()</text>

            <!-- Transición: DETACHED -> PERSISTENT (Curva Inferior) -->
            <path d="M 652 138 Q 545 195 438 138" fill="none" stroke="#10b981" stroke-width="2" marker-end="url(#arrow-emerald)" id="path-merge" />
            <rect x="500" y="172" width="90" height="18" rx="4" fill="#0f172a" stroke="#10b981" stroke-width="0.8" />
            <text x="545" y="185" fill="#34d399" font-size="9.5" font-weight="bold" text-anchor="middle">em.merge()</text>

            <!-- Transición: PERSISTENT -> REMOVED (Vertical hacia abajo) -->
            <path d="M 380 162 L 380 208" stroke="#f43f5e" stroke-width="2.5" marker-end="url(#arrow-rose)" id="path-remove" />
            <rect x="330" y="175" width="85" height="18" rx="4" fill="#0f172a" stroke="#f43f5e" stroke-width="0.8" />
            <text x="372" y="188" fill="#fb7185" font-size="9.5" font-weight="bold" text-anchor="middle">em.remove()</text>

            <!-- Bucle Dirty Checking en PERSISTENT (Arriba) -->
            <path d="M 350 64 C 330 25 430 25 410 64" fill="none" stroke="#38bdf8" stroke-width="1.8" stroke-dasharray="3 3" marker-end="url(#arrow-cyan)" id="path-dirty" />
            <text x="380" y="24" fill="#38bdf8" font-size="9" text-anchor="middle">Mutación (Dirty Checking)</text>

            <!-- Transición: REMOVED -> SQL DELETE a BD -->
            <path d="M 432 250 L 670 250" stroke="#f43f5e" stroke-width="1.8" stroke-dasharray="4 3" marker-end="url(#arrow-rose)" id="path-delete-sql" />
            <text x="545" y="242" fill="#fb7185" font-size="9.5" font-weight="bold" text-anchor="middle">flush() ➔ SQL DELETE</text>

            <!-- Icono Base de Datos Externa -->
            <g transform="translate(680, 222)">
              <rect x="0" y="0" width="70" height="56" rx="8" fill="#1e293b" stroke="#64748b" stroke-width="1.5" />
              <path d="M 10 14 C 10 9, 60 9, 60 14 C 60 19, 10 19, 10 14 Z" fill="#334155" stroke="#94a3b8" />
              <path d="M 10 28 C 10 23, 60 23, 60 28" fill="none" stroke="#64748b" stroke-width="1.2" />
              <path d="M 10 42 C 10 37, 60 37, 60 42" fill="none" stroke="#64748b" stroke-width="1.2" />
              <text x="35" y="50" fill="#94a3b8" font-size="9" text-anchor="middle">RDBMS</text>
            </g>

            <!-- NODO 1: TRANSIENT -->
            <g id="node-transient" class="cursor-pointer transition-transform hover:scale-105" transform="translate(115, 110)">
              <circle r="48" fill="#0f172a" stroke="#64748b" stroke-width="2" class="node-circle" />
              <circle r="54" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4 3" class="halo-ring hidden" />
              <text y="-14" fill="#f8fafc" font-size="11" font-weight="bold" text-anchor="middle">TRANSIENT</text>
              <text y="4" fill="#94a3b8" font-size="9" text-anchor="middle">En RAM pura</text>
              <text y="18" fill="#64748b" font-size="8.5" text-anchor="middle">Sin ID ni L1</text>
            </g>

            <!-- NODO 2: PERSISTENT / MANAGED -->
            <g id="node-persistent" class="cursor-pointer transition-transform hover:scale-105" transform="translate(380, 110)">
              <circle r="52" fill="#064e3b" stroke="#10b981" stroke-width="2.5" class="node-circle shadow-lg shadow-emerald-500/20" />
              <circle r="58" fill="none" stroke="#34d399" stroke-width="2.5" stroke-dasharray="5 3" class="halo-ring" />
              <text y="-14" fill="#a7f3d0" font-size="11.5" font-weight="bold" text-anchor="middle">PERSISTENT</text>
              <text y="3" fill="#6ee7b7" font-size="9" font-weight="bold" text-anchor="middle">(Managed)</text>
              <text y="18" fill="#34d399" font-size="8.5" text-anchor="middle">L1 Cache + ID</text>
            </g>

            <!-- NODO 3: DETACHED -->
            <g id="node-detached" class="cursor-pointer transition-transform hover:scale-105" transform="translate(705, 110)">
              <circle r="48" fill="#451a03" stroke="#f59e0b" stroke-width="2" class="node-circle" />
              <circle r="54" fill="none" stroke="#fbbf24" stroke-width="2" stroke-dasharray="4 3" class="halo-ring hidden" />
              <text y="-14" fill="#fde68a" font-size="11" font-weight="bold" text-anchor="middle">DETACHED</text>
              <text y="4" fill="#fcd34d" font-size="9" text-anchor="middle">Tiene ID en BD</text>
              <text y="18" fill="#d97706" font-size="8.5" text-anchor="middle">Sesión cerrada</text>
            </g>

            <!-- NODO 4: REMOVED -->
            <g id="node-removed" class="cursor-pointer transition-transform hover:scale-105" transform="translate(380, 250)">
              <circle r="42" fill="#4c0519" stroke="#f43f5e" stroke-width="2" class="node-circle" />
              <circle r="48" fill="none" stroke="#fb7185" stroke-width="2" stroke-dasharray="4 3" class="halo-ring hidden" />
              <text y="-10" fill="#fecdd3" font-size="11" font-weight="bold" text-anchor="middle">REMOVED</text>
              <text y="6" fill="#fda4af" font-size="8.5" text-anchor="middle">Marcado DELETE</text>
              <text y="18" fill="#e11d48" font-size="8" text-anchor="middle">Pendiente flush</text>
            </g>
          </svg>
        </div>

        <!-- Controles de Simulación de Transiciones -->
        <div class="space-y-2 pt-2 border-t border-border/50">
          <div class="text-[11px] font-mono text-cyan-300 font-bold flex items-center gap-1.5">
            <span>🎮 Simulador de Transiciones JPA en Tiempo Real:</span>
            <span class="text-[10px] text-muted-foreground font-normal">(Haz clic en una transición para emular el ciclo de vida)</span>
          </div>

          <div class="flex flex-wrap gap-2 text-xs font-mono">
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-slate-600 bg-slate-900/60 hover:bg-slate-800 text-slate-200 transition-all cursor-pointer" data-step="new">
              1. new Entidad()
            </button>
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-cyan-500/50 bg-cyan-950/40 hover:bg-cyan-900/60 text-cyan-200 transition-all cursor-pointer" data-step="persist">
              2. em.persist()
            </button>
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-emerald-500/50 bg-emerald-950/40 hover:bg-emerald-900/60 text-emerald-200 transition-all cursor-pointer" data-step="mutate">
              3. Mutar (Dirty Checking)
            </button>
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-amber-500/50 bg-amber-950/40 hover:bg-amber-900/60 text-amber-200 transition-all cursor-pointer" data-step="detach">
              4. em.detach() / close()
            </button>
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-emerald-500/50 bg-emerald-950/40 hover:bg-emerald-900/60 text-emerald-200 transition-all cursor-pointer" data-step="merge">
              5. em.merge()
            </button>
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-rose-500/50 bg-rose-950/40 hover:bg-rose-900/60 text-rose-200 transition-all cursor-pointer" data-step="remove">
              6. em.remove()
            </button>
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-purple-500/50 bg-purple-950/40 hover:bg-purple-900/60 text-purple-200 transition-all cursor-pointer" data-step="flush">
              7. commit() / flush()
            </button>
            <button type="button" class="jpa-action-btn px-2.5 py-1.5 rounded-lg border border-border/80 bg-secondary/40 hover:bg-secondary/70 text-muted-foreground transition-all cursor-pointer ml-auto" data-step="reset">
              ↺ Reiniciar
            </button>
          </div>
        </div>

        <!-- Inspector Dinámico de Estado y L1 Cache -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 p-3.5 rounded-xl bg-card/60 border border-border/70 text-xs font-mono" id="jpa-inspector">
          <div class="space-y-1">
            <span class="text-[10px] text-muted-foreground uppercase tracking-wider">Estado Actual</span>
            <div class="font-bold text-emerald-400 text-sm flex items-center gap-1.5" id="insp-state">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              PERSISTENT
            </div>
            <p class="text-[10px] text-muted-foreground" id="insp-desc">Gestionada activamente por el EntityManager.</p>
          </div>

          <div class="space-y-1">
            <span class="text-[10px] text-muted-foreground uppercase tracking-wider">Caché L1 (EntityManager)</span>
            <div class="font-bold text-cyan-300" id="insp-l1">En Contexto Activo</div>
            <p class="text-[10px] text-muted-foreground" id="insp-l1-desc">Vigilada por el mecanismo de Snapshot.</p>
          </div>

          <div class="space-y-1">
            <span class="text-[10px] text-muted-foreground uppercase tracking-wider">ID Base de Datos</span>
            <div class="font-bold text-amber-300" id="insp-id">id = 101 (Asignado)</div>
            <p class="text-[10px] text-muted-foreground" id="insp-id-desc">Identificador único de clave primaria.</p>
          </div>

          <div class="space-y-1">
            <span class="text-[10px] text-muted-foreground uppercase tracking-wider">Sentencia SQL Encolada</span>
            <div class="font-bold text-rose-300 text-[11px] truncate" id="insp-sql">INSERT INTO usuarios...</div>
            <p class="text-[10px] text-muted-foreground" id="insp-sql-desc">Se enviará a la BD en el próximo flush.</p>
          </div>
        </div>

        <!-- Mensaje Explicativo Didáctico -->
        <div class="p-3 rounded-lg bg-secondary/30 border border-border/50 text-[11px] text-muted-foreground space-y-1" id="jpa-explanation-box">
          <strong class="text-foreground font-mono text-cyan-300">💡 Lección de Arquitectura PDS:</strong>
          <span id="jpa-explanation-text">
            El método <code class="text-cyan-300">em.merge(detachedEntity)</code> no convierte a la instancia recibida en persistente; crea y retorna una <strong>nueva copia</strong> gestionada. Si continúas mutando el objeto original desconectado, tus cambios no se persistirán en la base de datos.
          </span>
        </div>
      </div>
    </div>

    <!-- PANEL 2: SQL vs NoSQL & CAP -->
    <div id="view-sql-nosql" class="jpa-view space-y-5 hidden">
      <div class="p-3.5 rounded-xl border border-blue-500/30 bg-blue-950/15 text-xs text-muted-foreground leading-relaxed">
        <strong class="text-blue-300">Paradigma Relacional (ACID) frente a NoSQL (BASE & CAP):</strong> Mientras las bases de datos SQL sacrifican escalabilidad horizontal para garantizar consistencia matemática inmediata, NoSQL abraza la consistencia eventual y particionado masivo en clúster.
      </div>

      <!-- Tabla Comparativa Canónica PDS -->
      <div class="overflow-x-auto rounded-xl border border-border/80">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-secondary/50 text-foreground border-b border-border/60">
            <tr>
              <th class="p-3 font-semibold">Criterio</th>
              <th class="p-3 font-semibold text-cyan-300">Relacionales (SQL)</th>
              <th class="p-3 font-semibold text-purple-300">No Relacionales (NoSQL)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/40 bg-card/40 text-[11px]">
            <tr class="hover:bg-secondary/20 transition-colors">
              <td class="p-3 font-bold text-foreground">Modelo de Datos</td>
              <td class="p-3 text-muted-foreground">Tablas normalizadas con filas y columnas estandarizadas. <em>Schema-on-write</em> estricto.</td>
              <td class="p-3 text-muted-foreground">Documentos, Clave-Valor, Columnas, Grafos, Vectores. <em>Schema-on-read</em> dinámico.</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <td class="p-3 font-bold text-foreground">Transacciones</td>
              <td class="p-3 text-emerald-400"><strong>ACID</strong> (Atomicidad, Consistencia, Aislamiento, Durabilidad) estricto y bloqueante.</td>
              <td class="p-3 text-amber-400"><strong>BASE</strong> (Basically Available, Soft-state, Eventual consistency).</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <td class="p-3 font-bold text-foreground">Relaciones & JOINs</td>
              <td class="p-3 text-muted-foreground">Nativas y optimizadas mediante FKs (`INNER JOIN`, `LEFT JOIN`).</td>
              <td class="p-3 text-muted-foreground">JOINs inexistentes o costosos; se prefiere <strong>desnormalización</strong> e incrustación.</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <td class="p-3 font-bold text-foreground">Escalabilidad</td>
              <td class="p-3 text-muted-foreground">Principalmente <strong>Vertical</strong> (Scale-Up: más CPU/RAM). Sharding complejo.</td>
              <td class="p-3 text-purple-300">Diseñado para <strong>Horizontal</strong> nativo (Scale-Out: clúster de cientos de nodos).</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <td class="p-3 font-bold text-foreground">Teorema CAP</td>
              <td class="p-3 text-cyan-300">Consistencia + Disponibilidad (CA) local, o CP con replicación síncrona.</td>
              <td class="p-3 text-indigo-300">Mayoría son <strong>AP</strong> (Alta Disponibilidad ante Partición) o <strong>CP</strong> parametrizable.</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <td class="p-3 font-bold text-foreground">Motores Líderes</td>
              <td class="p-3 text-foreground font-mono">PostgreSQL, MySQL, SQLite, Oracle</td>
              <td class="p-3 text-foreground font-mono">MongoDB, Redis, Cassandra, Neo4j, Qdrant</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Las 5 Familias NoSQL -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 text-xs">
        <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1">
          <div class="font-bold text-foreground">1. Documental</div>
          <div class="text-[10px] font-mono text-purple-300">MongoDB / CouchDB</div>
          <p class="text-[11px] text-muted-foreground mt-1">JSON/BSON semiestructurado. Ideal para catálogos y e-commerce.</p>
        </div>
        <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1">
          <div class="font-bold text-foreground">2. Clave-Valor</div>
          <div class="text-[10px] font-mono text-cyan-300">Redis / DynamoDB</div>
          <p class="text-[11px] text-muted-foreground mt-1">Acceso en $O(1)$. Caché en RAM, sesiones de usuario y rate limits.</p>
        </div>
        <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1">
          <div class="font-bold text-foreground">3. Columnar Ancha</div>
          <div class="text-[10px] font-mono text-amber-300">Cassandra / ScyllaDB</div>
          <p class="text-[11px] text-muted-foreground mt-1">Series temporales y analítica con escrituras masivas en streaming.</p>
        </div>
        <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1">
          <div class="font-bold text-foreground">4. Grafos</div>
          <div class="text-[10px] font-mono text-emerald-300">Neo4j / Amazon Neptune</div>
          <p class="text-[11px] text-muted-foreground mt-1">Nodos y aristas para traversals ultra rápidos en fraude y redes sociales.</p>
        </div>
        <div class="p-3 rounded-xl border border-border/70 bg-card/60 space-y-1">
          <div class="font-bold text-foreground">5. Vectorial (IA)</div>
          <div class="text-[10px] font-mono text-rose-300">Qdrant / Milvus / Pinecone</div>
          <p class="text-[11px] text-muted-foreground mt-1">Embeddings e índices HNSW para búsqueda semántica y pipelines RAG.</p>
        </div>
      </div>
    </div>

    <!-- PANEL 3: HERENCIA ORM & N+1 -->
    <div id="view-inheritance" class="jpa-view space-y-5 hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <!-- Estrategias de Herencia en JPA -->
        <div class="p-4 rounded-xl border border-border/70 bg-card/60 space-y-3">
          <h4 class="font-bold text-sm text-foreground flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
            Estrategias de Herencia en ORM (@Inheritance)
          </h4>
          <div class="space-y-2 text-[11px] text-muted-foreground">
            <div class="p-2.5 rounded-lg bg-black/40 border border-border/40">
              <strong class="text-cyan-300 font-mono">1. SINGLE_TABLE (Tabla Única):</strong>
              <p class="mt-0.5">Una sola tabla con columna discriminadora (`DTYPE`). Rápida en consultas pero llena de valores `NULL` para campos específicos de subclases.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-black/40 border border-border/40">
              <strong class="text-emerald-300 font-mono">2. JOINED (Tabla de Unión):</strong>
              <p class="mt-0.5">Tabla base con campos comunes y tablas derivadas vinculadas por FK. Normalizado y limpio, pero exige `JOIN` obligatorio para instanciar cualquier subclase.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-black/40 border border-border/40">
              <strong class="text-purple-300 font-mono">3. TABLE_PER_CLASS (Tabla por Clase):</strong>
              <p class="mt-0.5">Cada clase concreta tiene su tabla independiente con todos los campos duplicados. Consultas polimórficas requieren costosos `UNION` en SQL.</p>
            </div>
          </div>
        </div>

        <!-- El Bug N+1 y su Solución -->
        <div class="p-4 rounded-xl border border-border/70 bg-card/60 space-y-3">
          <h4 class="font-bold text-sm text-foreground flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
            El Peligro del Bug N+1 y Lazy Loading
          </h4>
          <div class="p-2.5 rounded-lg bg-red-950/20 border border-red-500/30 text-[11px] font-mono text-red-200 space-y-1">
            <div class="text-red-400 font-bold">// 1 Consulta para N usuarios:</div>
            <div>List&lt;User&gt; users = em.createQuery("FROM User").getResultList();</div>
            <div class="text-red-400 font-bold mt-1">// +N Consultas por Lazy Loading dentro del bucle!</div>
            <div>for (User u : users) &#123; u.getOrders().size(); &#125;</div>
          </div>
          <p class="text-[11px] text-muted-foreground leading-relaxed">
            Si hay 500 usuarios, se ejecutan <strong class="text-foreground">501 viajes de red independientes</strong> a la base de datos, destruyendo el throughput del backend.
          </p>
          <div class="p-2.5 rounded-lg bg-emerald-950/20 border border-emerald-500/30 text-[11px] font-mono text-emerald-200">
            <span class="text-emerald-400 font-bold">Solución Canónica: JOIN FETCH</span><br/>
            <code>SELECT u FROM User u JOIN FETCH u.orders</code>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function initJpaTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.jpa-tab-btn');
    const views = document.querySelectorAll<HTMLElement>('.jpa-view');

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const targetView = tab.getAttribute('data-view');
        if (!targetView) return;

        // Reset tabs
        tabs.forEach(t => {
          t.classList.remove(
            'active-jpa',
            'font-bold',
            'text-white',
            'bg-cyan-600',
            'border-cyan-400',
            'shadow-md',
            'shadow-cyan-500/30'
          );
          t.classList.add('text-muted-foreground', 'border-transparent', 'font-medium');
        });

        // Activar tab
        tab.classList.add(
          'active-jpa',
          'font-bold',
          'text-white',
          'bg-cyan-600',
          'border-cyan-400',
          'shadow-md',
          'shadow-cyan-500/30'
        );
        tab.classList.remove('text-muted-foreground', 'border-transparent', 'font-medium');

        // Alternar vistas
        views.forEach(v => {
          if (v.id === `view-${targetView}`) {
            v.classList.remove('hidden');
          } else {
            v.classList.add('hidden');
          }
        });
      });
    });
  }

  initJpaTabs();
  document.addEventListener('astro:page-load', initJpaTabs);

  // FSM Interactivo JPA
  function initJpaFsm() {
    const container = document.getElementById('jpa-fsm-container');
    if (!container) return;

    type JpaState = 'transient' | 'persistent' | 'detached' | 'removed';

    let currentState: JpaState = 'persistent';
    let isDirty = false;

    const inspState = container.querySelector('#insp-state');
    const inspDesc = container.querySelector('#insp-desc');
    const inspL1 = container.querySelector('#insp-l1');
    const inspL1Desc = container.querySelector('#insp-l1-desc');
    const inspId = container.querySelector('#insp-id');
    const inspIdDesc = container.querySelector('#insp-id-desc');
    const inspSql = container.querySelector('#insp-sql');
    const inspSqlDesc = container.querySelector('#insp-sql-desc');
    const explanationText = container.querySelector('#jpa-explanation-text');

    const nodes = {
      transient: container.querySelector('#node-transient'),
      persistent: container.querySelector('#node-persistent'),
      detached: container.querySelector('#node-detached'),
      removed: container.querySelector('#node-removed'),
    };

    function updateView(state: JpaState, lastAction: string, dirty = false) {
      currentState = state;
      isDirty = dirty;

      // Actualizar nodos SVG y halos
      Object.entries(nodes).forEach(([s, node]) => {
        if (!node) return;
        const halo = node.querySelector('.halo-ring');
        if (s === state) {
          halo?.classList.remove('hidden');
        } else {
          halo?.classList.add('hidden');
        }
      });

      // Configurar datos según estado y acción
      if (state === 'transient') {
        if (inspState) inspState.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-400"></span> TRANSIENT';
        if (inspDesc) inspDesc.textContent = 'Instanciada con new(), solo en RAM pura de la JVM.';
        if (inspL1) { inspL1.textContent = 'Fuera de Contexto'; inspL1.className = 'font-bold text-slate-400'; }
        if (inspL1Desc) inspL1Desc.textContent = 'El EntityManager desconoce totalmente su existencia.';
        if (inspId) { inspId.textContent = 'id = null'; inspId.className = 'font-bold text-slate-400'; }
        if (inspIdDesc) inspIdDesc.textContent = 'Sin clave primaria de base de datos.';
        if (inspSql) { inspSql.textContent = 'Ninguno'; inspSql.className = 'font-bold text-slate-400'; }
        if (inspSqlDesc) inspSqlDesc.textContent = 'No hay sentencias planificadas ni conexión a BD.';
        if (explanationText) {
          explanationText.innerHTML = 'Has creado <code class="text-foreground">Usuario u = new Usuario("Ada")</code>. El objeto vive en el Heap de Java. Si la ejecución termina o se pierde la referencia, el Garbage Collector lo borrará. La BD no sabe nada de él.';
        }
      } else if (state === 'persistent') {
        const stateColor = isDirty ? 'text-amber-400' : 'text-emerald-400';
        const pingColor = isDirty ? 'bg-amber-400' : 'bg-emerald-400';
        if (inspState) inspState.innerHTML = `<span class="w-2 h-2 rounded-full ${pingColor} animate-ping"></span> PERSISTENT ${isDirty ? '(MUTADA / SUCIA)' : '(GESTIONADA)'}`;
        if (inspDesc) inspDesc.textContent = isDirty ? 'Atributos modificados en memoria: Dirty Checking activo.' : 'Gestionada activamente por el EntityManager en L1.';
        if (inspL1) { inspL1.textContent = 'En Contexto Activo (L1)'; inspL1.className = 'font-bold text-emerald-400'; }
        if (inspL1Desc) inspL1Desc.textContent = 'Snapshot guardado para auditar cambios automáticamente.';
        if (inspId) { inspId.textContent = 'id = 101 (Asignado)'; inspId.className = 'font-bold text-cyan-300'; }
        if (inspIdDesc) inspIdDesc.textContent = 'Identificador asignado mediante Sequence / Identity.';
        
        if (isDirty) {
          if (inspSql) { inspSql.textContent = 'UPDATE usuarios SET nombre="Grace" WHERE id=101;'; inspSql.className = 'font-bold text-amber-300'; }
          if (inspSqlDesc) inspSqlDesc.textContent = 'Detectado por Dirty Checking. Encolado para el próximo flush.';
          if (explanationText) {
            explanationText.innerHTML = '<strong>¡Dirty Checking en acción!</strong> Has mutado <code class="text-foreground">u.setNombre("Grace")</code>. No hace falta llamar a ningún save(). En el commit/flush, JPA compara la entidad con su instantánea original y genera un <code class="text-amber-300">UPDATE</code> automáticamente.';
          }
        } else if (lastAction === 'persist') {
          if (inspSql) { inspSql.textContent = 'INSERT INTO usuarios (id, nombre) VALUES (101, "Ada");'; inspSql.className = 'font-bold text-cyan-300'; }
          if (inspSqlDesc) inspSqlDesc.textContent = 'Encolado en la cola Write-Behind del contexto transaccional.';
          if (explanationText) {
            explanationText.innerHTML = '<code class="text-cyan-300">em.persist(u)</code> adjunta la entidad al Contexto de Persistencia. Se le asigna un ID formal y se planifica su inserción. JPA optimiza agrupando operaciones en lote antes de golpear la red.';
          }
        } else if (lastAction === 'merge') {
          if (inspSql) { inspSql.textContent = 'UPDATE usuarios SET nombre="Ada Lovelace" WHERE id=101;'; inspSql.className = 'font-bold text-emerald-300'; }
          if (inspSqlDesc) inspSqlDesc.textContent = 'Copia gestionada actualizada con los datos del objeto desconectado.';
          if (explanationText) {
            explanationText.innerHTML = '<strong>Atención con em.merge():</strong> Crea o recupera una copia gestionada y copia los valores del objeto disconnected. <strong class="text-cyan-300">Debes utilizar la instancia retornada:</strong> <code class="text-foreground">u = em.merge(u);</code>.';
          }
        } else {
          if (inspSql) { inspSql.textContent = 'Limpio / Sincronizado'; inspSql.className = 'font-bold text-emerald-400'; }
          if (inspSqlDesc) inspSqlDesc.textContent = 'La caché L1 coincide exactamente con la base de datos.';
          if (explanationText) {
            explanationText.innerHTML = 'La entidad está completamente sincronizada. Las lecturas posteriores por ID se resolverán directamente en memoria caché L1 sin emitir consultas SQL a la red.';
          }
        }
      } else if (state === 'detached') {
        if (inspState) inspState.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span> DETACHED (DESCONECTADA)';
        if (inspDesc) inspDesc.textContent = 'Tiene ID pero la sesión o contexto de persistencia se ha cerrado.';
        if (inspL1) { inspL1.textContent = 'Desconectada de L1'; inspL1.className = 'font-bold text-amber-400'; }
        if (inspL1Desc) inspL1Desc.textContent = 'em.detach() o em.close() han liberado el contexto.';
        if (inspId) { inspId.textContent = 'id = 101 (Preservado)'; inspId.className = 'font-bold text-amber-300'; }
        if (inspIdDesc) inspIdDesc.textContent = 'Mantiene el identificador que tenía en BD.';
        if (inspSql) { inspSql.textContent = 'Ninguno (Mutaciones ignoradas)'; inspSql.className = 'font-bold text-slate-400'; }
        if (inspSqlDesc) inspSqlDesc.textContent = 'Cualquier setter llamado aquí NO se reflejará en BD.';
        if (explanationText) {
          explanationText.innerHTML = 'Al llamar a <code class="text-amber-300">em.detach(u)</code> o cerrarse la transacción HTTP, la entidad queda "huérfana". Si modificas sus datos y termina el proceso, <strong class="text-amber-300">los cambios se perderán</strong> salvo que hagas <code class="text-emerald-300">em.merge(u)</code> en una nueva sesión.';
        }
      } else if (state === 'removed') {
        if (inspState) inspState.innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span> REMOVED (MARCADA BORRADO)';
        if (inspDesc) inspDesc.textContent = 'Marcada para eliminación física en la base de datos.';
        if (inspL1) { inspL1.textContent = 'Marcada en L1'; inspL1.className = 'font-bold text-rose-400'; }
        if (inspL1Desc) inspL1Desc.textContent = 'Permanecerá en memoria hasta el flush/commit.';
        if (inspId) { inspId.textContent = 'id = 101'; inspId.className = 'font-bold text-rose-300'; }
        if (inspIdDesc) inspIdDesc.textContent = 'Clave a eliminar con WHERE id = 101.';
        if (inspSql) { inspSql.textContent = 'DELETE FROM usuarios WHERE id = 101;'; inspSql.className = 'font-bold text-rose-400 font-bold'; }
        if (inspSqlDesc) inspSqlDesc.textContent = 'Programada para ejecución física en base de datos.';
        if (explanationText) {
          explanationText.innerHTML = '<code class="text-rose-400">em.remove(u)</code> no borra el objeto de la RAM al instante. Programa el envío de una sentencia SQL DELETE durante el próximo flush transaccional.';
        }
      }
    }

    // Botones de acción
    const buttons = container.querySelectorAll<HTMLButtonElement>('.jpa-action-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const step = btn.getAttribute('data-step');
        if (!step) return;

        switch (step) {
          case 'new':
            updateView('transient', 'new', false);
            break;
          case 'persist':
            updateView('persistent', 'persist', false);
            break;
          case 'mutate':
            updateView('persistent', 'mutate', true);
            break;
          case 'detach':
            updateView('detached', 'detach', false);
            break;
          case 'merge':
            updateView('persistent', 'merge', false);
            break;
          case 'remove':
            updateView('removed', 'remove', false);
            break;
          case 'flush':
            if (currentState === 'removed') {
              if (inspSql) inspSql.textContent = 'SQL DELETE EJECUTADO EN BD ✓';
              if (inspSqlDesc) inspSqlDesc.textContent = 'Fila eliminada físicamente de la tabla usuarios.';
              if (explanationText) {
                explanationText.innerHTML = '<strong>Transacción confirmada (COMMIT / FLUSH):</strong> La sentencia SQL DELETE ha sido despachada a la base de datos con éxito.';
              }
            } else if (currentState === 'persistent') {
              updateView('persistent', 'flush', false);
              if (inspSql) inspSql.textContent = 'SQL EJECUTADO Y TRANSACCIÓN COMMIT ✓';
              if (inspSqlDesc) inspSqlDesc.textContent = 'Caché sincronizada y limpia al 100%.';
            }
            break;
          case 'reset':
            updateView('persistent', 'init', false);
            break;
        }
      });
    });

    // Clic directo en nodos SVG
    nodes.transient?.addEventListener('click', () => updateView('transient', 'new', false));
    nodes.persistent?.addEventListener('click', () => updateView('persistent', 'persist', false));
    nodes.detached?.addEventListener('click', () => updateView('detached', 'detach', false));
    nodes.removed?.addEventListener('click', () => updateView('removed', 'remove', false));
  }

  initJpaFsm();
  document.addEventListener('astro:page-load', initJpaFsm);
</script>
