<script>
  function initProtocolStackExplorer() {
    const root = document.getElementById('encapsulation-root');
    if (!root) return;

    // 1. Tab switching (Dissector vs OSI)
    const btnDissector = root.querySelector('#btn-tab-dissector');
    const btnOsi = root.querySelector('#btn-tab-osi');
    const viewDissector = root.querySelector('#view-dissector');
    const viewOsi = root.querySelector('#view-osi');

    function switchTab(view: 'dissector' | 'osi') {
      if (view === 'dissector') {
        viewDissector?.classList.remove('hidden');
        viewOsi?.classList.add('hidden');
        btnDissector?.classList.add('active-tab', 'text-white', 'bg-indigo-600', 'border-indigo-400', 'shadow-md', 'shadow-indigo-500/25');
        btnDissector?.classList.remove('text-dim', 'border-transparent');
        btnOsi?.classList.remove('active-tab', 'text-white', 'bg-indigo-600', 'border-indigo-400', 'shadow-md', 'shadow-indigo-500/25');
        btnOsi?.classList.add('text-dim', 'border-transparent');
      } else {
        viewDissector?.classList.add('hidden');
        viewOsi?.classList.remove('hidden');
        btnOsi?.classList.add('active-tab', 'text-white', 'bg-indigo-600', 'border-indigo-400', 'shadow-md', 'shadow-indigo-500/25');
        btnOsi?.classList.remove('text-dim', 'border-transparent');
        btnDissector?.classList.remove('active-tab', 'text-white', 'bg-indigo-600', 'border-indigo-400', 'shadow-md', 'shadow-indigo-500/25');
        btnDissector?.classList.add('text-dim', 'border-transparent');
      }
    }

    btnDissector?.addEventListener('click', () => switchTab('dissector'));
    btnOsi?.addEventListener('click', () => switchTab('osi'));

    // 2. Packet Block Selection & Detail Inspection in SVG
    const blocks = root.querySelectorAll<SVGGElement>('.packet-block');
    const details = root.querySelectorAll<HTMLElement>('.layer-detail');

    function selectLayer(layerId: string) {
      blocks.forEach((b) => {
        const rect = b.querySelector('rect');
        if (b.getAttribute('data-layer') === layerId) {
          b.setAttribute('filter', 'url(#glow-selected)');
          if (rect) rect.setAttribute('stroke-width', '2.8');
        } else {
          b.removeAttribute('filter');
          if (rect) rect.setAttribute('stroke-width', '1.8');
        }
      });

      details.forEach((d) => {
        if (d.id === `detail-${layerId}`) {
          d.classList.remove('hidden');
        } else {
          d.classList.add('hidden');
        }
      });
    }

    blocks.forEach((block) => {
      block.addEventListener('click', () => {
        const layer = block.getAttribute('data-layer');
        if (layer) selectLayer(layer);
      });
    });

    // Default select Ethernet
    selectLayer('eth');

    // 3. Flow Direction (Encapsulation vs Decapsulation)
    const btnEncap = root.querySelector('#btn-flow-encap');
    const btnDecap = root.querySelector('#btn-flow-decap');
    const flowHint = root.querySelector('#flow-hint');

    btnEncap?.addEventListener('click', () => {
      btnEncap.classList.add('active-flow', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
      btnEncap.classList.remove('text-dim', 'border-transparent');
      btnDecap?.classList.remove('active-flow', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
      btnDecap?.classList.add('text-dim', 'border-transparent');
      if (flowHint) {
        flowHint.textContent = 'El JSON desciende: cada capa añade su sobre sin mirar el interior.';
      }
    });

    btnDecap?.addEventListener('click', () => {
      btnDecap.classList.add('active-flow', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
      btnDecap.classList.remove('text-dim', 'border-transparent');
      btnEncap?.classList.remove('active-flow', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
      btnEncap?.classList.add('text-dim', 'border-transparent');
      if (flowHint) {
        flowHint.textContent = 'El paquete sube: el receptor retira y valida cada cabecera en orden inverso.';
      }
    });
  }

  initProtocolStackExplorer();
  document.addEventListener('astro:page-load', initProtocolStackExplorer);
</script>

<style>
  .packet-block:hover rect {
    filter: brightness(1.2);
  }
</style>
