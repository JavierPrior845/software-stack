---
// Encapsulation.astro
// Interactive SVG-driven Protocol Stack & Packet Dissector for Layer 3 (Redes y Seguridad)
// Combines an authentic on-the-wire SVG Frame layout with interactive byte-field dissection,
// Encapsulation/Decapsulation flow, and a visual OSI (7) vs TCP/IP (4) SVG mapping.
---

<div class="protocol-stack-explorer select-none my-4 space-y-4 font-mono text-xs" id="encapsulation-root">
  <!-- Top Navigation & View Controls -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line/60 pb-3">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-lg bg-indigo-500/20 border border-indigo-500/40 text-indigo-400 flex items-center justify-center font-bold text-sm shadow-sm">
        📡
      </div>
      <div>
        <h4 class="font-bold text-sm text-ink flex items-center gap-2">
          Anatomía de la Trama y Pila de Protocolos
          <span class="text-[10px] px-2 py-0.5 rounded bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">
            MTU: 1500 B
          </span>
        </h4>
        <p class="text-[11px] text-dim font-sans">
          Estructura de bytes en el cable, encapsulación PDU y correspondencia OSI vs TCP/IP
        </p>
      </div>
    </div>

    <!-- Mode Buttons -->
    <div class="flex items-center gap-1.5 p-1 bg-surface-2 rounded-xl border border-line/70">
      <button
        type="button"
        id="btn-tab-dissector"
        class="tab-btn active-tab px-3 py-1.5 rounded-lg font-bold text-white bg-indigo-600 border border-indigo-400 shadow-md shadow-indigo-500/25 transition-all text-xs cursor-pointer flex items-center gap-1.5"
        data-target="view-dissector"
      >
        <span>📦 Trama en el Cable (SVG)</span>
      </button>
      <button
        type="button"
        id="btn-tab-osi"
        class="tab-btn px-3 py-1.5 rounded-lg font-medium text-dim hover:text-ink hover:bg-surface-3 border border-transparent transition-all text-xs cursor-pointer flex items-center gap-1.5"
        data-target="view-osi"
      >
        <span>🗺️ OSI (7) vs TCP/IP (4)</span>
      </button>
    </div>
  </div>

  <!-- VIEW 1: TRAMA EN EL CABLE Y DISECCIONADOR DE CABECERAS (SVG) -->
  <div id="view-dissector" class="space-y-4">
    <!-- Flow Direction Control -->
    <div class="flex flex-wrap items-center justify-between gap-2 p-2.5 rounded-xl bg-surface-1 border border-line/70">
      <div class="flex items-center gap-2 text-[11px]">
        <span class="text-dim">Dirección del Flujo:</span>
        <button
          type="button"
          id="btn-flow-encap"
          class="flow-btn active-flow px-2.5 py-1 rounded-md text-[11px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 transition-all cursor-pointer flex items-center gap-1"
          data-flow="encap"
        >
          <span>⬇️ Emisor (Encapsulación)</span>
        </button>
        <button
          type="button"
          id="btn-flow-decap"
          class="flow-btn px-2.5 py-1 rounded-md text-[11px] font-medium text-dim hover:text-ink hover:bg-surface-2 border border-transparent transition-all cursor-pointer flex items-center gap-1"
          data-flow="decap"
        >
          <span>⬆️ Receptor (Desencapsulación)</span>
        </button>
      </div>

      <div class="text-[11px] text-dim flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="flow-hint" class="font-sans">El JSON desciende: cada capa añade su sobre sin mirar el interior.</span>
      </div>
    </div>

    <!-- MAIN SVG PACKET ON THE WIRE -->
    <div class="rounded-2xl border border-line/80 bg-surface-1/80 p-4 shadow-xl backdrop-blur-md">
      <div class="flex items-center justify-between text-[11px] text-dim mb-2 font-mono">
        <span class="flex items-center gap-1.5">
          <span class="text-indigo-400 font-bold">BITSTREAM</span> ──▶ Señal eléctrica / óptica en el medio físico
        </span>
        <span class="text-amber-400/90 font-medium">Tamaño Total: 1518 Bytes (Trama Ethernet Max)</span>
      </div>

      <!-- Interactive SVG Packet Layout -->
      <div class="w-full overflow-x-auto py-2">
        <svg viewBox="0 0 900 120" class="w-full min-w-[700px] h-auto font-mono select-none" id="packet-svg">
          <defs>
            <linearGradient id="grad-eth" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0.2" />
            </linearGradient>
            <linearGradient id="grad-ip" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#0e7490" stop-opacity="0.2" />
            </linearGradient>
            <linearGradient id="grad-tcp" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#6d28d9" stop-opacity="0.2" />
            </linearGradient>
            <linearGradient id="grad-payload" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#047857" stop-opacity="0.2" />
            </linearGradient>
            <linearGradient id="grad-fcs" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#b45309" stop-opacity="0.2" />
            </linearGradient>

            <filter id="glow-selected" x="-10%" y="-10%" width="120%" height="120%">
              <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#6366f1" flood-opacity="0.6" />
            </filter>
          </defs>

          <!-- Background container -->
          <rect x="5" y="15" width="890" height="90" rx="10" fill="#090d16" stroke="#252d3d" stroke-width="1.5" />

          <!-- 1. Ethernet Header (14 Bytes) -->
          <g class="packet-block cursor-pointer transition-all duration-200" data-layer="eth" id="svg-block-eth">
            <rect x="15" y="25" width="130" height="70" rx="6" fill="url(#grad-eth)" stroke="#3b82f6" stroke-width="1.8" />
            <text x="80" y="52" fill="#93c5fd" font-size="12" font-weight="bold" text-anchor="middle">Ethernet II</text>
            <text x="80" y="70" fill="#bfdbfe" font-size="10" text-anchor="middle">Cabecera (14 B)</text>
            <text x="80" y="85" fill="#60a5fa" font-size="9" opacity="0.8" text-anchor="middle">MACs + EtherType</text>
          </g>

          <!-- Bracket connection -->
          <path d="M 148 60 L 158 60" stroke="#475569" stroke-width="2" stroke-dasharray="2 2" />

          <!-- 2. IPv4 Header (20 Bytes) -->
          <g class="packet-block cursor-pointer transition-all duration-200" data-layer="ip" id="svg-block-ip">
            <rect x="160" y="25" width="145" height="70" rx="6" fill="url(#grad-ip)" stroke="#06b6d4" stroke-width="1.8" />
            <text x="232" y="52" fill="#67e8f9" font-size="12" font-weight="bold" text-anchor="middle">IPv4 Header</text>
            <text x="232" y="70" fill="#a5f3fc" font-size="10" text-anchor="middle">Red (20 Bytes)</text>
            <text x="232" y="85" fill="#22d3ee" font-size="9" opacity="0.8" text-anchor="middle">IP Origen / Destino</text>
          </g>

          <!-- Bracket connection -->
          <path d="M 308 60 L 318 60" stroke="#475569" stroke-width="2" stroke-dasharray="2 2" />

          <!-- 3. TCP Header (20 Bytes) -->
          <g class="packet-block cursor-pointer transition-all duration-200" data-layer="tcp" id="svg-block-tcp">
            <rect x="320" y="25" width="150" height="70" rx="6" fill="url(#grad-tcp)" stroke="#8b5cf6" stroke-width="1.8" />
            <text x="395" y="52" fill="#c4b5fd" font-size="12" font-weight="bold" text-anchor="middle">TCP Segment</text>
            <text x="395" y="70" fill="#ddd6fe" font-size="10" text-anchor="middle">Transporte (20 B)</text>
            <text x="395" y="85" fill="#a78bfa" font-size="9" opacity="0.8" text-anchor="middle">Puertos + Seq / Ack</text>
          </g>

          <!-- Bracket connection -->
          <path d="M 473 60 L 483 60" stroke="#475569" stroke-width="2" stroke-dasharray="2 2" />

          <!-- 4. Application Payload (HTTP / JSON) -->
          <g class="packet-block cursor-pointer transition-all duration-200" data-layer="payload" id="svg-block-payload">
            <rect x="485" y="25" width="310" height="70" rx="6" fill="url(#grad-payload)" stroke="#10b981" stroke-width="1.8" />
            <text x="640" y="50" fill="#6ee7b7" font-size="12" font-weight="bold" text-anchor="middle">Payload de Aplicación (HTTP Data)</text>
            <text x="640" y="68" fill="#a7f3d0" font-size="10" text-anchor="middle">{'{ "usuario": "ada", "accion": "checkout" }'}</text>
            <text x="640" y="85" fill="#34d399" font-size="9" opacity="0.8" text-anchor="middle">Datos de Usuario Útiles (~1460 Bytes)</text>
          </g>

          <!-- Bracket connection -->
          <path d="M 798 60 L 808 60" stroke="#475569" stroke-width="2" stroke-dasharray="2 2" />

          <!-- 5. Ethernet FCS / Trailer (4 Bytes) -->
          <g class="packet-block cursor-pointer transition-all duration-200" data-layer="fcs" id="svg-block-fcs">
            <rect x="810" y="25" width="75" height="70" rx="6" fill="url(#grad-fcs)" stroke="#f59e0b" stroke-width="1.8" />
            <text x="847" y="52" fill="#fde68a" font-size="11" font-weight="bold" text-anchor="middle">FCS</text>
            <text x="847" y="70" fill="#fef3c7" font-size="10" text-anchor="middle">(4 B)</text>
            <text x="847" y="85" fill="#fbbf24" font-size="8.5" opacity="0.8" text-anchor="middle">CRC32</text>
          </g>
        </svg>
      </div>

      <div class="mt-2 flex items-center justify-between text-[10px] text-dim px-2">
        <span>💡 Haz clic en cualquier cabecera del SVG para inspeccionar sus campos de bits reales</span>
        <span class="font-mono text-cyan-400">Overhead de cabeceras: 54 Bytes mínimos</span>
      </div>
    </div>

    <!-- DETAIL PANEL: CABECERA SELECCIONADA -->
    <div id="layer-detail-container" class="rounded-xl border border-line bg-surface-2 p-4 transition-all">
      <!-- Ethernet Detail -->
      <div id="detail-eth" class="layer-detail space-y-3">
        <div class="flex items-center justify-between border-b border-line/60 pb-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-blue-500"></span>
            <span class="font-bold text-sm text-blue-300">Capa 2 (Enlace de Datos): Cabecera Ethernet II (14 Bytes)</span>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30">PDU: Trama (Frame)</span>
        </div>
        <p class="text-dim text-xs leading-relaxed font-sans">
          Opera exclusivamente en el ámbito local (mismo switch o segmento Wi-Fi). Identifica las tarjetas físicas mediante direcciones MAC de 48 bits (6 bytes).
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-[11px]">
          <div class="p-2.5 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">MAC Destino (6 Bytes)</span>
            <span class="text-ink font-bold font-mono">00:1A:2B:3C:4D:5E</span>
            <span class="text-dim block text-[9px] mt-0.5">Switch local o Gateway</span>
          </div>
          <div class="p-2.5 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">MAC Origen (6 Bytes)</span>
            <span class="text-ink font-bold font-mono">B4:2E:99:A1:C8:42</span>
            <span class="text-dim block text-[9px] mt-0.5">Tu tarjeta de red física</span>
          </div>
          <div class="p-2.5 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">EtherType (2 Bytes)</span>
            <span class="text-blue-400 font-bold font-mono">0x0800 (IPv4)</span>
            <span class="text-dim block text-[9px] mt-0.5">Indica qué protocolo encapsula</span>
          </div>
        </div>
      </div>

      <!-- IPv4 Detail (Default Hidden) -->
      <div id="detail-ip" class="layer-detail space-y-3 hidden">
        <div class="flex items-center justify-between border-b border-line/60 pb-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-cyan-500"></span>
            <span class="font-bold text-sm text-cyan-300">Capa 3 (Red / Internet): Cabecera IPv4 (20 Bytes sin opciones)</span>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">PDU: Paquete (Packet)</span>
        </div>
        <p class="text-dim text-xs leading-relaxed font-sans">
          Proporciona direccionamiento lógico global y enrutamiento salto a salto (hop-by-hop) a través de routers intermedios sin conexión previa.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px]">
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">TTL (Time-to-Live)</span>
            <span class="text-cyan-300 font-bold font-mono">64</span>
            <span class="text-dim block text-[9px]">Decrementa en cada router</span>
          </div>
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">Protocolo Superior</span>
            <span class="text-cyan-300 font-bold font-mono">6 (TCP) / 17 (UDP)</span>
            <span class="text-dim block text-[9px]">Demux a capa 4</span>
          </div>
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">IP Origen (32 bits)</span>
            <span class="text-ink font-bold font-mono">192.168.1.15</span>
            <span class="text-dim block text-[9px]">Tu IP en red local</span>
          </div>
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">IP Destino (32 bits)</span>
            <span class="text-ink font-bold font-mono">142.250.200.14</span>
            <span class="text-dim block text-[9px]">Servidor en Internet</span>
          </div>
        </div>
      </div>

      <!-- TCP Detail (Default Hidden) -->
      <div id="detail-tcp" class="layer-detail space-y-3 hidden">
        <div class="flex items-center justify-between border-b border-line/60 pb-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-purple-500"></span>
            <span class="font-bold text-sm text-purple-300">Capa 4 (Transporte): Cabecera TCP (20 Bytes)</span>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">PDU: Segmento (Segment)</span>
        </div>
        <p class="text-dim text-xs leading-relaxed font-sans">
          Conecta procesos específicos dentro de las máquinas. Garantiza entrega fiable, ordenada, sin duplicados y con control de flujo y congestión.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px]">
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">Puerto Origen</span>
            <span class="text-purple-300 font-bold font-mono">54320 (Efímero)</span>
            <span class="text-dim block text-[9px]">Asignado por el SO</span>
          </div>
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">Puerto Destino</span>
            <span class="text-purple-300 font-bold font-mono">443 (HTTPS)</span>
            <span class="text-dim block text-[9px]">Servicio estándar</span>
          </div>
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">Flags de Control</span>
            <span class="text-emerald-300 font-bold font-mono">ACK, PSH</span>
            <span class="text-dim block text-[9px]">SYN, FIN, RST, ACK</span>
          </div>
          <div class="p-2 rounded-lg bg-surface-1 border border-line">
            <span class="text-dim block text-[10px]">Receive Window (rwnd)</span>
            <span class="text-purple-300 font-bold font-mono">65,535 Bytes</span>
            <span class="text-dim block text-[9px]">Control de flujo receptor</span>
          </div>
        </div>
      </div>

      <!-- Payload Detail (Default Hidden) -->
      <div id="detail-payload" class="layer-detail space-y-3 hidden">
        <div class="flex items-center justify-between border-b border-line/60 pb-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="font-bold text-sm text-emerald-300">Capa 5-7 (Aplicación): Payload de Usuario</span>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">PDU: Datos / Mensaje</span>
        </div>
        <p class="text-dim text-xs leading-relaxed font-sans">
          Son los datos reales que el software genera y consume. Para las capas inferiores es una caja negra opaca (secuencia de bytes indistinguible).
        </p>
        <div class="p-3 rounded-lg bg-surface-1 border border-emerald-500/30 font-mono text-[11px] text-ink overflow-x-auto">
          <div class="text-dim text-[10px] mb-1">// Petición HTTP/1.1 dentro del segmento TCP:</div>
          <div class="text-emerald-400">POST /api/v1/orders HTTP/1.1</div>
          <div class="text-dim">Host: api.tienda.com</div>
          <div class="text-dim">Content-Type: application/json</div>
          <div class="text-dim">Authorization: Bearer eyJhbGciOiJIUzI1...</div>
          <div class="text-ink mt-2">{`{ "item_id": 9942, "qty": 1, "currency": "EUR" }`}</div>
        </div>
      </div>

      <!-- FCS Detail (Default Hidden) -->
      <div id="detail-fcs" class="layer-detail space-y-3 hidden">
        <div class="flex items-center justify-between border-b border-line/60 pb-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <span class="font-bold text-sm text-amber-300">Frame Check Sequence (FCS) / Trailer (4 Bytes)</span>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">Detección de Errores</span>
        </div>
        <p class="text-dim text-xs leading-relaxed font-sans">
          Código de Redundancia Cíclica (CRC-32) calculado por el hardware de la tarjeta emisora sobre todos los bits de la trama. El receptor recalcula el CRC: si no coincide exactamente, la trama entera se <strong>descarta silenciosamente</strong> a nivel hardware sin notificar al software.
        </p>
      </div>
    </div>
  </div>

  <!-- VIEW 2: MAPEO VISUAL OSI (7) VS TCP/IP (4) EN SVG -->
  <div id="view-osi" class="space-y-4 hidden">
    <div class="p-4 rounded-xl border border-line bg-surface-1">
      <div class="text-xs text-dim mb-3 font-sans">
        El modelo <strong>OSI es el mapa conceptual académico</strong> de 7 niveles; <strong>TCP/IP es el estándar real de Internet</strong> de 4 capas. Observa cómo las tres capas superiores de OSI colapsan en la capa de Aplicación de TCP/IP:
      </div>

      <!-- SVG Mapping Diagram -->
      <div class="w-full overflow-x-auto py-2">
        <svg viewBox="0 0 850 320" class="w-full min-w-[650px] h-auto font-mono select-none">
          <!-- Column Titles -->
          <text x="180" y="25" fill="#94a3b8" font-size="13" font-weight="bold" text-anchor="middle">Modelo OSI (7 Capas Teóricas)</text>
          <text x="440" y="25" fill="#cbd5e1" font-size="13" font-weight="bold" text-anchor="middle">Unidad (PDU)</text>
          <text x="700" y="25" fill="#93c5fd" font-size="13" font-weight="bold" text-anchor="middle">Pila TCP/IP (4 Capas Prácticas)</text>

          <!-- OSI Layers -->
          <!-- 7. Aplicación -->
          <rect x="50" y="45" width="260" height="32" rx="5" fill="#1e1b4b" stroke="#6366f1" stroke-width="1.2" />
          <text x="65" y="66" fill="#c7d2fe" font-size="11">7. Aplicación (HTTP, DNS)</text>

          <!-- 6. Presentación -->
          <rect x="50" y="82" width="260" height="32" rx="5" fill="#1e1b4b" stroke="#6366f1" stroke-width="1.2" />
          <text x="65" y="103" fill="#c7d2fe" font-size="11">6. Presentación (TLS, JSON)</text>

          <!-- 5. Sesión -->
          <rect x="50" y="119" width="260" height="32" rx="5" fill="#1e1b4b" stroke="#6366f1" stroke-width="1.2" />
          <text x="65" y="140" fill="#c7d2fe" font-size="11">5. Sesión (Sockets, RPC)</text>

          <!-- 4. Transporte -->
          <rect x="50" y="160" width="260" height="40" rx="5" fill="#3b0764" stroke="#a855f7" stroke-width="1.2" />
          <text x="65" y="185" fill="#e9d5ff" font-size="11">4. Transporte (TCP, UDP)</text>

          <!-- 3. Red -->
          <rect x="50" y="205" width="260" height="40" rx="5" fill="#083344" stroke="#06b6d4" stroke-width="1.2" />
          <text x="65" y="230" fill="#cffafe" font-size="11">3. Red (IP, ICMP, ARP)</text>

          <!-- 2 & 1 Enlace y Física -->
          <rect x="50" y="250" width="260" height="30" rx="5" fill="#172554" stroke="#3b82f6" stroke-width="1.2" />
          <text x="65" y="270" fill="#dbeafe" font-size="10.5">2. Enlace de Datos (Ethernet, Wi-Fi)</text>

          <rect x="50" y="285" width="260" height="30" rx="5" fill="#0f172a" stroke="#475569" stroke-width="1.2" />
          <text x="65" y="305" fill="#cbd5e1" font-size="10.5">1. Física (Cables, Fibra, Ondas)</text>

          <!-- PDUs (Middle) -->
          <text x="440" y="105" fill="#10b981" font-size="11" font-weight="bold" text-anchor="middle">Datos / Mensaje</text>
          <text x="440" y="185" fill="#c084fc" font-size="11" font-weight="bold" text-anchor="middle">Segmento (TCP) / Datagrama</text>
          <text x="440" y="230" fill="#22d3ee" font-size="11" font-weight="bold" text-anchor="middle">Paquete (Packet)</text>
          <text x="440" y="270" fill="#60a5fa" font-size="11" font-weight="bold" text-anchor="middle">Trama (Frame)</text>
          <text x="440" y="305" fill="#94a3b8" font-size="11" font-weight="bold" text-anchor="middle">Bits</text>

          <!-- TCP/IP Layers (Right) -->
