---
const stages = ['IF', 'ID', 'EX', 'MEM', 'WB'];
const labels: Record<string, string> = {
  IF: 'Fetch',
  ID: 'Decode',
  EX: 'Execute',
  MEM: 'Memory',
  WB: 'Write-back',
};

const rows = [
  { name: 'add r1, r2, r3', offset: 0, stall: false },
  { name: 'lw  r4, 0(r1)', offset: 1, stall: false },
  { name: 'sub r5, r4, r6', offset: 2, stall: true },
  { name: 'add r7, r5, r8', offset: 3, stall: false },
];
---

<div class="overflow-x-auto">
  <div class="min-w-[540px]">
    <div class="mb-1.5 grid grid-cols-[9rem_repeat(9,minmax(0,1fr))] gap-1">
      <span></span>
      {
        Array.from({ length: 9 }).map((_, i) => (
          <span class="text-center font-mono text-[9px] text-dim">c{i + 1}</span>
        ))
      }
    </div>

    <div class="space-y-1">
      {
        rows.map((row) => (
          <div class="grid grid-cols-[9rem_repeat(9,minmax(0,1fr))] items-center gap-1">
            <span class="truncate font-mono text-[10px] text-muted">{row.name}</span>
            {Array.from({ length: 9 }).map((_, cycle) => {
              const stageIndex = cycle - row.offset;
              const stage = stageIndex >= 0 && stageIndex < stages.length ? stages[stageIndex] : null;
              const hazard = row.stall && stage === 'EX';
              return (
                <span
                  class:list={[
                    'flex h-6 items-center justify-center rounded-sm border font-mono text-[9px]',
                    !stage && 'border-transparent',
                    stage && !hazard && 'accent-border accent-softer accent',
                    hazard && 'border-rose-400/50 bg-rose-400/10 text-rose-300',
                  ]}
                  title={stage ? labels[stage] : undefined}
                >
                  {hazard ? 'stall' : (stage ?? '')}
                </span>
              );
            })}
          </div>
        ))
      }
    </div>

    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[10px] text-dim">
      {stages.map((stage) => <span><span class="font-mono accent">{stage}</span> · {labels[stage]}</span>)}
      <span class="text-rose-300/80">stall · RAW hazard sin forwarding</span>
    </div>
  </div>
</div>
