---
const zones = [
  {
    name: '1. Underfitting (Alto sesgo)',
    train: 'Error alto',
    val: 'Error alto',
    symptom: 'El modelo es demasiado simple para capturar la estructura real.',
    fix: 'Más capacidad, mejores features, menos regularización.',
    tone: 'border-amber-400/30 bg-amber-400/[0.04]',
  },
  {
    name: '2. Punto dulce (Equilibrio)',
    train: 'Error bajo',
    val: 'Error mínimo ★',
    symptom: 'Generaliza a datos no vistos sin memorizar el ruido de entrenamiento.',
    fix: 'Early stopping, validación cruzada y regularización calibrada.',
    tone: 'accent-border accent-softer',
  },
  {
    name: '3. Overfitting (Alta varianza)',
    train: 'Error ~0 %',
    val: 'Error se dispara ▲',
    symptom: 'Memoriza el conjunto de train; colapsa ante cualquier variación en producción.',
    fix: 'Más datos, regularización L1/L2, dropout, reducir parámetros.',
    tone: 'border-rose-400/30 bg-rose-400/[0.04]',
  },
];
---

<div class="space-y-3">
  <div class="rounded-lg border border-white/10 bg-black/25 p-3.5">
    <svg viewBox="0 0 520 145" class="w-full h-auto overflow-visible" role="img" aria-label="Curvas de error de entrenamiento y validación frente a la complejidad del modelo">
      <line x1="40" y1="120" x2="500" y2="120" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
      <line x1="40" y1="15" x2="40" y2="120" stroke="rgba(255,255,255,0.15)" stroke-width="1" />

      <line x1="265" y1="15" x2="265" y2="120" stroke="rgba(255,255,255,0.22)" stroke-dasharray="3 3" stroke-width="1" />

      <!-- Train error curve (monotonic down) -->
      <path
        d="M 55 30 Q 190 92, 485 112"
        fill="none"
        stroke="rgba(148,163,184,0.75)"
        stroke-width="2"
      />

      <!-- Validation error curve (U-shaped) -->
      <path
        d="M 55 24 Q 235 115, 265 82 T 485 22"
        fill="none"
        stroke="var(--layer)"
        stroke-width="2.4"
      />

      <circle cx="265" cy="83" r="4" fill="var(--layer)" />

      <text x="45" y="136" fill="#7e8ca2" font-size="9" font-family="monospace">← Menos complejidad</text>
      <text x="385" y="136" fill="#7e8ca2" font-size="9" font-family="monospace">Más capacidad →</text>
      <text x="230" y="13" fill="#f8fafc" font-size="9" font-family="monospace">óptimo de generalización</text>
      <text x="415" y="105" fill="#94a3b8" font-size="9" font-family="monospace">error train</text>
      <text x="405" y="38" fill="#f8fafc" font-size="9" font-family="monospace">error validación</text>
    </svg>
  </div>

  <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
    {
      zones.map((zone) => (
        <div class={`rounded-lg border p-3 ${zone.tone}`}>
          <p class="font-mono text-[11px] font-semibold text-ink">{zone.name}</p>
          <p class="mt-1 font-mono text-[10px] text-muted">
            Train: {zone.train} · Val: {zone.val}
          </p>
          <p class="mt-1.5 text-[10px] leading-relaxed text-dim">{zone.symptom}</p>
          <p class="mt-1.5 font-mono text-[9px] text-ink/80">→ {zone.fix}</p>
        </div>
      ))
    }
  </div>
</div>
