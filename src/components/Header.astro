---
import { site } from '../config';

interface Props {
  mode?: 'software' | 'ai' | 'bridges' | 'home';
}

const { mode } = Astro.props;

const modes = [
  { id: 'software', label: 'Software', href: '/software' },
  { id: 'ai', label: 'IA', href: '/ia' },
  { id: 'bridges', label: 'Conexiones', href: '/conexiones' },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-white/8 bg-void/85 backdrop-blur-md supports-[backdrop-filter]:bg-void/70"
>
  <div class="shell flex h-14 items-center justify-between gap-2 sm:h-16 sm:gap-3">
    <a
      href="/"
      class="group flex min-w-0 shrink items-center gap-2.5 sm:gap-3"
      aria-label={`${site.name}, inicio`}
    >
      <span
        class="grid size-8 shrink-0 place-items-center rounded-lg border border-white/10 bg-panel accent-glow sm:size-9"
        style="--layer: hsl(205 90% 62%)"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M3 5.5 9 2l6 3.5-6 3.5-6-3.5Z" stroke="currentColor" stroke-width="1.2" />
          <path d="M3 9 9 12.5 15 9" stroke="currentColor" stroke-width="1.2" opacity="0.65" />
          <path d="M3 12.5 9 16l6-3.5" stroke="currentColor" stroke-width="1.2" opacity="0.35" />
        </svg>
      </span>
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="max-[360px]:hidden truncate text-sm font-semibold tracking-tight">
          <span class="sm:hidden">Stack Atlas</span>
          <span class="hidden sm:inline">{site.name}</span>
        </span>
        <span class="hidden text-[11px] text-dim sm:block">Atlas de ingeniería y IA</span>
      </span>
    </a>

    <nav
      aria-label="Modo de visualización"
      class="flex shrink-0 items-center gap-0.5 rounded-xl border border-white/8 bg-panel/70 p-1"
    >
      {
        modes.map((item) => (
          <a
            href={item.href}
            class="mode-link rounded-lg px-2 py-1.5 text-[11px] font-medium text-muted transition-colors sm:px-3 sm:text-sm"
            aria-current={mode === item.id ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    {
      site.supportUrl && (
        <a
          href={site.supportUrl}
          class="hidden rounded-lg border border-white/10 px-3 py-1.5 text-xs text-muted transition-colors hover:text-ink sm:block"
          rel="noopener noreferrer"
          target="_blank"
        >
          Apoyar
        </a>
      )
    }
  </div>
</header>
