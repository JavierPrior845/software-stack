---
import { layerConceptCount } from '../data';
import type { Stack } from '../data/types';

interface Props {
  stack: Stack;
  activeLayer: string;
  activeSlug?: string;
  className?: string;
  compact?: boolean;
}

const { stack, activeLayer, activeSlug, className = '', compact = false } = Astro.props;
---

<nav
  aria-label={`Capas del stack de ${stack.short}`}
  class={`panel p-3 sm:p-4 ${className}`}
>
  {
    !compact && (
      <>
        <div class="mb-3 flex items-baseline justify-between gap-3 px-1">
          <h2 class="text-[11px] font-semibold tracking-widest text-dim uppercase">Mapa de capas</h2>
          <span class="font-mono text-[11px] text-dim">{stack.layers.length} capas</span>
        </div>

        <p class="mb-3 px-1 text-xs leading-relaxed text-dim">{stack.claim}</p>

        <div class="mb-3 px-0.5">
          <input
            type="search"
            placeholder="Filtrar concepto (ej. caché, LoRA, TCP)…"
            aria-label="Filtrar conceptos de la pila"
            data-nav-filter
            class="w-full rounded-lg border border-white/10 bg-black/25 px-2.5 py-1.5 font-mono text-[11px] text-ink placeholder:text-dim outline-none transition-colors focus:border-white/25"
          />
        </div>
      </>
    )
  }

  <ol class="flex flex-col-reverse gap-1" data-nav-list>
    {
      stack.layers.map((layer) => {
        const open = layer.slug === activeLayer;
        const count = layerConceptCount(layer);
        return (
          <li data-nav-layer>
            <details
              open={open}
              data-initial-open={open ? 'true' : undefined}
              class="layer-item group rounded-xl border border-transparent transition-colors"
              style={`--layer: hsl(${layer.hue} 85% 64%)`}
            >
              <summary class="flex items-start gap-3 rounded-xl px-2.5 py-2.5 hover:bg-white/[0.025]">
                <span
                  class="layer-num mt-0.5 grid size-7 shrink-0 place-items-center rounded-md border border-white/10 bg-black/20 font-mono text-[11px] text-muted"
                >
                  {layer.number}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="layer-title block text-sm font-medium leading-snug text-ink/90">
                    {layer.title}
                  </span>
                  <span class="mt-0.5 block font-mono text-[10px] text-dim">{count} conceptos</span>
                </span>
                <svg
                  class="mt-1 size-4 shrink-0 text-dim transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                </svg>
              </summary>

              <div class="px-2.5 pb-3">
                <p class="mb-2.5 border-l pl-2 text-[11px] leading-snug text-dim accent-border">
                  {layer.subtitle}
                </p>

                <div class="space-y-3">
                  {layer.blocks.map((block) => (
                    <div data-nav-block>
                      <p class="mb-1.5 text-[10px] font-semibold tracking-wider text-muted/80 uppercase">
                        {block.title}
                      </p>
                      <div class="flex flex-wrap gap-1.5">
                        {block.concepts.map((concept) => (
                          <a
                            href={`/concepto/${concept.slug}`}
                            class="chip"
                            data-nav-chip
                            data-search={`${concept.name} ${concept.tagline} ${(concept.tags ?? []).join(' ')}`.toLowerCase()}
                            aria-current={concept.slug === activeSlug ? 'page' : undefined}
                          >
                            {concept.name}
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </details>
          </li>
        );
      })
    }
  </ol>
</nav>

<script>
  for (const nav of Array.from(document.querySelectorAll<HTMLElement>('nav'))) {
    const input = nav.querySelector<HTMLInputElement>('[data-nav-filter]');
    if (!input) continue;

    const layers = Array.from(nav.querySelectorAll<HTMLElement>('[data-nav-layer]'));

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();

      for (const layerEl of layers) {
        const details = layerEl.querySelector<HTMLDetailsElement>('details');
        const blocks = Array.from(layerEl.querySelectorAll<HTMLElement>('[data-nav-block]'));
        let layerMatches = 0;

        for (const blockEl of blocks) {
          const chips = Array.from(blockEl.querySelectorAll<HTMLElement>('[data-nav-chip]'));
          let blockMatches = 0;

          for (const chip of chips) {
            const hay = chip.dataset.search ?? '';
            const match = !q || hay.includes(q);
            chip.style.display = match ? '' : 'none';
            if (match) blockMatches++;
          }

          blockEl.style.display = blockMatches > 0 ? '' : 'none';
          layerMatches += blockMatches;
        }

        layerEl.style.display = layerMatches > 0 ? '' : 'none';
        if (details) {
          if (q) details.open = layerMatches > 0;
          else details.open = details.dataset.initialOpen === 'true';
        }
      }
    });
  }
</script>

<style>
  .layer-item[open] {
    border-color: color-mix(in oklab, var(--layer) 38%, transparent);
    background-color: color-mix(in oklab, var(--layer) 6%, transparent);
  }

  .layer-item[open] .layer-title,
  .layer-item[open] .layer-num {
    color: var(--layer);
  }

  .layer-item[open] .layer-num {
    border-color: color-mix(in oklab, var(--layer) 38%, transparent);
  }
</style>
