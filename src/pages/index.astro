---
import Base from '../layouts/Base.astro';
import { bridges, getBridgePair, layerConceptCount, stacks, totalBridges, totalConcepts } from '../data';
import type { Stack } from '../data/types';

const stackCards = [stacks.software, stacks.ai];

const teaser = bridges
  .map((bridge) => ({ bridge, ...getBridgePair(bridge) }))
  .filter((row) => row.software && row.ai)
  .slice(0, 3);

const principles = [
  {
    title: 'Tres modos, un dominio',
    body: 'Software, IA y las conexiones entre ambos. Todo el conocimiento en el mismo sitio, sin repartir autoridad entre webs.',
  },
  {
    title: 'Trade-offs con números',
    body: 'Latencia, memoria y coste. Cuándo usarlo, cuándo evitarlo y qué pagas por ello, no solo la definición de manual.',
  },
  {
    title: 'Datos, no diapositivas',
    body: 'Cada capa, bloque y concepto vive en un archivo tipado. Añadir una ficha no requiere tocar el diseño.',
  },
];

function totalOf(stack: Stack) {
  return stack.layers.reduce((sum, layer) => sum + layerConceptCount(layer), 0);
}
---

<Base og="home">

<section class="relative overflow-hidden border-b border-white/5">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="shell relative pt-14 pb-12 sm:pt-20 sm:pb-16">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-dim">
      Atlas de ingeniería · 11 capas · {totalConcepts} conceptos
    </p>

    <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl">
      De la caché L1 al <span class="text-gradient">bucle ReAct</span>.
    </h1>

    <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
      Dos pilas de conocimiento, once capas y las conexiones que casi nadie explica. Del transistor
      a los agentes autónomos, con el mismo nivel de detalle en ambos extremos.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/software"
        class="rounded-lg border border-sky-300/25 bg-sky-400/10 px-4 py-2 text-sm font-medium text-sky-100 transition-colors hover:bg-sky-400/15"
      >
        Explorar software
      </a>
      <a
        href="/ia"
        class="rounded-lg border border-white/12 bg-white/[0.03] px-4 py-2 text-sm font-medium text-ink/90 transition-colors hover:bg-white/[0.06]"
      >
        Explorar IA
      </a>
      <a
        href="/conexiones"
        class="group px-1 py-2 text-sm text-muted transition-colors hover:text-ink"
      >
        Ver las {totalBridges} conexiones
        <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>

<section class="shell py-10 sm:py-14" aria-labelledby="stacks-heading">
  <div class="mb-5 flex items-baseline justify-between gap-3">
    <h2 id="stacks-heading" class="text-sm font-semibold tracking-tight text-ink/90">
      Las dos pilas
    </h2>
    <p class="font-mono text-[10px] text-dim">elígelas por separado o conéctalas</p>
  </div>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    {
      stackCards.map((stack) => (
        <a
          href={stack.id === 'ai' ? '/ia' : '/software'}
          class="group panel flex flex-col p-5 transition-colors hover:border-white/15 sm:p-6"
          style={`--layer: hsl(${stack.layers[stack.layers.length - 1].hue} 85% 64%)`}
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-wider text-dim">
                {stack.layers.length} capas · {totalOf(stack)} conceptos
              </p>
              <h3 class="mt-1.5 text-lg font-semibold tracking-tight text-ink">
                {stack.title}
              </h3>
            </div>
            <span
              class="mt-1 font-mono text-sm text-dim transition-all group-hover:translate-x-0.5 group-hover:text-ink"
              aria-hidden="true"
            >
              →
            </span>
          </div>

          <p class="mt-2.5 text-xs leading-5 text-muted">{stack.claim}</p>

          <ul class="mt-5 space-y-0.5">
            {[...stack.layers].reverse().map((layer) => (
              <li
                class="flex items-center gap-3 rounded-md px-2 py-1.5 transition-colors group-hover:bg-white/[0.02]"
                style={`--layer: hsl(${layer.hue} 85% 64%)`}
              >
                <span class="accent-dot size-1.5 shrink-0 rounded-full bg-[var(--layer)]" />
                <span class="w-4 shrink-0 font-mono text-[10px] text-dim">{layer.number}</span>
                <span class="min-w-0 flex-1 truncate text-[12.5px] text-muted">{layer.title}</span>
                <span class="shrink-0 font-mono text-[10px] text-dim">
                  {layerConceptCount(layer)}
                </span>
              </li>
            ))}
          </ul>
        </a>
      ))
    }
  </div>
</section>

<section class="shell pb-10 sm:pb-14" aria-labelledby="bridges-heading">
  <div class="mb-5 flex items-baseline justify-between gap-3">
    <h2 id="bridges-heading" class="text-sm font-semibold tracking-tight text-ink/90">
      El diferencial
    </h2>
    <a href="/conexiones" class="font-mono text-[10px] text-dim transition-colors hover:text-ink">
      ver todas →
    </a>
  </div>

  <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
    {
      teaser.map(({ bridge, software: sw, ai: aiConcept }) => (
        <article class="panel p-4">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-dim">{bridge.theme}</p>
          <div class="mt-3 space-y-1.5">
            <a
              href={`/concepto/${sw!.concept.slug}`}
              class="flex items-baseline justify-between gap-2 rounded-md border border-white/8 bg-white/[0.015] px-2.5 py-1.5 transition-colors hover:border-white/20"
              style={`--layer: hsl(${sw!.layer.hue} 85% 64%)`}
            >
              <span class="truncate text-xs text-muted hover:text-ink">{sw!.concept.name}</span>
              <span class="shrink-0 font-mono text-[9px] text-dim">SW</span>
            </a>
            <a
              href={`/concepto/${aiConcept!.concept.slug}`}
              class="flex items-baseline justify-between gap-2 rounded-md border border-white/8 bg-white/[0.015] px-2.5 py-1.5 transition-colors hover:border-white/20"
              style={`--layer: hsl(${aiConcept!.layer.hue} 85% 64%)`}
            >
              <span class="truncate text-xs text-muted hover:text-ink">
                {aiConcept!.concept.name}
              </span>
              <span class="shrink-0 font-mono text-[9px] text-dim">IA</span>
            </a>
          </div>
          <p class="mt-3 line-clamp-3 text-[11px] leading-5 text-dim">{bridge.note}</p>
        </article>
      ))
    }
  </div>
</section>

<section class="shell pb-16">
  <div class="grid grid-cols-1 gap-4 border-t border-white/5 pt-8 sm:grid-cols-3">
    {
      principles.map((item) => (
        <div>
          <h2 class="text-xs font-semibold text-ink/85">{item.title}</h2>
          <p class="mt-1.5 text-xs leading-5 text-dim">{item.body}</p>
        </div>
      ))
    }
  </div>
</section>
</Base>
