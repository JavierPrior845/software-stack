---
import Base from '../layouts/Base.astro';
import Explorer from '../components/Explorer.astro';
import { getConcept, getStack } from '../data';

const stack = getStack('software');
const firstConcept = stack.layers[0].blocks[0].concepts[0];
const location = getConcept(firstConcept.slug);

if (!location) {
  throw new Error(`Concepto inicial no encontrado: ${firstConcept.slug}`);
}
---

<Base
  title="Software & Systems Stack"
  description="Las cinco capas de la ingeniería de software y sistemas: silicio y SO, algoritmia, diseño, redes y factoría. Con trade-offs, diagramas y conexiones hacia la IA."
  mode="software"
  og="software"
>
  <Explorer stack={stack} location={location} intro />
</Base>
